+
+#include "xenia/kernel/title/title_hooks.h"
+
+#include "xenia/base/byte_order.h"
+#include "xenia/base/logging.h"
+#include "xenia/cpu/guest_hooks.h"
+#include "xenia/kernel/title/halo3/halo3.h"
+#include "xenia/kernel/user_module.h"
+#include "xenia/memory.h"
+
+namespace xe {
+namespace kernel {
+namespace title {
+
+void InstallTitleHooks(KernelState* kernel_state, UserModule* module) {
+  if (!module->is_executable() || module->is_dll_module()) {
+    return;
+  }
+  const uint64_t hash = module->hash().value_or(0);
+  switch (module->title_id()) {
+    case halo3::kTitleId:
+      if (hash == halo3::kModuleHash) {
+        halo3::Install(kernel_state, module);
+        cpu::GuestHooks::Get().SetActive(true);
+      } else {
+        XELOGW("Halo 3: unsupported default.xex (hash {:016X}); hooks disabled",
+               hash);
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+bool PatchGuestWord(Memory* memory, uint32_t address, uint32_t expected,
+                    uint32_t value) {
+  BaseHeap* heap = memory->LookupHeap(address);
+  if (!heap) {
+    XELOGE("PatchGuestWord: no heap for {:08X}", address);
+    return false;
+  }
+  auto ptr = memory->TranslateVirtual<xe::be<uint32_t>*>(address);
+  const uint32_t current = *ptr;
+  if (current != expected) {
+    XELOGE("PatchGuestWord: {:08X} holds {:08X}, expected {:08X}; skipped",
+           address, current, expected);
+    return false;
+  }
+  uint32_t old_protect = 0;
+  heap->QueryProtect(address, &old_protect);
+  heap->Protect(address, 4, kMemoryProtectRead | kMemoryProtectWrite);
+  *ptr = value;
+  heap->Protect(address, 4, old_protect);
+  XELOGI("PatchGuestWord: {:08X} {:08X} -> {:08X}", address, expected, value);
+  return true;
+}
+
+}  // namespace title
+}  // namespace kernel
+}  // namespace xe
diff --git a/src/xenia/kernel/title/title_hooks.h b/src/xenia/kernel/title/title_hooks.h
new file mode 100644
index 0000000..2ab5bf7
--- /dev/null
+++ b/src/xenia/kernel/title/title_hooks.h
@@ -0,0 +1,36 @@
+/**
