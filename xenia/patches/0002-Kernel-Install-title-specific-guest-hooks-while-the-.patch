+
+#ifndef XENIA_KERNEL_TITLE_TITLE_HOOKS_H_
+#define XENIA_KERNEL_TITLE_TITLE_HOOKS_H_
+
+#include <cstdint>
+
+namespace xe {
+class Memory;
+namespace kernel {
+class KernelState;
+class UserModule;
+namespace title {
+
+// Installs title-specific guest hooks and code patches for the title
+// executable. Called while the module is loading, after patch files are
+// applied and before any of its code is translated or run.
+void InstallTitleHooks(KernelState* kernel_state, UserModule* module);
+
+// Replaces the big-endian word at a guest code address if it still holds the
+// expected original value, so a patch can never land on a different build.
+bool PatchGuestWord(Memory* memory, uint32_t address, uint32_t expected,
+                    uint32_t value);
+
+}  // namespace title
+}  // namespace kernel
+}  // namespace xe
+
+#endif  // XENIA_KERNEL_TITLE_TITLE_HOOKS_H_
