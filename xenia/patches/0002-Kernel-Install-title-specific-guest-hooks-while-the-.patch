From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: damnbitimcrit <333091414+damnbitimcrit@users.noreply.github.com>
Date: Mon, 12 Oct 2026 00:00:00 +0000
Subject: [PATCH] [Kernel] Install title-specific guest hooks while the title
 loads

KernelState::FinishLoadingUserModule now lets per-title code register guest
hooks after patch files are applied and before any title code runs.
---
 src/xenia/kernel/kernel_state.cc      | 13 +++++
 src/xenia/kernel/title/title_hooks.cc | 68 +++++++++++++++++++++++++++
 src/xenia/kernel/title/title_hooks.h  | 36 ++++++++++++++
 3 files changed, 117 insertions(+)
 create mode 100644 src/xenia/kernel/title/title_hooks.cc
 create mode 100644 src/xenia/kernel/title/title_hooks.h

diff --git a/src/xenia/kernel/kernel_state.cc b/src/xenia/kernel/kernel_state.cc
index e502008..8d07df6 100644
--- a/src/xenia/kernel/kernel_state.cc
+++ b/src/xenia/kernel/kernel_state.cc
@@ -13,8 +13,10 @@
 
 #include "xenia/base/byte_stream.h"
 #include "xenia/base/logging.h"
+#include "xenia/cpu/guest_hooks.h"
 #include "xenia/emulator.h"
 #include "xenia/hid/input_system.h"
+#include "xenia/kernel/title/title_hooks.h"
 #include "xenia/kernel/user_module.h"
 #include "xenia/kernel/util/shim_utils.h"
 #include "xenia/kernel/xboxkrnl/xboxkrnl_memory.h"
@@ -658,6 +660,17 @@ X_RESULT KernelState::FinishLoadingUserModule(
   emulator_->patcher()->ApplyPatchesForTitle(memory_, module->title_id(),
                                              module->hash());
   emulator_->on_patch_apply();
+  // Only the title's executable, not the DLLs it loads later (those carry the
+  // title flag too and would replace the title's hooks).
+  if (module->is_executable() && !module->is_dll_module()) {
+    // Title-specific guest hooks must be registered before any of the title's
+    // code is translated.
+    auto& guest_hooks = cpu::GuestHooks::Get();
+    guest_hooks.Unfreeze();
+    guest_hooks.SetActive(false);
+    title::InstallTitleHooks(this, module.get());
+    guest_hooks.Freeze();
+  }
   if (module->xex_module()) {
     module->xex_module()->Precompile();
   }
diff --git a/src/xenia/kernel/title/title_hooks.cc b/src/xenia/kernel/title/title_hooks.cc
new file mode 100644
index 0000000..d091fb3
--- /dev/null
+++ b/src/xenia/kernel/title/title_hooks.cc
@@ -0,0 +1,68 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
