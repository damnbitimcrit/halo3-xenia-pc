+
+  if (memexport) {
+    stats_->memexport_ranges.fetch_add(1, std::memory_order_relaxed);
+    LogMemExportRange(start, length);
+    if (cvars::memexport_keep_gpu_data) {
+      // Only inside the registered windows: the CPU may write other export
+      // targets too (Halo 3's ripple buffers swap roles between the CPU and
+      // the GPU every frame), and some ranges are larger than their buffer.
+      const MemExportKeepWindows& windows = memexport_keep_windows();
+      const uint32_t window_count =
+          std::min(windows.count.load(std::memory_order_acquire),
+                   MemExportKeepWindows::kMaxWindows);
+      if (window_count) {
+        const uint32_t end = start + length;
+        auto global_lock = global_critical_region_.Acquire();
+        for (uint32_t i = 0; i < window_count; ++i) {
+          const uint32_t keep_start = std::max(
+              start, windows.start[i].load(std::memory_order_relaxed));
+          const uint32_t keep_end =
+              std::min(end, windows.end[i].load(std::memory_order_relaxed));
+          if (keep_start < keep_end) {
+            KeepMemExportRange(keep_start, keep_end);
+            memexport_ranges_kept_ = true;
+          }
+        }
+      }
+    } else if (memexport_ranges_kept_) {
+      auto global_lock = global_critical_region_.Acquire();
+      memexport_kept_ranges_.clear();
+      memexport_ranges_kept_ = false;
+    }
+  }
+}
+
+void SharedMemory::KeepMemExportRange(uint32_t start, uint32_t end) {
+  // The first range ending at or after start, which may overlap or touch it.
+  auto it = std::lower_bound(
+      memexport_kept_ranges_.begin(), memexport_kept_ranges_.end(), start,
+      [](const std::pair<uint32_t, uint32_t>& range, uint32_t value) {
+        return range.second < value;
+      });
+  // Usually the same storage exported to again.
+  if (it != memexport_kept_ranges_.end() && it->first <= start &&
+      it->second >= end) {
+    return;
+  }
+  uint32_t merged_start = start, merged_end = end;
+  auto merge_end = it;
+  while (merge_end != memexport_kept_ranges_.end() && merge_end->first <= end) {
+    merged_start = std::min(merged_start, merge_end->first);
+    merged_end = std::max(merged_end, merge_end->second);
+    ++merge_end;
+  }
+  it = memexport_kept_ranges_.erase(it, merge_end);
+  memexport_kept_ranges_.insert(it, std::make_pair(merged_start, merged_end));
+}
+
+void SharedMemory::DropMemExportKeptRanges(uint32_t start, uint32_t end) {
+  for (size_t i = 0; i < memexport_kept_ranges_.size();) {
+    std::pair<uint32_t, uint32_t>& range = memexport_kept_ranges_[i];
+    if (range.second <= start || range.first >= end) {
+      ++i;
+      continue;
+    }
+    if (range.first < start && range.second > end) {
+      // Split around the dropped bytes. The ranges are apart, so no other one
+      // overlaps them.
+      const std::pair<uint32_t, uint32_t> tail(end, range.second);
+      range.second = start;
+      memexport_kept_ranges_.insert(memexport_kept_ranges_.begin() + (i + 1),
+                                    tail);
+      return;
+    }
+    if (range.first < start) {
+      range.second = start;
+      ++i;
+    } else if (range.second > end) {
+      range.first = end;
+      ++i;
+    } else {
+      memexport_kept_ranges_.erase(memexport_kept_ranges_.begin() + i);
+    }
+  }
+}
+
+void SharedMemory::CountMemExportBytesKept(uint32_t bytes) const {
+  stats_->memexport_kept_bytes.fetch_add(bytes, std::memory_order_relaxed);
+}
+
+void SharedMemory::LogMemExportRange(uint32_t start, uint32_t length) {
+  if (memexport_ranges_logged_count_ >= kMemExportRangesLoggedMax) {
+    return;
+  }
+  for (uint32_t i = 0; i < memexport_ranges_logged_count_; ++i) {
+    if (memexport_ranges_logged_[i].first == start &&
+        memexport_ranges_logged_[i].second == length) {
+      return;
+    }
+  }
+  memexport_ranges_logged_[memexport_ranges_logged_count_++] =
+      std::make_pair(start, length);
+  XELOGI("SharedMemory: memory export to {:08X}-{:08X} ({} bytes){}", start,
+         start + length - 1, length,
+         memexport_ranges_logged_count_ == kMemExportRangesLoggedMax
+             ? "; new ranges after this one aren't logged"
+             : "");
 }
 
