+#ifndef XENIA_GPU_MEMEXPORT_KEEP_H_
+#define XENIA_GPU_MEMEXPORT_KEEP_H_
+
+#include <atomic>
+#include <cstdint>
+
+namespace xe {
+namespace gpu {
+
+// memexport_keep_gpu_data keeps memory export results only inside these
+// physical byte ranges [start, end): buffers that title code knows only the
+// GPU writes during play (Halo 3: its particle, contrail, light volume and
+// beam storages). Other export targets may be written by the CPU as well.
+// Header-only, so title code can register them without linking the GPU code.
+// The writer clears the count, stores the entries, then stores the count.
+struct MemExportKeepWindows {
+  static constexpr uint32_t kMaxWindows = 8;
+  std::atomic<uint32_t> start[kMaxWindows] = {};
+  std::atomic<uint32_t> end[kMaxWindows] = {};
+  std::atomic<uint32_t> count{0};
+};
+
+inline MemExportKeepWindows& memexport_keep_windows() {
+  static MemExportKeepWindows windows;
+  return windows;
+}
+
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_MEMEXPORT_KEEP_H_
