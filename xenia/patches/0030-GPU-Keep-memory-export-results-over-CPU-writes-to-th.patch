+// Registers the effect storages' physical ranges for memexport_keep_gpu_data
+// once they exist (main thread).
+void RegisterEffectStorage(cpu::ppc::PPCContext* ctx) {
+  static bool registered = false;
+  if (registered) {
+    return;
+  }
+  constexpr size_t kStorageCount = std::size(kEffectStorageHeaders);
+  uint32_t starts[kStorageCount], ends[kStorageCount];
+  for (size_t i = 0; i < kStorageCount; ++i) {
+    const uint32_t header = kEffectStorageHeaders[i];
+    const uint32_t address = xe::load_and_swap<uint32_t>(
+        ctx->TranslateVirtual(header + kEffectStorageAddress));
+    const uint32_t size =
+        uint32_t(*ctx->TranslateVirtual<uint8_t*>(header +
+                                                  kEffectStorageStride)) *
+        xe::load_and_swap<uint16_t>(
+            ctx->TranslateVirtual(header + kEffectStorageCount));
+    if (!address || !size) {
+      return;
+    }
+    const uint32_t physical =
+        ctx->kernel_state->memory()->GetPhysicalAddress(address);
+    if (physical == UINT32_MAX) {
+      return;
+    }
+    starts[i] = physical;
+    ends[i] = physical + size;
+  }
+  gpu::MemExportKeepWindows& windows = gpu::memexport_keep_windows();
+  windows.count.store(0, std::memory_order_release);
+  for (size_t i = 0; i < kStorageCount; ++i) {
+    windows.start[i].store(starts[i], std::memory_order_relaxed);
+    windows.end[i].store(ends[i], std::memory_order_relaxed);
+  }
+  windows.count.store(uint32_t(kStorageCount), std::memory_order_release);
+  registered = true;
+  XELOGI(
+      "Halo 3: GPU effect storage (kept with memexport_keep_gpu_data): "
+      "particles {:08X}-{:08X}, contrails {:08X}-{:08X}, light volumes "
+      "{:08X}-{:08X}, beams {:08X}-{:08X}",
+      starts[0], ends[0] - 1, starts[1], ends[1] - 1, starts[2], ends[2] - 1,
+      starts[3], ends[3] - 1);
+}
