+  // For UploadRanges, after MakeRangeValid: calls copy(start, length) for
+  // each part of the bytes [start, start + length) that isn't a memory export
+  // result kept with memexport_keep_gpu_data, so the upload doesn't put the
+  // guest memory's stale bytes over what the GPU wrote. Returns the bytes
+  // kept. In the global critical region, so a drop of kept bytes either comes
+  // before (and is seen here) or invalidates the page again.
+  template <typename CopyFunction>
+  uint32_t ForEachUploadedPart(uint32_t start, uint32_t length,
+                               CopyFunction&& copy) {
+    const uint32_t end = start + length;
+    uint32_t position = start;
+    uint32_t kept = 0;
+    auto global_lock = global_critical_region_.Acquire();
+    // The first kept range ending after start.
+    auto kept_it = std::upper_bound(
+        memexport_kept_ranges_.cbegin(), memexport_kept_ranges_.cend(), start,
+        [](uint32_t value, const std::pair<uint32_t, uint32_t>& range) {
+          return value < range.second;
+        });
+    for (; kept_it != memexport_kept_ranges_.cend(); ++kept_it) {
+      const std::pair<uint32_t, uint32_t>& kept_range = *kept_it;
+      if (kept_range.first >= end) {
+        break;
+      }
+      if (kept_range.first > position) {
+        copy(position, kept_range.first - position);
+        position = kept_range.first;
+      }
+      const uint32_t kept_end = std::min(kept_range.second, end);
+      kept += kept_end - position;
+      position = kept_end;
+    }
+    if (position < end) {
+      copy(position, end - position);
+    }
+    if (kept) {
+      CountMemExportBytesKept(kept);
+    }
+    return kept;
+  }
