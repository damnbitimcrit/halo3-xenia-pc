 #include <cstdint>
 
+#include "xenia/base/byte_order.h"
 #include "xenia/base/clock.h"
 #include "xenia/base/logging.h"
 #include "xenia/base/threading.h"
@@ -46,6 +55,14 @@ constexpr uint32_t kMainTimeWaitBranch = 0x8208870C;
 constexpr uint32_t kMainTimeDtComputed = 0x820887B0;
 // Present (821924C0): `beq cr6, present`, taken when throttling is disabled.
 constexpr uint32_t kPresentWaitBranch = 0x821924EC;
+// Main loop (sub_821A9790): `bne cr6, no_wait` after testing the never-set
+// debug byte 828A1EF3; taken skips the wait for the next vblank.
+constexpr uint32_t kOuterLoopWaitBranch = 0x821A9810;
+// sub_821A9558: `bne cr6` after `bl sub_82088800`; not taken sets render
+// reason 0x100 (as in menus), so the pass renders even without a new tick.
+constexpr uint32_t kRenderReasonBranch = 0x821A9524;
+// 1 while the render thread draws a loading screen, 0 in game and menus.
+constexpr uint32_t kRenderThreadModeAddress = 0x82948F68;
 
 // Only the game's main thread runs main_time_update.
 struct FramePacer {
@@ -81,12 +98,24 @@ void WaitForFrameDeadline(uint64_t frequency) {
   pacer.deadline += period;
 }
 
-// Runs right before a `beq cr6` that skips a vblank wait: force it taken.
-void SkipVblankWait(cpu::ppc::PPCContext* ctx, void*) {
-  if (cvars::halo3_unlock_framerate) {
+bool Unlocked(cpu::ppc::PPCContext* ctx) {
+  return cvars::halo3_unlock_framerate &&
+         !xe::load_and_swap<uint32_t>(
+             ctx->TranslateVirtual(kRenderThreadModeAddress));
+}
+
+// Run right before a conditional branch on CR6[EQ] to pick its direction:
+// ForceEqual takes a `beq` / falls through a `bne`, ForceNotEqual the reverse.
+void ForceEqual(cpu::ppc::PPCContext* ctx, void*) {
+  if (Unlocked(ctx)) {
     ctx->cr6.cr6_none_equal = 1;  // CR6[EQ]
   }
 }
+void ForceNotEqual(cpu::ppc::PPCContext* ctx, void*) {
+  if (Unlocked(ctx)) {
+    ctx->cr6.cr6_none_equal = 0;
+  }
+}
 
 void OnMainTimeDtComputed(cpu::ppc::PPCContext* ctx, void*) {
   if (!cvars::halo3_unlock_framerate) {
@@ -94,7 +123,6 @@ void OnMainTimeDtComputed(cpu::ppc::PPCContext* ctx, void*) {
     return;
   }
   const uint64_t frequency = Clock::guest_tick_frequency();
-  WaitForFrameDeadline(frequency);
   const uint64_t now = Clock::QueryGuestTickCount();
   double dt = 0.0;
   if (pacer.last_ticks) {
@@ -106,12 +134,22 @@ void OnMainTimeDtComputed(cpu::ppc::PPCContext* ctx, void*) {
 
 }  // namespace
 
+void OnPacingFrameStart(cpu::ppc::PPCContext* ctx) {
+  if (Unlocked(ctx)) {
+    WaitForFrameDeadline(Clock::guest_tick_frequency());
+  } else {
+    pacer.deadline = 0;
+  }
+}
+
 void InstallFramePacing(KernelState* kernel_state) {
   auto& hooks = cpu::GuestHooks::Get();
   auto processor = kernel_state->processor();
-  hooks.Add(processor, kMainTimeWaitBranch, SkipVblankWait);
+  hooks.Add(processor, kMainTimeWaitBranch, ForceEqual);
   hooks.Add(processor, kMainTimeDtComputed, OnMainTimeDtComputed);
-  hooks.Add(processor, kPresentWaitBranch, SkipVblankWait);
+  hooks.Add(processor, kPresentWaitBranch, ForceEqual);
+  hooks.Add(processor, kOuterLoopWaitBranch, ForceNotEqual);
+  hooks.Add(processor, kRenderReasonBranch, ForceEqual);
 }
 
 }  // namespace halo3
