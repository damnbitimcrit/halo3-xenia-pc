 src/xenia/kernel/title/halo3/halo3_interp.cc | 104 +++++++++++++------
 5 files changed, 161 insertions(+), 52 deletions(-)

diff --git a/src/xenia/kernel/title/halo3/halo3.cc b/src/xenia/kernel/title/halo3/halo3.cc
index 7e049ed..336a35d 100644
--- a/src/xenia/kernel/title/halo3/halo3.cc
+++ b/src/xenia/kernel/title/halo3/halo3.cc
@@ -10,6 +10,8 @@
 #include "xenia/kernel/title/halo3/halo3.h"
 
 #include "xenia/base/logging.h"
+#include "xenia/cpu/guest_hooks.h"
+#include "xenia/kernel/kernel_state.h"
 
 DEFINE_bool(halo3_unlock_framerate, false,
             "Halo 3: remove the 30 FPS cap. The simulation keeps running at "
@@ -25,12 +27,28 @@ namespace xe {
 namespace kernel {
 namespace title {
 namespace halo3 {
+namespace {
+
+// Main loop body (sub_821A8ED8) entry: once per frame, before input is read
+// and before the simulation runs.
+constexpr uint32_t kMainLoopBodyEntry = 0x821A8ED8;
+
+void OnMainLoopBodyEntry(cpu::ppc::PPCContext* ctx, void*) {
+  // Wait first so input is sampled as late as possible.
+  OnPacingFrameStart(ctx);
+  OnInterpolationFrameStart(ctx);
+  OnInputFrameStart(ctx);
+}
+
+}  // namespace
 
 void Install(KernelState* kernel_state, UserModule* module) {
   XELOGI("Halo 3 (TU0) detected; installing hooks");
   InstallFramePacing(kernel_state);
   InstallInterpolation(kernel_state);
   InstallInput(kernel_state);
+  cpu::GuestHooks::Get().Add(kernel_state->processor(), kMainLoopBodyEntry,
+                             OnMainLoopBodyEntry);
 }
 
 }  // namespace halo3
