+#ifndef XENIA_GPU_GPU_THREAD_STATS_H_
+#define XENIA_GPU_GPU_THREAD_STATS_H_
+
+#include <atomic>
+#include <cstdint>
+
+#include "xenia/base/clock.h"
+
+namespace xe {
+namespace gpu {
+
+// Counters for what the GPU command processor thread spends its time on, for
+// titles that log performance statistics. Written by the command processor
+// thread (and the presenter); readers exchange them with 0. Header-only, so
+// any library can read them without linking the GPU code.
+struct GpuThreadStats {
+  // Host ticks (Clock::QueryHostTickCount).
+  std::atomic<uint64_t> idle_ticks{0};          // waiting for new commands
+  std::atomic<uint64_t> execute_ticks{0};       // executing command buffers
+  std::atomic<uint64_t> swap_ticks{0};          // inside IssueSwap
+  std::atomic<uint64_t> present_ticks{0};       // the host Present call
+  std::atomic<uint64_t> gpu_wait_ticks{0};      // waiting for host GPU work
+  std::atomic<uint64_t> wait_reg_mem_ticks{0};  // guest WAIT_REG_MEM polls
+  std::atomic<uint32_t> swaps{0};
+  std::atomic<uint32_t> draws{0};
+  std::atomic<uint32_t> copies{0};  // resolves (Direct3D 12)
+  std::atomic<uint32_t> wait_reg_mem_waits{0};
+  // readback_resolve = "small".
+  std::atomic<uint32_t> small_readbacks_queued{0};
+  std::atomic<uint32_t> small_readbacks_delivered{0};
+  // The CPU wrote the range after the resolve, or there was no free slot.
+  std::atomic<uint32_t> small_readbacks_skipped{0};
+  std::atomic<uint32_t> small_readback_latency_frames{0};  // sum, delivered
+};
+
+inline GpuThreadStats& gpu_thread_stats() {
+  static GpuThreadStats stats;
+  return stats;
+}
+
+// Adds the host ticks of its lifetime to a counter.
+class ScopedGpuThreadTicks {
+ public:
+  explicit ScopedGpuThreadTicks(std::atomic<uint64_t>& ticks)
+      : ticks_(ticks), start_(Clock::QueryHostTickCount()) {}
+  ~ScopedGpuThreadTicks() {
+    ticks_.fetch_add(Clock::QueryHostTickCount() - start_,
+                     std::memory_order_relaxed);
+  }
+  ScopedGpuThreadTicks(const ScopedGpuThreadTicks&) = delete;
+  ScopedGpuThreadTicks& operator=(const ScopedGpuThreadTicks&) = delete;
+
+ private:
+  std::atomic<uint64_t>& ticks_;
+  uint64_t start_;
+};
+
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_GPU_THREAD_STATS_H_
