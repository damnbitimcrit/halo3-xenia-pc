+XE_NOINLINE
+bool D3D12CommandProcessor::IssueCopy_SmallReadbackPath() {
+  uint32_t written_address, written_length;
+  reg::RB_COPY_DEST_INFO copy_dest_info;
+  bool is_scaled;
+  if (!render_target_cache_->Resolve(*memory_, *shared_memory_, *texture_cache_,
+                                     written_address, written_length,
+                                     &copy_dest_info, &is_scaled)) {
+    return false;
+  }
+  const uint32_t max_length = std::min(
+      uint32_t(cvars::readback_resolve_small_bytes), kSmallReadbackSlotSize);
+  // Larger resolves behave like "none". Resolution-scaled resolves go to the
+  // scaled resolve buffer, not to shared memory, and are not read back.
+  if (!written_length || written_length > max_length || is_scaled) {
+    return true;
+  }
+  if (!small_readback_logged_) {
+    small_readback_logged_ = true;
+    XELOGI(
+        "GPU: readback_resolve = \"small\": reading back resolves of up to {} "
+        "bytes",
+        max_length);
+  }
+
+  // Skip if the destination memory isn't writable, as the readback path does.
+  VirtualHeap* physical_heap = memory_->GetPhysicalHeap();
+  if (!physical_heap) {
+    return true;
+  }
+  HeapAllocationInfo alloc_info;
+  if (!physical_heap->QueryRegionInfo(written_address, &alloc_info) ||
+      !(alloc_info.state & kMemoryAllocationCommit) ||
+      !(alloc_info.protect & kMemoryProtectWrite) ||
+      written_address + written_length >
+          alloc_info.base_address + alloc_info.region_size) {
+    return true;
+  }
+
+  // The same range resolved again in this submission: the copy at the end of
+  // the submission takes the newest data.
+  for (const SmallReadback& request : small_readback_requests_) {
+    if (request.address == written_address &&
+        request.length == written_length) {
+      return true;
+    }
+  }
+
+  GpuThreadStats& stats = gpu_thread_stats();
+  if (small_readback_slots_used_ >= kSmallReadbackSlots) {
+    completion_timeline_->AwaitSubmissionAndUpdateCompleted(0);
+    PumpSmallReadbacks();
+    if (small_readback_slots_used_ >= kSmallReadbackSlots) {
+      // Never wait for the GPU here.
+      stats.small_readbacks_skipped.fetch_add(1, std::memory_order_relaxed);
+      return true;
+    }
+  }
+  if (!small_readback_buffer_) {
+    const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+    D3D12_RESOURCE_DESC buffer_desc;
+    ui::d3d12::util::FillBufferResourceDesc(
+        buffer_desc, uint64_t(kSmallReadbackSlots) * kSmallReadbackSlotSize,
+        D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(provider.GetDevice()->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback,
+            provider.GetHeapFlagCreateNotZeroed(), &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&small_readback_buffer_)))) {
+      XELOGE("Failed to create the small resolve readback buffer");
+      small_readback_buffer_ = nullptr;
+      return true;
+    }
+  }
+
+  SmallReadback request;
+  request.address = written_address;
+  request.length = written_length;
+  request.slot = small_readback_next_slot_;
+  request.frame = frame_current_;
+  request.submission = 0;
+  small_readback_next_slot_ =
+      (small_readback_next_slot_ + 1) % kSmallReadbackSlots;
+  ++small_readback_slots_used_;
+  small_readback_requests_.push_back(request);
+  stats.small_readbacks_queued.fetch_add(1, std::memory_order_relaxed);
+  return true;
+}
+
+void D3D12CommandProcessor::FlushSmallReadbackCopies() {
+  if (small_readback_requests_.empty()) {
+    return;
+  }
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  ID3D12Resource* shared_memory_buffer = shared_memory_->GetBuffer();
+  const uint64_t submission = GetCurrentSubmission();
+  for (SmallReadback& request : small_readback_requests_) {
+    deferred_command_list_.D3DCopyBufferRegion(
+        small_readback_buffer_, uint64_t(request.slot) * kSmallReadbackSlotSize,
+        shared_memory_buffer, request.address, request.length);
+    request.submission = submission;
+    small_readbacks_pending_.push_back(request);
+  }
+  small_readback_requests_.clear();
+}
+
+void D3D12CommandProcessor::PumpSmallReadbacks() {
+  if (small_readbacks_pending_.empty() || !small_readback_buffer_) {
+    return;
+  }
+  const uint64_t completed_submission = GetCompletedSubmission();
+  if (small_readbacks_pending_.front().submission > completed_submission) {
+    return;
+  }
+  D3D12_RANGE read_range;
+  read_range.Begin = 0;
+  read_range.End = SIZE_T(kSmallReadbackSlots) * kSmallReadbackSlotSize;
+  void* mapping = nullptr;
+  const bool mapped =
+      SUCCEEDED(small_readback_buffer_->Map(0, &read_range, &mapping));
+  GpuThreadStats& stats = gpu_thread_stats();
+  {
+    // Ordered against CPU writes to watched pages, which clear the flags
+    // checked below under this lock.
+    auto global_lock = global_critical_region::Acquire();
+    while (!small_readbacks_pending_.empty() &&
+           small_readbacks_pending_.front().submission <=
+               completed_submission) {
+      const SmallReadback readback = small_readbacks_pending_.front();
+      small_readbacks_pending_.pop_front();
+      --small_readback_slots_used_;
+      if (!mapped || !shared_memory_->IsRangeValidAndGpuWritten(
+                         readback.address, readback.length)) {
+        // The CPU wrote the range since the resolve: its data is newer.
+        stats.small_readbacks_skipped.fetch_add(1, std::memory_order_relaxed);
+        continue;
+      }
+      // Not vastcpy: the length isn't a multiple of its block size.
+      std::memcpy(memory_->TranslatePhysical(readback.address),
+                  static_cast<const uint8_t*>(mapping) +
+                      uint64_t(readback.slot) * kSmallReadbackSlotSize,
+                  readback.length);
+      stats.small_readbacks_delivered.fetch_add(1, std::memory_order_relaxed);
+      stats.small_readback_latency_frames.fetch_add(
+          uint32_t(frame_current_ - readback.frame), std::memory_order_relaxed);
+    }
+  }
+  if (mapped) {
+    D3D12_RANGE written_range = {};
+    small_readback_buffer_->Unmap(0, &written_range);
+  }
+}
