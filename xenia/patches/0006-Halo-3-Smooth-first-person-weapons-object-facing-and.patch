+
+void OnAfterGameTick(cpu::ppc::PPCContext* ctx, void*) {
+  if (!Enabled()) {
+    return;
+  }
+  if (!state) {
+    state = new InterpolationState();
+  }
+  SnapshotObjects(ctx);
+  SnapshotFirstPerson(ctx);
+}
+
+void OnAfterGameUpdate(cpu::ppc::PPCContext* ctx, void*) {
+  if (!cvars::halo3_unlock_framerate) {
+    return;
+  }
+  // The simulation copies the exact facing back before its next tick
+  // (player_control_update), so this only affects what is drawn.
+  RestoreExactFacing(ctx);
+  if (!state || !Enabled()) {
+    return;
+  }
+  const float alpha = BlendFactor(ctx);
+  if (alpha <= 0.0f) {
+    return;
   }
+  BlendObjects(ctx, alpha);
+  BlendFirstPerson(ctx, alpha);
