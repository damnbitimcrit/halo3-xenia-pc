+// Blends two orientations given as forward and up vectors (an object's
+// facing, left = up x forward). The results are orthonormal.
+inline void InterpolateOrientation(const Vector3& forward_a,
+                                   const Vector3& up_a,
+                                   const Vector3& forward_b,
+                                   const Vector3& up_b, float t,
+                                   Vector3* forward, Vector3* up) {
+  const Quaternion q =
+      Nlerp(QuaternionFromBasis(forward_a, Cross(up_a, forward_a), up_a),
+            QuaternionFromBasis(forward_b, Cross(up_b, forward_b), up_b), t);
+  Vector3 left;
+  BasisFromQuaternion(q, forward, &left, up);
+}
