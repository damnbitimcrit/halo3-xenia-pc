+// Camera facing.
+
+void RestoreExactFacing(cpu::ppc::PPCContext* ctx) {
+  const uint32_t controls = TlsSlot(ctx, kTlsPlayerControl);
+  if (!controls) {
+    return;
+  }
+  for (uint32_t u = 0; u < kLocalPlayers; ++u) {
+    const uint32_t live =
+        controls + kPlayerControlLive + u * kPlayerControlLiveSize;
+    const uint32_t camera =
+        controls + kPlayerControlCamera + u * kPlayerControlCameraSize;
+    const uint32_t unit = LoadU32(ctx, live + kPlayerControlUnit);
+    // Same check as the game's own per-frame copy (sub_82216E40).
+    if (unit == kNoUnit || unit != LoadU32(ctx, camera + kPlayerControlUnit)) {
+      continue;
+    }
+    StoreU32(ctx, camera + kPlayerControlYaw,
+             LoadU32(ctx, live + kPlayerControlYaw));
+    StoreU32(ctx, camera + kPlayerControlPitch,
+             LoadU32(ctx, live + kPlayerControlPitch));
+  }
+}
