+// Snapshots compare bit for bit: what we stored reads back unchanged.
+template <typename T>
+bool SameBits(const T& a, const T& b) {
+  return std::memcmp(&a, &b, sizeof(T)) == 0;
+}
+bool SameBits(const std::vector<Matrix4x3>& a,
+              const std::vector<Matrix4x3>& b) {
+  return a.size() == b.size() &&
+         std::memcmp(a.data(), b.data(), a.size() * sizeof(Matrix4x3)) == 0;
+}
