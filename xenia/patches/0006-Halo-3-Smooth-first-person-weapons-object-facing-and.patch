+// Fraction of a tick elapsed since the last one, or 0 to draw the last tick.
+float BlendFactor(cpu::ppc::PPCContext* ctx) {
+  const uint32_t time_globals = TlsSlot(ctx, kTlsGameTimeGlobals);
+  if (!time_globals) {
+    return 0.0f;
+  }
+  const float alpha = LoadF32(ctx, time_globals + kGameTimeTicksLeftover);
+  if (!(alpha > 0.0f)) {
+    return 0.0f;  // also rejects NaN
+  }
+  return std::min(alpha, 1.0f);
+}
