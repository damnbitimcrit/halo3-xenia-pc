+// Stats: whether local player 0's vehicle (the top of its unit's parent
+// chain) was blended in this frame.
+void CountPlayerVehicle(cpu::ppc::PPCContext* ctx) {
+  const uint32_t controls = TlsSlot(ctx, kTlsPlayerControl);
+  if (!controls || !state->object_array ||
+      TlsSlot(ctx, kTlsObjectDataArray) != state->object_array) {
+    return;
+  }
+  const uint32_t data = LoadU32(ctx, state->object_array + kDataArrayData);
+  const uint32_t unit_handle =
+      LoadU32(ctx, controls + kPlayerControlLive + kPlayerControlUnit);
+  const uint32_t unit = ObjectFromHandle(ctx, data, unit_handle);
+  if (!unit || LoadU32(ctx, unit + kObjectParent) == kNoObject) {
+    return;
+  }
+  Stats& s = stats();
+  s.vehicle_frames++;
+  const int32_t root = RootObjectIndex(ctx, data, unit_handle);
+  if (root >= 0 && state->objects[root].applied) {
+    s.vehicle_blended_frames++;
+  }
+}
+
+// Cameras.
+
+// Moves a point the game computed from the last tick's state of the object at
+// the top of handle's parent chain into the frame being drawn.
+bool MovePointIntoBlendedFrame(cpu::ppc::PPCContext* ctx, uint32_t handle,
+                               uint32_t point) {
+  if (!OnMainThread(ctx) || !state || !Enabled() || !state->object_array ||
+      TlsSlot(ctx, kTlsObjectDataArray) != state->object_array) {
+    return false;
+  }
+  const uint32_t data = LoadU32(ctx, state->object_array + kDataArrayData);
+  Vector3 p = LoadVector3(ctx, point);
+  if (!MoveIntoBlendedFrame(RootObjectIndex(ctx, data, handle), &p)) {
+    return false;
+  }
+  StoreVector3(ctx, point, p);
+  return true;
+}
+
+void OnDriverCameraFocus(cpu::ppc::PPCContext* ctx, void*) {
+  const uint32_t info = static_cast<uint32_t>(ctx->r[31]);
+  if (MovePointIntoBlendedFrame(ctx, LoadU32(ctx, info + kCameraInfoObject),
+                                info + kCameraInfoFocus)) {
+    stats().driver_focus_moves++;
+  }
+}
+
+void OnFollowingCameraCenter(cpu::ppc::PPCContext* ctx, void*) {
+  MovePointIntoBlendedFrame(
+      ctx, static_cast<uint32_t>(ctx->r[29]),
+      static_cast<uint32_t>(ctx->r[31]) + kFollowingCameraCenterPoint);
+}
+
+CameraPose LoadCameraPose(cpu::ppc::PPCContext* ctx, uint32_t command) {
+  return {LoadVector3(ctx, command + kCameraCommandPosition),
+          LoadF32(ctx, command + kCameraCommandFov),
+          LoadVector3(ctx, command + kCameraCommandForward),
