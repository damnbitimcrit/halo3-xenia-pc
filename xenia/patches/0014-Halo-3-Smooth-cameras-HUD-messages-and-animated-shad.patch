+// The object a handle (salt << 16 | index) refers to, or 0.
+uint32_t ObjectFromHandle(cpu::ppc::PPCContext* ctx, uint32_t data,
+                          uint32_t handle) {
+  const uint32_t index = handle & 0xFFFF;
+  if (handle == kNoObject || index >= state->high_water_mark) {
+    return 0;
+  }
+  const uint32_t header = data + index * kObjectHeaderSize;
+  if (LoadU16(ctx, header + kObjectHeaderSalt) != handle >> 16) {
+    return 0;
+  }
+  return LoadU32(ctx, header + kObjectHeaderAddress);
+}
+
+// Index of the object at the top of handle's parent chain (the vehicle a
+// rider sits in), handle's own index if it has no parent, or -1.
+int32_t RootObjectIndex(cpu::ppc::PPCContext* ctx, uint32_t data,
+                        uint32_t handle) {
+  for (uint32_t depth = 0; depth < kMaxParentDepth; ++depth) {
+    const uint32_t object = ObjectFromHandle(ctx, data, handle);
+    if (!object) {
+      return -1;
+    }
+    const uint32_t parent = LoadU32(ctx, object + kObjectParent);
+    if (parent == kNoObject) {
+      return static_cast<int32_t>(handle & 0xFFFF);
+    }
+    handle = parent;
+  }
+  return -1;
+}
+
+// Moves a point computed from the last tick's state of object `index` (a
+// root object) into the frame being drawn, by the blend of its root node.
+// Returns false if the object isn't blended in this frame.
+bool MoveIntoBlendedFrame(int32_t index, Vector3* point) {
+  if (index < 0 || static_cast<uint32_t>(index) >= state->high_water_mark) {
+    return false;
+  }
+  const ObjectSnapshot& o = state->objects[index];
+  if (!o.applied) {
+    return false;
+  }
+  if (o.node_count) {
+    *point = TransformPoint(
+        Multiply(o.written_nodes[0], Inverse(o.current_nodes[0])), *point);
+  } else {
+    *point = {point->x + o.written.position.x - o.current.position.x,
+              point->y + o.written.position.y - o.current.position.y,
+              point->z + o.written.position.z - o.current.position.z};
+  }
+  return true;
+}
