From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: damnbitimcrit <333091414+damnbitimcrit@users.noreply.github.com>
Date: Mon, 12 Oct 2026 00:00:00 +0000
Subject: [PATCH] [GPU] Split the swap's present time; rate-limit invalid
 texture fetch warnings

- gpu_thread_stats: the "presents" time (presenter->RefreshGuestOutput on
  the GPU command thread) split into refreshing the guest output image,
  which includes the frame's last submission (EndSubmission in the
  refresher), and painting it to the host window on that thread, with the
  wait for a free paint command allocator and the host Present call.
  Paint-side times count only while the guest output thread paints
  (painting_guest_output), not UI thread paints. Logged in Halo 3's GPU
  thread line. Presents took 12-38% of that thread's time.
- The "Texture fetch constant ... is completely invalid!" warning, which
  Halo 3 triggers once per frame (up to about 100 lines a second, most
  of the log), is logged at most four times a second, with a count of
  the rest.
---
 src/xenia/gpu/gpu_thread_stats.h      | 14 ++++++++++-
 src/xenia/gpu/texture_cache.cc        | 36 ++++++++++++++++++++++-----
 src/xenia/kernel/title/halo3/halo3.cc | 16 ++++++++----
 src/xenia/ui/d3d12/d3d12_presenter.cc | 20 +++++++++++++--
 src/xenia/ui/presenter.cc             | 21 +++++++++++++---
 5 files changed, 89 insertions(+), 18 deletions(-)

diff --git a/src/xenia/gpu/gpu_thread_stats.h b/src/xenia/gpu/gpu_thread_stats.h
index 34961fc..5f6454b 100644
--- a/src/xenia/gpu/gpu_thread_stats.h
+++ b/src/xenia/gpu/gpu_thread_stats.h
@@ -27,9 +27,17 @@ struct GpuThreadStats {
   std::atomic<uint64_t> idle_ticks{0};          // waiting for new commands
   std::atomic<uint64_t> execute_ticks{0};       // executing command buffers
   std::atomic<uint64_t> swap_ticks{0};          // inside IssueSwap
-  std::atomic<uint64_t> present_ticks{0};       // the host Present call
+  std::atomic<uint64_t> present_ticks{0};       // presenter->RefreshGuestOutput
   std::atomic<uint64_t> gpu_wait_ticks{0};      // waiting for host GPU work
   std::atomic<uint64_t> wait_reg_mem_ticks{0};  // guest WAIT_REG_MEM polls
+  // Inside the presents: refreshing the guest output image (which also ends
+  // the frame's submission) and painting it to the host window on this
+  // thread, and of the painting, waiting for a free paint command allocator
+  // and the host Present call.
+  std::atomic<uint64_t> refresh_ticks{0};
+  std::atomic<uint64_t> paint_ticks{0};
+  std::atomic<uint64_t> paint_wait_ticks{0};
+  std::atomic<uint64_t> host_present_ticks{0};
   std::atomic<uint32_t> swaps{0};
   std::atomic<uint32_t> draws{0};
   std::atomic<uint32_t> copies{0};  // resolves (Direct3D 12)
@@ -42,6 +50,10 @@ struct GpuThreadStats {
   std::atomic<uint32_t> small_readback_latency_frames{0};  // sum, delivered
 };
 
+// Whether this thread is painting the guest output as part of a guest swap
+// (Presenter::RefreshGuestOutput) rather than for the UI.
+inline thread_local bool painting_guest_output = false;
+
 inline GpuThreadStats& gpu_thread_stats() {
   static GpuThreadStats stats;
   return stats;
diff --git a/src/xenia/gpu/texture_cache.cc b/src/xenia/gpu/texture_cache.cc
index a76be1e..e44f0f1 100644
--- a/src/xenia/gpu/texture_cache.cc
+++ b/src/xenia/gpu/texture_cache.cc
@@ -988,13 +988,37 @@ void TextureCache::BindingInfoFromFetchConstant(
           fetch.dword_0, fetch.dword_1, fetch.dword_2, fetch.dword_3,
           fetch.dword_4, fetch.dword_5);
       return;
-    default:
-      XELOGW(
-          "Texture fetch constant ({:08X} {:08X} {:08X} {:08X} {:08X} {:08X}) "
-          "is completely invalid!",
-          fetch.dword_0, fetch.dword_1, fetch.dword_2, fetch.dword_3,
-          fetch.dword_4, fetch.dword_5);
+    default: {
+      // Some games (Halo 3) bind such a constant on every frame, which filled
+      // the log with up to a hundred lines a second. Log a few per second.
+      // Only the GPU command thread gets here.
+      static uint64_t log_second = 0;
+      static uint32_t logged = 0;
+      static uint32_t suppressed = 0;
+      const uint64_t second = Clock::QueryHostUptimeMillis() / 1000;
+      if (second != log_second) {
+        if (suppressed) {
+          XELOGW(
+              "{} more completely invalid texture fetch constants weren't "
+              "logged (at most 4 a second)",
+              suppressed);
+        }
+        log_second = second;
+        logged = 0;
+        suppressed = 0;
+      }
+      if (logged < 4) {
+        ++logged;
+        XELOGW(
+            "Texture fetch constant ({:08X} {:08X} {:08X} {:08X} {:08X} "
+            "{:08X}) is completely invalid!",
+            fetch.dword_0, fetch.dword_1, fetch.dword_2, fetch.dword_3,
+            fetch.dword_4, fetch.dword_5);
+      } else {
+        ++suppressed;
+      }
       return;
+    }
   }
 
   uint32_t width_minus_1, height_minus_1, depth_or_array_size_minus_1;
diff --git a/src/xenia/kernel/title/halo3/halo3.cc b/src/xenia/kernel/title/halo3/halo3.cc
