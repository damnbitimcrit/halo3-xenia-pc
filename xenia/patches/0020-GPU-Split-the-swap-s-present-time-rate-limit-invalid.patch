     for (std::atomic<uint64_t>* ticks :
          {&g.idle_ticks, &g.execute_ticks, &g.swap_ticks, &g.present_ticks,
-          &g.gpu_wait_ticks, &g.wait_reg_mem_ticks}) {
+          &g.gpu_wait_ticks, &g.wait_reg_mem_ticks, &g.refresh_ticks,
+          &g.paint_ticks, &g.paint_wait_ticks, &g.host_present_ticks}) {
       ticks->store(0, std::memory_order_relaxed);
     }
     apu::audio_stats().min_queued_frames.store(UINT32_MAX,
@@ -191,16 +192,21 @@ void LogStats() {
   XELOGI(
       "Halo 3 GPU thread: idle {:.0f}%, executing {:.0f}% (swaps {:.0f}%, "
       "presents {:.0f}%, host GPU waits {:.0f}%, {} guest memory waits "
-      "{:.0f}%); {:.1f} swaps/s, {:.0f} draws and {:.0f} resolves per swap; "
-      "small readbacks: {} queued, {} delivered ({:.1f} frames late), {} "
-      "skipped",
+      "{:.0f}%); presents: refresh with the frame's submission {:.0f}%, "
+      "paint {:.0f}% (allocator waits {:.0f}%, host Present {:.0f}%); {:.1f} "
+      "swaps/s, {:.0f} draws and {:.0f} resolves per swap; small readbacks: "
+      "{} queued, {} delivered ({:.1f} frames late), {} skipped",
       double(g.idle_ticks.exchange(0)) * percent,
       double(g.execute_ticks.exchange(0)) * percent,
       double(g.swap_ticks.exchange(0)) * percent,
       double(g.present_ticks.exchange(0)) * percent,
       double(g.gpu_wait_ticks.exchange(0)) * percent,
       g.wait_reg_mem_waits.exchange(0),
-      double(g.wait_reg_mem_ticks.exchange(0)) * percent, swaps / seconds,
+      double(g.wait_reg_mem_ticks.exchange(0)) * percent,
+      double(g.refresh_ticks.exchange(0)) * percent,
+      double(g.paint_ticks.exchange(0)) * percent,
+      double(g.paint_wait_ticks.exchange(0)) * percent,
+      double(g.host_present_ticks.exchange(0)) * percent, swaps / seconds,
       swaps ? double(draws) / swaps : 0.0, swaps ? double(copies) / swaps : 0.0,
       g.small_readbacks_queued.exchange(0), delivered,
       delivered ? double(latency) / delivered : 0.0,
