diff --git a/src/xenia/kernel/title/halo3/halo3_timing.cc b/src/xenia/kernel/title/halo3/halo3_timing.cc
new file mode 100644
index 0000000..3abec6a
--- /dev/null
+++ b/src/xenia/kernel/title/halo3/halo3_timing.cc
@@ -0,0 +1,257 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 damnbitimcrit. All rights reserved.                         *
+ * Released under the BSD license - see LICENSE in the root for more details. *
