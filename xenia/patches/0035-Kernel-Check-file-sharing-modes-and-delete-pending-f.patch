+  }
+}
+
+namespace {
+
+// Kept by NtCreateFile for the guest's opens.
+std::unordered_map<std::string, std::shared_ptr<XFile::ShareState>>&
+share_states() {
+  static std::unordered_map<std::string, std::shared_ptr<XFile::ShareState>>
+      states;
+  return states;
+}
+
+std::string ShareKey(const vfs::Entry* entry) {
+  return xe::utf8::lower_ascii(entry->absolute_path());
+}
+
+}  // namespace
+
+XFile::ShareRequest XFile::MakeShareRequest(uint32_t desired_access,
+                                            uint32_t share_access) {
+  constexpr uint32_t kFileReadData = 0x00000001;
+  constexpr uint32_t kFileWriteData = 0x00000002;
+  constexpr uint32_t kFileAppendData = 0x00000004;
+  constexpr uint32_t kFileExecute = 0x00000020;
+  constexpr uint32_t kDelete = 0x00010000;
+  constexpr uint32_t kGenericAll = 0x10000000;
+  constexpr uint32_t kGenericExecute = 0x20000000;
+  constexpr uint32_t kGenericWrite = 0x40000000;
+  constexpr uint32_t kGenericRead = 0x80000000;
+  constexpr uint32_t kShareRead = 0x1;
+  constexpr uint32_t kShareWrite = 0x2;
+  constexpr uint32_t kShareDelete = 0x4;
+  uint32_t access = desired_access;
+  if (access & kGenericAll) {
+    access |= kFileReadData | kFileWriteData | kFileAppendData | kFileExecute |
+              kDelete;
+  }
+  if (access & kGenericRead) {
+    access |= kFileReadData;
+  }
+  if (access & kGenericWrite) {
+    access |= kFileWriteData | kFileAppendData;
+  }
+  if (access & kGenericExecute) {
+    access |= kFileExecute;
+  }
+  ShareRequest request;
+  request.read = (access & (kFileReadData | kFileExecute)) != 0;
+  request.write = (access & (kFileWriteData | kFileAppendData)) != 0;
+  request.del = (access & kDelete) != 0;
+  request.shared_read = (share_access & kShareRead) != 0;
+  request.shared_write = (share_access & kShareWrite) != 0;
+  request.shared_delete = (share_access & kShareDelete) != 0;
+  return request;
+}
+
+bool XFile::GrantsDelete(uint32_t desired_access) {
+  constexpr uint32_t kDelete = 0x00010000;
+  constexpr uint32_t kGenericAll = 0x10000000;
+  return (desired_access & (kDelete | kGenericAll)) != 0;
+}
+
+bool XFile::TracksShareAccess(const vfs::Entry* entry) {
+  return entry && entry->parent() && !entry->is_read_only() &&
+         entry->device()->is_file_system();
+}
+
+std::shared_ptr<XFile::ShareState> XFile::FindShareState(
+    const vfs::Entry* entry) {
+  auto it = share_states().find(ShareKey(entry));
+  return it != share_states().end() ? it->second : nullptr;
+}
+
+bool XFile::ShareAccessConflicts(const ShareState& state,
+                                 const ShareRequest& request) {
+  // IoCheckShareAccess: an open with no read, write or delete access is
+  // always allowed.
+  if (!request.counts()) {
+    return false;
+  }
+  return (request.read && state.shared_read < state.open_count) ||
+         (request.write && state.shared_write < state.open_count) ||
+         (request.del && state.shared_delete < state.open_count) ||
+         (state.readers && !request.shared_read) ||
+         (state.writers && !request.shared_write) ||
+         (state.deleters && !request.shared_delete);
+}
+
+std::shared_ptr<XFile::ShareState> XFile::AddShareAccess(
+    const vfs::Entry* entry, const ShareRequest& request) {
+  std::string key = ShareKey(entry);
+  std::shared_ptr<ShareState>& state = share_states()[key];
+  if (!state) {
+    state = std::make_shared<ShareState>();
+    state->key = std::move(key);
+  }
+  ++state->file_objects;
+  if (request.counts()) {
+    ++state->open_count;
+    state->readers += request.read;
+    state->writers += request.write;
+    state->deleters += request.del;
+    state->shared_read += request.shared_read;
+    state->shared_write += request.shared_write;
+    state->shared_delete += request.shared_delete;
+  }
+  return state;
+}
+
+void XFile::RemoveShareAccess(const std::shared_ptr<ShareState>& state,
+                              const ShareRequest& request) {
+  --state->file_objects;
+  if (request.counts()) {
+    --state->open_count;
+    state->readers -= request.read;
+    state->writers -= request.write;
+    state->deleters -= request.del;
+    state->shared_read -= request.shared_read;
+    state->shared_write -= request.shared_write;
+    state->shared_delete -= request.shared_delete;
+  }
+  if (!state->file_objects) {
+    auto it = share_states().find(state->key);
+    if (it != share_states().end() && it->second == state) {
+      share_states().erase(it);
+    }
+  }
+}
+
+void XFile::SetShareAccess(std::shared_ptr<ShareState> state,
+                           const ShareRequest& request) {
+  share_state_ = std::move(state);
+  share_request_ = request;
 }
 
