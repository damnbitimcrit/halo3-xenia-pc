+DEFINE_bool(file_share_access, true,
+            "Check the sharing modes of the guest's open files as the console "
+            "does: an open that conflicts with another open of the same file "
+            "fails (STATUS_SHARING_VIOLATION), a file pending deletion can't "
+            "be opened, and it's deleted when its last handle closes. Halo 3 "
+            "deletes leftover Theater recordings this way while the new one "
+            "is open, which deleted new recordings without it.",
+            "Kernel");
+
 namespace xe {
 namespace kernel {
 namespace xboxkrnl {
@@ -32,6 +45,7 @@ struct CreateOptions {
   static constexpr uint32_t FILE_SYNCHRONOUS_IO_ALERT = 0x00000010;
   static constexpr uint32_t FILE_SYNCHRONOUS_IO_NONALERT = 0x00000020;
   static constexpr uint32_t FILE_NON_DIRECTORY_FILE = 0x00000040;
+  static constexpr uint32_t FILE_DELETE_ON_CLOSE = 0x00001000;
   // Optimization - file access will be random, not sequential.
   static constexpr uint32_t FILE_RANDOM_ACCESS = 0x00000800;
 };
@@ -77,15 +91,119 @@ dword_result_t NtCreateFile_entry(lpdword_t handle_out, dword_t desired_access,
     root_entry = root_file->entry();
   }
 
+  // As the console's file systems (Halo 3 carries the one for cache0: and
+  // cache1: in its executable, create sub_82588848): an open of an existing
+  // file is checked, after what the open itself would fail for, against the
+  // file's other opens (IoCheckShareAccess), and counted before the host open
+  // so a concurrent open sees it. Read-only devices, device roots and raw
+  // partitions aren't tracked, and open as before.
+  const bool check_share = cvars::file_share_access;
+  const XFile::ShareRequest share_request =
+      XFile::MakeShareRequest(desired_access, share_access);
+  const auto disposition = vfs::FileDisposition(uint32_t(creation_disposition));
+  const bool directory_file =
+      (create_options & CreateOptions::FILE_DIRECTORY_FILE) != 0;
+  const bool non_directory_file =
+      (create_options & CreateOptions::FILE_NON_DIRECTORY_FILE) != 0;
+  const bool delete_on_close =
+      (create_options & CreateOptions::FILE_DELETE_ON_CLOSE) != 0;
+  const auto refuse = [&](X_STATUS status,
+                          vfs::FileAction action =
+                              vfs::FileAction::kExists) -> X_STATUS {
+    if (io_status_block) {
+      io_status_block->status = status;
+      io_status_block->information = uint32_t(action);
+    }
+    *handle_out = X_INVALID_HANDLE_VALUE;
+    return status;
+  };
+  // Deleting on close needs the right to delete.
+  if (check_share && delete_on_close && !XFile::GrantsDelete(desired_access)) {
+    return refuse(X_STATUS_INVALID_PARAMETER);
+  }
+  std::shared_ptr<XFile::ShareState> share_state;
+  if (check_share) {
+    auto global_lock = global_critical_region::AcquireDirect();
+    vfs::Entry* existing =
+        root_entry ? root_entry->ResolvePath(target_path)
+                   : kernel_state()->file_system()->ResolvePath(target_path);
+    if (!existing) {
+      // Nothing can be created in a directory pending deletion
+      // (82588B60-82588B70).
+      const std::string base_path = xe::utf8::find_base_guest_path(target_path);
+      vfs::Entry* parent =
+          base_path.empty()
+              ? root_entry
+              : (root_entry
+                     ? root_entry->ResolvePath(base_path)
+                     : kernel_state()->file_system()->ResolvePath(base_path));
+      if (XFile::TracksShareAccess(parent) && parent->delete_on_close()) {
+        return refuse(X_STATUS_DELETE_PENDING,
+                      vfs::FileAction::kDoesNotExist);
+      }
+    }
+    // Creating an existing file: the open reports the collision. A directory
+    // opened as a file: the open reports that too.
+    if (existing && disposition != vfs::FileDisposition::kCreate &&
+        XFile::TracksShareAccess(existing)) {
+      const bool is_directory =
+          (existing->attributes() & vfs::kFileAttributeDirectory) != 0;
+      if (is_directory && disposition != vfs::FileDisposition::kOpen &&
+          disposition != vfs::FileDisposition::kOpenIf) {
+        return refuse(X_STATUS_OBJECT_NAME_COLLISION);
+      }
+      if (!is_directory && directory_file) {
+        return refuse(X_STATUS_NOT_A_DIRECTORY);
+      }
+      if (!(is_directory && non_directory_file)) {
+        // Xenia replaces a file by deleting and recreating it, so it can't
+        // while anything has it open.
+        const bool replaces =
+            disposition == vfs::FileDisposition::kSuperscede ||
+            disposition == vfs::FileDisposition::kOverwrite ||
+            disposition == vfs::FileDisposition::kOverwriteIf;
+        std::shared_ptr<XFile::ShareState> existing_state =
+            XFile::FindShareState(existing);
+        X_STATUS refused = X_STATUS_SUCCESS;
+        if (existing->delete_on_close()) {
+          refused = X_STATUS_DELETE_PENDING;
+        } else if (existing_state &&
+                   ((replaces && existing_state->file_objects) ||
+                    XFile::ShareAccessConflicts(*existing_state,
+                                                share_request))) {
+          refused = X_STATUS_SHARING_VIOLATION;
+        }
+        if (refused != X_STATUS_SUCCESS) {
+          static uint32_t refusals_logged = 0;
+          if (refusals_logged < 64) {
+            ++refusals_logged;
+            XELOGI(
+                "NtCreateFile: {} refused: {} (access {:08X}, share {:X}; "
+                "{} open, {} reading, {} writing, {} deleting)",
+                existing->absolute_path(),
+                refused == X_STATUS_DELETE_PENDING ? "pending deletion"
+                                                   : "sharing violation",
+                uint32_t(desired_access), uint32_t(share_access),
+                existing_state ? existing_state->open_count : 0,
+                existing_state ? existing_state->readers : 0,
+                existing_state ? existing_state->writers : 0,
+                existing_state ? existing_state->deleters : 0);
+          }
+          return refuse(refused);
+        }
+        // Also while a replace deletes and recreates the file: the path (the
+        // key) stays the same.
+        share_state = XFile::AddShareAccess(existing, share_request);
+      }
+    }
+  }
+
   // Attempt open (or create).
   vfs::File* vfs_file;
   vfs::FileAction file_action;
   X_STATUS result = kernel_state()->file_system()->OpenFile(
-      root_entry, target_path,
-      vfs::FileDisposition((uint32_t)creation_disposition), desired_access,
-      (create_options & CreateOptions::FILE_DIRECTORY_FILE) != 0,
-      (create_options & CreateOptions::FILE_NON_DIRECTORY_FILE) != 0, &vfs_file,
-      &file_action);
+      root_entry, target_path, disposition, desired_access, directory_file,
+      non_directory_file, &vfs_file, &file_action);
   object_ref<XFile> file = nullptr;
 
   X_HANDLE handle = X_INVALID_HANDLE_VALUE;
@@ -95,11 +213,41 @@ dword_result_t NtCreateFile_entry(lpdword_t handle_out, dword_t desired_access,
         (create_options & CreateOptions::FILE_SYNCHRONOUS_IO_ALERT) ||
         (create_options & CreateOptions::FILE_SYNCHRONOUS_IO_NONALERT);
     file = object_ref<XFile>(new XFile(kernel_state(), vfs_file, synchronous));
+    file->set_desired_access(desired_access);
 
     // Handle ref is incremented, so return that.
     handle = file->handle();
   }
 
+  if (check_share) {
+    auto global_lock = global_critical_region::AcquireDirect();
+    if (XSUCCEEDED(result)) {
+      vfs::Entry* opened = vfs_file->entry();
+      // A new file: counted now (nothing else has it open).
+      std::shared_ptr<XFile::ShareState> opened_state =
+          XFile::FindShareState(opened);
+      if (!share_state || opened_state != share_state) {
+        if (share_state) {
+          XFile::RemoveShareAccess(share_state, share_request);
+          share_state.reset();
+        }
+        if (XFile::TracksShareAccess(opened)) {
+          share_state = XFile::AddShareAccess(opened, share_request);
+        }
+      }
+      if (share_state) {
+        file->SetShareAccess(std::move(share_state), share_request);
+      }
+      // As the console's file system, at create (sub_82588848, 82588DBC).
+      if (delete_on_close && XFile::TracksShareAccess(opened) &&
+          !(opened->attributes() & vfs::kFileAttributeDirectory)) {
+        opened->SetForDeletion(true);
+      }
+    } else if (share_state) {
+      XFile::RemoveShareAccess(share_state, share_request);
+    }
+  }
+
   if (io_status_block) {
     io_status_block->status = result;
     io_status_block->information = (uint32_t)file_action;
@@ -114,10 +262,13 @@ DECLARE_XBOXKRNL_EXPORT1(NtCreateFile, kFileSystem, kImplemented);
 dword_result_t NtOpenFile_entry(
     lpdword_t handle_out, dword_t desired_access,
     pointer_t<X_OBJECT_ATTRIBUTES> object_attributes,
-    pointer_t<X_IO_STATUS_BLOCK> io_status_block, dword_t open_options) {
+    pointer_t<X_IO_STATUS_BLOCK> io_status_block, dword_t share_access,
+    dword_t open_options) {
+  // NtOpenFile(handle, access, attributes, iosb, share access, options): the
+  // share access was read as the options.
   return NtCreateFile_entry(
       handle_out, desired_access, object_attributes, io_status_block, nullptr,
-      0, 0, static_cast<uint32_t>(xe::vfs::FileDisposition::kOpen),
+      0, share_access, static_cast<uint32_t>(xe::vfs::FileDisposition::kOpen),
       open_options);
 }
 DECLARE_XBOXKRNL_EXPORT1(NtOpenFile, kFileSystem, kImplemented);
