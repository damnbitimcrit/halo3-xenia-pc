@@ -238,15 +243,100 @@ dword_result_t NtSetInformationFile_entry(
         return X_STATUS_INVALID_PARAMETER;
       }
 
-      file->Rename(target_path);
       out_length = sizeof(*info);
+      if (!cvars::file_share_access) {
+        result = file->Rename(target_path);
+        break;
+      }
+      // As the console: renaming needs the right to delete and stays on the
+      // device, and the target may be replaced only if allowed, isn't a
+      // directory and isn't open (the cache file system's rename,
+      // sub_82589170). The host rename replaces the target in one step, and
+      // nothing can open or create it in between.
+      if (!file->entry()->parent()) {
+        // A device root (82589684-8258968C).
+        result = X_STATUS_INVALID_PARAMETER;
+        break;
+      }
+      if (!XFile::GrantsDelete(file->desired_access()) ||
+          file->entry()->is_read_only()) {
+        result = X_STATUS_ACCESS_DENIED;
+        break;
+      }
+      auto global_lock = global_critical_region::AcquireDirect();
+      auto file_system = kernel_state()->file_system();
+      const std::string target_guest_path = xe::path_to_utf8(target_path);
+      vfs::Entry* target = file_system->ResolvePath(target_guest_path);
+      vfs::Entry* target_parent = file_system->ResolvePath(
+          xe::utf8::find_base_guest_path(target_guest_path));
+      if (!target && target_parent && target_parent->delete_on_close()) {
+        result = X_STATUS_DELETE_PENDING;
+        break;
+      }
+      if (target_parent &&
+          target_parent->device() != file->entry()->device()) {
+        result = X_STATUS_NOT_SAME_DEVICE;
+        break;
+      }
+      if (target == file->entry()) {
+        // Its own name (in any case): the name exists, and it is open.
+        result = info->replace_existing ? X_STATUS_ACCESS_DENIED
+                                        : X_STATUS_OBJECT_NAME_COLLISION;
+        break;
+      }
+      const bool replaces = target != nullptr;
+      if (replaces) {
+        if (!info->replace_existing || !target->parent() ||
+            (target->attributes() & vfs::kFileAttributeDirectory)) {
+          result = X_STATUS_OBJECT_NAME_COLLISION;
+          break;
+        }
+        std::shared_ptr<XFile::ShareState> target_state =
+            XFile::FindShareState(target);
+        if (target_state && target_state->file_objects) {
+          result = X_STATUS_ACCESS_DENIED;
+          break;
+        }
+      }
+      vfs::Entry* const old_parent = file->entry()->parent();
+      result = file->Rename(target_path);
+      if (XSUCCEEDED(result)) {
+        if (replaces) {
+          target->parent()->ForgetChild(target);
+        }
+        if (target_parent && target_parent != old_parent) {
+          old_parent->MoveChildTo(file->entry(), target_parent);
+        }
+      }
       break;
     }
     case XFileDispositionInformation: {
       auto info = info_ptr.as<X_FILE_DISPOSITION_INFORMATION*>();
       bool delete_on_close = info->delete_file ? true : false;
-      file->entry()->SetForDeletion(static_cast<bool>(info->delete_file));
       out_length = 0;
+      // As the console: not on a device root, it needs the right to delete,
+      // and a directory must be empty (the cache file system's disposition,
+      // sub_82589400).
+      if (cvars::file_share_access && !file->entry()->parent()) {
+        result = X_STATUS_INVALID_PARAMETER;
+        break;
+      }
+      if (cvars::file_share_access &&
+          (!XFile::GrantsDelete(file->desired_access()) ||
+           file->entry()->is_read_only())) {
+        result = X_STATUS_ACCESS_DENIED;
+        break;
+      }
+      {
+        auto global_lock = global_critical_region::AcquireDirect();
+        if (cvars::file_share_access && delete_on_close &&
