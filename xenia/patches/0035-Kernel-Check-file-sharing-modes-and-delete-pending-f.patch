   // TODO(benvanik): signal that the file is closing?
   async_event_->Set();
-  file_->Destroy();
+  // Closing handles takes it too (the object table), and so does deleting.
+  auto global_lock = global_critical_region::AcquireDirect();
+  bool others_open = false;
+  if (share_state_) {
+    RemoveShareAccess(share_state_, share_request_);
