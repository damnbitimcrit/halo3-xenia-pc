@@ -0,0 +1,1351 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 damnbitimcrit. All rights reserved.                         *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "xenia/cpu/guest_profiler.h"
+
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include "third_party/fmt/include/fmt/format.h"
+#include "xenia/base/clock.h"
+#include "xenia/base/cvar.h"
+#include "xenia/base/filesystem.h"
+#include "xenia/base/logging.h"
+#include "xenia/base/mutex.h"
+#include "xenia/base/platform_win.h"
+#include "xenia/base/string.h"
+#include "xenia/base/threading.h"
+#include "xenia/cpu/backend/backend.h"
+#include "xenia/cpu/backend/code_cache.h"
+#include "xenia/cpu/function.h"
+#include "xenia/cpu/processor.h"
+#include "xenia/cpu/stack_walker.h"
+#include "xenia/cpu/thread.h"
+#include "xenia/cpu/thread_debug_info.h"
+
+DECLARE_bool(guest_profile);
+DECLARE_uint32(guest_profile_period_us);
+DECLARE_uint32(guest_profile_report_s);
+DECLARE_double(guest_profile_slow_frame_ms);
+
+namespace xe {
+namespace cpu {
+
+#if XE_ARCH_AMD64
+
+namespace {
+
+using namespace guest_profile;
+
+// The stack copied per sample, from the stack pointer up (plus 16 bytes so
+// the copy can keep the original's alignment).
+constexpr size_t kStackCopySize = 512 * 1024;
+// Frames kept per sample.
+constexpr size_t kMaxFrames = 160;
+// CPU cycles a capture may cost a waiting thread (it runs the suspend and
+// get-context APCs and waits again) for the thread to still count as not
+// having run since.
+constexpr uint64_t kCaptureCycleAllowance = 400000;
+
+// ---------------------------------------------------------------------------
+// The stopped window: nothing in these may allocate, take a lock or raise an
+// exception (exception dispatch takes loader and function table locks the
+// stopped thread may hold).
+
+// The part of [address, address + size) in address's committed region,
+// without guard pages.
+size_t ReadableSize(uint64_t address, size_t size) {
+  MEMORY_BASIC_INFORMATION info;
+  if (!VirtualQuery(reinterpret_cast<const void*>(address), &info,
+                    sizeof(info)) ||
+      info.State != MEM_COMMIT ||
+      (info.Protect & (PAGE_GUARD | PAGE_NOACCESS)) ||
+      !(info.Protect &
+        (PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READ |
+         PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY))) {
+    return 0;
+  }
+  const uint64_t region_end =
+      uint64_t(uintptr_t(info.BaseAddress)) + info.RegionSize;
+  return size_t(std::min<uint64_t>(size, region_end - address));
+}
+
+struct Capture {
+  // Bytes copied to buffer + offset (0 if the capture failed).
+  size_t size = 0;
+  size_t offset = 0;
+  bool resume_failed = false;
+};
+
+// Stops the thread, reads its registers, copies its stack from the stack
+// pointer up to the stack base, and lets it run again, without boosting its
+// priority. The copy starts at the same offset modulo 16 as the original.
+Capture CaptureStopped(HANDLE thread, CONTEXT* context, uint64_t stack_base,
+                       uint8_t* buffer) {
+  Capture capture;
+  // The get-context and resume wake-ups would otherwise boost the thread's
+  // priority.
+  BOOL boost_disabled = FALSE;
+  const bool boost_known =
+      GetThreadPriorityBoost(thread, &boost_disabled) != FALSE;
+  if (boost_known) {
+    SetThreadPriorityBoost(thread, TRUE);
+  }
+  if (SuspendThread(thread) == DWORD(-1)) {
+    if (boost_known) {
+      SetThreadPriorityBoost(thread, boost_disabled);
+    }
+    return capture;
+  }
+  context->ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+  // GetThreadContext returns once the thread is really stopped.
+  if (GetThreadContext(thread, context)) {
+    const uint64_t stack_pointer = context->Rsp;
+    if (stack_pointer < stack_base && !(stack_pointer & 7)) {
+      const size_t wanted = size_t(
+          std::min<uint64_t>(stack_base - stack_pointer, kStackCopySize));
+      const size_t readable = ReadableSize(stack_pointer, wanted);
+      capture.offset = size_t(stack_pointer & 15);
+      // The kernel copies, so memory that goes away meanwhile (the thread
+      // terminated by another) gives a short copy, not an exception.
+      SIZE_T read = 0;
+      ReadProcessMemory(GetCurrentProcess(),
+                        reinterpret_cast<LPCVOID>(stack_pointer),
+                        buffer + capture.offset, readable, &read);
+      capture.size = size_t(read) & ~size_t(7);
+    }
+  }
+  if (ResumeThread(thread) == DWORD(-1) && ResumeThread(thread) == DWORD(-1)) {
+    capture.resume_failed = true;
+  }
+  if (boost_known) {
+    SetThreadPriorityBoost(thread, boost_disabled);
+  }
+  return capture;
+}
+
+// ---------------------------------------------------------------------------
+// After the thread runs again: structured exception handling is fine here.
+
+bool CopyMemoryGuarded(void* destination, const void* source, size_t size) {
+  __try {
+    std::memcpy(destination, source, size);
+    return true;
+  } __except (GetExceptionCode() == EXCEPTION_ACCESS_VIOLATION
+                  ? EXCEPTION_EXECUTE_HANDLER
+                  : EXCEPTION_CONTINUE_SEARCH) {
+    return false;
+  }
+}
+
+bool UnwindStepGuarded(DWORD64 pc, CONTEXT* context, bool* found) {
+  __try {
+    DWORD64 image_base = 0;
+    PRUNTIME_FUNCTION function =
+        RtlLookupFunctionEntry(pc, &image_base, nullptr);
+    *found = function != nullptr;
+    if (function) {
+      PVOID handler_data = nullptr;
+      DWORD64 establisher_frame = 0;
+      RtlVirtualUnwind(UNW_FLAG_NHANDLER, image_base, pc, function, context,
+                       &handler_data, &establisher_frame, nullptr);
+    }
+    return true;
+  } __except (GetExceptionCode() == EXCEPTION_ACCESS_VIOLATION
+                  ? EXCEPTION_EXECUTE_HANDLER
+                  : EXCEPTION_CONTINUE_SEARCH) {
+    return false;
+  }
+}
+
+// Whether the bytes before address end with a call instruction, as before a
+// return address: E8 rel32, or FF /2 (with an optional REX prefix, any
+// addressing form).
+bool FollowsCall(uint64_t address) {
+  uint8_t b[8];
+  if (address < 8 ||
+      !CopyMemoryGuarded(b, reinterpret_cast<const void*>(address - 8), 8)) {
+    return false;
+  }
+  if (b[3] == 0xE8) {
+    return true;
+  }
+  for (size_t length = 2; length <= 8; ++length) {
+    size_t i = 8 - length;
+    if ((b[i] & 0xF0) == 0x40) {
+      ++i;
+    }
+    if (i + 1 >= 8 || b[i] != 0xFF || ((b[i + 1] >> 3) & 7) != 2) {
+      continue;
+    }
+    const uint8_t mod = b[i + 1] >> 6;
+    const uint8_t rm = b[i + 1] & 7;
+    size_t end = i + 2;
+    if (mod != 3 && rm == 4) {
+      if (end >= 8) {
+        continue;
+      }
+      if (mod == 0 && (b[end] & 7) == 5) {
+        end += 4;
+      }
+      ++end;
+    }
+    if (mod == 1) {
+      end += 1;
+    } else if (mod == 2 || (mod == 0 && rm == 5)) {
+      end += 4;
+    }
+    if (end == 8) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Whether the instruction before pc is a system call: `syscall` (0F 05) or
+// `int 2Eh` (CD 2E), which ntdll's stubs use instead on some systems.
+bool AfterSystemCall(uint64_t pc) {
+  if ((pc & 0xFFF) < 2) {
+    return false;
+  }
+  uint8_t bytes[2];
+  if (!CopyMemoryGuarded(bytes, reinterpret_cast<const void*>(pc - 2), 2)) {
+    return false;
+  }
+  return (bytes[0] == 0x0F && bytes[1] == 0x05) ||
+         (bytes[0] == 0xCD && bytes[1] == 0x2E);
+}
+
+// Whether pc (in the code cache) is past the 'add rsp' of an epilog the
+// system unwinder doesn't recognize, which would make it unwind the frame
+// twice; the return address is on top of the stack there:
+// - the stack point pop of translated functions
+//   (enable_host_guest_stack_synchronization), 'dec dword [rsi + disp]'
+//   before 'ret', 'jmp rel32' or 'jmp rax';
+// - 'jmp rax' (indirect tail calls, the function resolve thunk);
+// - the three home slot reloads of the host-to-guest thunk before 'ret'.
+bool PastEpilogStackRelease(uint64_t pc) {
+  uint8_t bytes[16];
+  if (!CopyMemoryGuarded(bytes, reinterpret_cast<const void*>(pc),
+                         sizeof(bytes))) {
+    return false;
+  }
+  if (bytes[0] == 0xFF && bytes[1] == 0xE0) {
+    return true;
+  }
+  static const uint8_t kHomeReloads[3][5] = {{0x48, 0x8B, 0x4C, 0x24, 0x08},
+                                             {0x48, 0x8B, 0x54, 0x24, 0x10},
+                                             {0x4C, 0x8B, 0x44, 0x24, 0x18}};
+  for (size_t first = 0; first < 3; ++first) {
+    if (!std::memcmp(bytes, kHomeReloads[first], 5)) {
+      size_t i = 5;
+      for (size_t next = first + 1; next < 3; ++next, i += 5) {
+        if (std::memcmp(bytes + i, kHomeReloads[next], 5)) {
+          return false;
+        }
+      }
+      return bytes[i] == 0xC3;
+    }
+  }
+  size_t i = 0;
+  if ((bytes[i] & 0xF0) == 0x40) {
+    ++i;
+  }
+  if (bytes[i++] != 0xFF) {
+    return false;
+  }
+  const uint8_t modrm = bytes[i++];
+  const uint8_t mod = modrm >> 6;
+  if (((modrm >> 3) & 7) != 1 || (mod != 1 && mod != 2)) {
+    return false;
+  }
+  if ((modrm & 7) == 4) {
+    ++i;  // SIB
+  }
+  i += mod == 1 ? 1 : 4;
+  return bytes[i] == 0xC3 || bytes[i] == 0xE9 ||
+         (bytes[i] == 0xFF && bytes[i + 1] == 0xE0);
+}
+
+using NtQueryInformationThreadFn = LONG(NTAPI*)(HANDLE, ULONG, PVOID, ULONG,
+                                                PULONG);
+
+NtQueryInformationThreadFn QueryInformationThread() {
+  static const auto query =
+      reinterpret_cast<NtQueryInformationThreadFn>(GetProcAddress(
+          GetModuleHandleW(L"ntdll.dll"), "NtQueryInformationThread"));
+  return query;
+}
