+struct WaitInfo {
+  uint64_t first_argument = 0;
+  uint16_t system_call = 0;
+  bool operator==(const WaitInfo& other) const {
+    return first_argument == other.first_argument &&
+           system_call == other.system_call;
+  }
+};
+
+// Whether the thread is in a kernel wait now, and in which system call
+// (ThreadLastSystemCall answers only for a waiting thread; undocumented, so
+// it's only used once it has answered at least once).
+bool QueryWaiting(HANDLE thread, WaitInfo* wait) {
+  struct LastSystemCall {
+    PVOID first_argument;
+    USHORT system_call;
+    USHORT reserved0;
+    ULONG reserved1;
+    ULONG64 wait_time;
+  };
+  const NtQueryInformationThreadFn query = QueryInformationThread();
+  LastSystemCall info = {};
+  // 21: ThreadLastSystemCall.
+  if (!query || query(thread, 21, &info, sizeof(info), nullptr) < 0) {
+    return false;
+  }
+  wait->first_argument = uint64_t(uintptr_t(info.first_argument));
+  wait->system_call = info.system_call;
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Unwinding a stack copy.
+
+// The code the unwinder may look up: the code cache and loaded modules. A
+// garbage pc from a wrong unwind could otherwise make the system call a
+// module's function table callback, which some don't survive.
+class KnownCode {
+ public:
+  KnownCode(uint64_t code_begin, uint64_t code_end)
+      : code_begin_(code_begin), code_end_(code_end) {
+    // The frames above these hold an interrupted context, not a return
+    // address: exceptions (Xenia's MMIO and memory watch faults run on the
+    // faulting thread) and APCs.
+    HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+    for (const char* name :
+         {"KiUserExceptionDispatcher", "KiUserApcDispatcher"}) {
+      const auto pc = uint64_t(uintptr_t(GetProcAddress(ntdll, name)));
+      DWORD64 image_base = 0;
+      PRUNTIME_FUNCTION function =
+          pc ? RtlLookupFunctionEntry(pc, &image_base, nullptr) : nullptr;
+      if (function) {
+        dispatchers_.emplace_back(image_base + function->BeginAddress,
+                                  image_base + function->EndAddress);
+      }
+    }
+  }
+
+  bool InDispatcher(uint64_t pc) const {
+    for (const auto& [begin, end] : dispatchers_) {
+      if (pc >= begin && pc < end) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  bool InCodeCache(uint64_t pc) const {
+    return pc >= code_begin_ && pc < code_end_;
+  }
+
+  bool Contains(uint64_t pc) {
+    if (InCodeCache(pc)) {
+      return true;
+    }
+    for (const auto& [begin, end] : modules_) {
+      if (pc >= begin && pc < end) {
+        return true;
+      }
+    }
+    HMODULE module = nullptr;
+    uint64_t size = 0;
+    if (modules_.size() >= 1024 ||
+        !GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            reinterpret_cast<LPCWSTR>(pc), &module) ||
+        !module || !ReadImageSize(module, &size)) {
+      return false;
+    }
+    const uint64_t begin = uint64_t(uintptr_t(module));
+    modules_.emplace_back(begin, begin + size);
+    return pc < begin + size;
+  }
+
+ private:
+  static bool ReadImageSize(HMODULE module, uint64_t* size) {
+    IMAGE_DOS_HEADER dos;
+    IMAGE_NT_HEADERS64 nt;
+    const auto* base = reinterpret_cast<const uint8_t*>(module);
+    if (!CopyMemoryGuarded(&dos, base, sizeof(dos)) ||
+        dos.e_magic != IMAGE_DOS_SIGNATURE ||
+        !CopyMemoryGuarded(&nt, base + dos.e_lfanew, sizeof(nt)) ||
+        nt.Signature != IMAGE_NT_SIGNATURE) {
+      return false;
+    }
+    *size = nt.OptionalHeader.SizeOfImage;
+    return true;
+  }
+
+  uint64_t code_begin_;
+  uint64_t code_end_;
+  std::vector<std::pair<uint64_t, uint64_t>> modules_;
+  std::vector<std::pair<uint64_t, uint64_t>> dispatchers_;
+};
+
+// Unwinds the copy of a stack taken at context, leaf first, into frames.
+// Every word of the copy and every register that pointed into the original
+// stack is moved to the copy first, so the system unwinder reads only the
+// copy. Returns whether it reached the thread's first frame.
+bool UnwindCopy(CONTEXT* context, uint8_t* copy, size_t size, KnownCode& known,
+                std::vector<uint64_t>* frames) {
+  frames->clear();
+  const uint64_t original_begin = context->Rsp;
+  const uint64_t original_end = original_begin + size;
+  const uint64_t copy_begin = uint64_t(uintptr_t(copy));
+  const uint64_t copy_end = copy_begin + size;
+  const uint64_t delta = copy_begin - original_begin;
+  const auto rewrite = [&](DWORD64& value) {
+    if (value >= original_begin && value < original_end) {
+      value += delta;
+    }
+  };
+  uint64_t* words = reinterpret_cast<uint64_t*>(copy);
+  for (size_t i = 0; i < size / sizeof(uint64_t); ++i) {
+    rewrite(words[i]);
+  }
+  for (DWORD64* reg = &context->Rax; reg <= &context->R15; ++reg) {
+    rewrite(*reg);
+  }
+  const auto in_code_cache = [&](uint64_t pc) { return known.InCodeCache(pc); };
+
+  while (frames->size() < kMaxFrames) {
+    const DWORD64 pc = context->Rip;
+    const DWORD64 previous_sp = context->Rsp;
+    frames->push_back(pc);
+    const bool top = frames->size() == 1;
+    bool found = false;
+    if (!known.Contains(pc)) {
+      return false;
+    }
+    if (top && in_code_cache(pc) && PastEpilogStackRelease(pc)) {
+      found = false;
+    } else if (!UnwindStepGuarded(pc, context, &found)) {
+      return false;
+    }
+    if (!found) {
+      if (!top) {
+        return false;
+      }
+      // A leaf function without unwind information, or past an epilog's
+      // stack release: the return address is on top of the stack.
+      if (context->Rsp < copy_begin || context->Rsp + 8 > copy_end) {
+        return false;
+      }
+      context->Rip = *reinterpret_cast<const DWORD64*>(context->Rsp);
+      context->Rsp += 8;
+    } else if (!top && in_code_cache(pc) && !in_code_cache(context->Rip) &&
+               previous_sp + 0x60 <= copy_end) {
+      // Left translated code into host code: the frame was the host-to-guest
+      // thunk, which saves its caller's nonvolatile registers in its body
+      // (StackLayout::Thunk::r at +0x18) where the unwind information
+      // doesn't describe them.
+      const DWORD64* saved = reinterpret_cast<const DWORD64*>(previous_sp);
+      context->Rbx = saved[3];
+      context->Rbp = saved[4];
+      context->Rsi = saved[6];
+      context->Rdi = saved[7];
+      context->R12 = saved[8];
+      context->R13 = saved[9];
+      context->R14 = saved[10];
+      context->R15 = saved[11];
+    }
+    if (!context->Rip) {
+      // Past the thread's start routine.
+      return true;
+    }
+    // A caller's frame returns to just after a call (except the context an
+    // exception or APC interrupted): anything else is a wrong unwind.
+    if (context->Rsp <= previous_sp || context->Rsp >= copy_end ||
+        (!known.InDispatcher(pc) && !FollowsCall(context->Rip))) {
+      return false;
+    }
+  }
+  return false;
+}
+
+// ---------------------------------------------------------------------------
+// Names.
+
+class Win32Symbolizer : public Symbolizer {
+ public:
+  explicit Win32Symbolizer(backend::CodeCache* code_cache)
+      : code_cache_(code_cache) {
+    if (code_cache_) {
+      code_begin_ = code_cache_->execute_base_address();
+      code_end_ = code_begin_ + code_cache_->total_size();
+    }
+    unknown_ = Intern("(unknown code)");
+    thunk_ = Intern("(JIT thunk)");
+    HMODULE dbghelp = LoadLibraryW(L"dbghelp.dll");
+    if (dbghelp) {
+      undecorate_ = reinterpret_cast<UndecorateFn>(
+          GetProcAddress(dbghelp, "UnDecorateSymbolName"));
+    }
+    LoadMap();
+  }
+
+  ResolvedFrame Resolve(uint64_t pc, bool leaf) override {
+    // A return address is looked up inside the call before it.
+    const uint64_t lookup = leaf ? pc : pc - 1;
+    auto it = cache_.find(lookup);
+    if (it != cache_.end()) {
+      return it->second;
+    }
+    if (cache_.size() > 4000000) {
+      cache_.clear();
+    }
+    ResolvedFrame frame;
+    if (lookup >= code_begin_ && lookup < code_end_) {
+      // The code cache's function list is reserved up front and only
+      // appended to, so it can be searched without the global lock.
+      GuestFunction* function = code_cache_->LookupFunction(lookup);
+      // A function's end is the next one's start, and the search takes it as
+      // inside: a pc on a function's first byte may find the previous one.
+      if (function && !Contains(function, lookup)) {
+        GuestFunction* next = code_cache_->LookupFunction(lookup + 1);
+        function = next && Contains(next, lookup) ? next : nullptr;
+      }
+      if (function) {
+        frame.kind = FrameKind::kGuest;
+        frame.guest_function = function->address();
+        frame.guest_pc = function->MapMachineCodeToGuestAddress(lookup);
+        frame.fold = function->IsSaverest();
+        if (!function->name().empty() &&
+            !guest_names_.count(function->address())) {
+          guest_names_.emplace(function->address(), function->name());
+        }
+      } else {
+        frame.kind = FrameKind::kThunk;
+        frame.symbol = thunk_;
+      }
+    } else {
+      frame.kind = FrameKind::kHost;
+      frame.symbol = HostSymbol(lookup);
+    }
+    cache_.emplace(lookup, frame);
+    return frame;
+  }
+
+  const std::string& SymbolName(uint32_t symbol) override {
+    return names_[symbol < names_.size() ? symbol : unknown_];
+  }
+
+  const std::string* GuestFunctionName(uint32_t function) override {
+    auto it = guest_names_.find(function);
+    return it != guest_names_.end() ? &it->second : nullptr;
+  }
+
+  size_t map_symbols() const { return map_symbols_.size(); }
+  const std::filesystem::path& map_path() const { return map_path_; }
+  // A map was found but isn't from this executable's link.
+  bool map_stale() const { return map_stale_; }
+
+ private:
+  using UndecorateFn = DWORD(WINAPI*)(PCSTR, PSTR, DWORD, DWORD);
+
+  struct NamedAddress {
+    uint32_t rva;
+    // Into map_names_ (the executable) or the module's export names.
+    uint32_t name;
+  };
+
+  struct Module {
+    uint64_t base = 0;
+    uint64_t end = 0;
+    std::string name;
+    bool executable = false;
+    std::vector<NamedAddress> exports;
+    std::vector<std::string> export_names;
+    // Symbols by name index, interned on first use.
+    std::unordered_map<uint32_t, uint32_t> symbols;
+  };
+
+  static bool Contains(GuestFunction* function, uint64_t pc) {
+    const uint64_t code = uint64_t(uintptr_t(function->machine_code()));
+    return code && pc >= code && pc < code + function->machine_code_length();
+  }
+
+  uint32_t Intern(const std::string& name) {
+    auto it = name_ids_.find(name);
+    if (it != name_ids_.end()) {
+      return it->second;
+    }
+    const uint32_t id = uint32_t(names_.size());
+    names_.push_back(name);
+    name_ids_.emplace(name, id);
+    return id;
+  }
+
+  // The executable's functions from its linker map (link.exe /MAP).
+  void LoadMap() {
+    std::filesystem::path path = filesystem::GetExecutablePath();
+    path.replace_extension(".map");
+    std::ifstream file(path);
+    if (!file) {
+      // A renamed executable: the map keeps the link's name.
+      path = filesystem::GetExecutableFolder() / "xenia_canary.map";
+      file.open(path);
+      if (!file) {
+        return;
+      }
+    }
+    map_path_ = path;
+    // The map must come from the same link as the executable.
+    const auto* image =
+        reinterpret_cast<const uint8_t*>(GetModuleHandleW(nullptr));
+    const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(
+        image + reinterpret_cast<const IMAGE_DOS_HEADER*>(image)->e_lfanew);
+    const uint32_t timestamp = nt->FileHeader.TimeDateStamp;
+    uint64_t preferred_base = 0;
+    bool timestamp_seen = false;
+    std::string line;
+    std::vector<std::string_view> tokens;
+    while (std::getline(file, line)) {
+      if (!preferred_base) {
+        size_t at = line.find("Timestamp is ");
+        if (at != std::string::npos) {
+          timestamp_seen = true;
+          const auto map_timestamp =
+              uint32_t(std::strtoul(line.c_str() + at + 13, nullptr, 16));
+          // 0: a reproducible link, which records no time.
+          if (map_timestamp && map_timestamp != timestamp) {
+            map_stale_ = true;
+            return;
+          }
+        }
+        at = line.find("Preferred load address is ");
+        if (at != std::string::npos) {
+          preferred_base = std::strtoull(line.c_str() + at + 26, nullptr, 16);
+        }
+        continue;
+      }
+      // " 0001:00000000       ?name@@...       0000000140001000 f   lib:obj"
+      tokens.clear();
+      size_t i = 0;
+      while (i < line.size() && tokens.size() < 4) {
+        while (i < line.size() && line[i] == ' ') {
+          ++i;
+        }
+        const size_t begin = i;
+        while (i < line.size() && line[i] != ' ') {
+          ++i;
+        }
+        if (i > begin) {
+          tokens.emplace_back(line.data() + begin, i - begin);
+        }
+      }
+      if (tokens.size() < 4 || tokens[0].size() != 13 || tokens[0][4] != ':' ||
+          tokens[0].substr(0, 4) == "0000" || tokens[2].size() != 16 ||
+          tokens[3] != "f") {
+        continue;
+      }
+      const uint64_t address =
+          std::strtoull(std::string(tokens[2]).c_str(), nullptr, 16);
+      if (address <= preferred_base || address - preferred_base > UINT32_MAX) {
+        continue;
+      }
+      map_symbols_.push_back(
+          {uint32_t(address - preferred_base), uint32_t(map_names_.size())});
+      map_names_.emplace_back(tokens[1]);
+    }
+    if (!timestamp_seen) {
+      map_symbols_.clear();
+      map_names_.clear();
+      map_stale_ = true;
+      return;
+    }
+    // Identical functions folded into one (/OPT:ICF) share an address: keep
+    // the first name listed.
+    std::stable_sort(map_symbols_.begin(), map_symbols_.end(),
+                     [](const NamedAddress& a, const NamedAddress& b) {
+                       return a.rva < b.rva;
+                     });
+    map_symbols_.erase(
+        std::unique(map_symbols_.begin(), map_symbols_.end(),
+                    [](const NamedAddress& a, const NamedAddress& b) {
+                      return a.rva == b.rva;
+                    }),
+        map_symbols_.end());
+  }
+
+  std::string Undecorate(const std::string& name) {
+    std::string result = name;
+    if (undecorate_ && !name.empty() && name[0] == '?') {
+      char buffer[1024];
+      std::lock_guard<std::mutex> lock(DbgHelpMutex());
+      // UNDNAME_NAME_ONLY
+      if (undecorate_(name.c_str(), buffer, DWORD(sizeof(buffer)), 0x1000)) {
+        result = buffer;
+      }
+    }
+    if (result.size() > 160) {
+      result.resize(157);
+      result += "...";
+    }
+    return result;
+  }
+
+  Module* FindModule(uint64_t pc) {
+    for (auto& module : modules_) {
+      if (pc >= module->base && pc < module->end) {
+        return module.get();
+      }
+    }
+    // A reference keeps the module loaded while its headers are read.
+    HMODULE handle = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                            reinterpret_cast<LPCWSTR>(pc), &handle) ||
+        !handle) {
+      return nullptr;
+    }
+    auto module = std::make_unique<Module>();
+    module->base = uint64_t(uintptr_t(handle));
+    const auto* base = reinterpret_cast<const uint8_t*>(handle);
+    const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
+    const auto* nt =
+        reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + dos->e_lfanew);
+    module->end = module->base + nt->OptionalHeader.SizeOfImage;
+    std::vector<wchar_t> file_name(32768);
+    const DWORD length =
+        GetModuleFileNameW(handle, file_name.data(), DWORD(file_name.size()));
+    module->name = xe::path_to_utf8(
+        std::filesystem::path(std::wstring(file_name.data(), length))
+            .filename());
+    module->executable = handle == GetModuleHandleW(nullptr);
+    if (!module->executable) {
+      ReadExports(base, nt, module.get());
+    }
+    FreeLibrary(handle);
+    modules_.push_back(std::move(module));
+    return modules_.back().get();
+  }
+
+  static void ReadExports(const uint8_t* base, const IMAGE_NT_HEADERS64* nt,
+                          Module* module) {
+    const IMAGE_DATA_DIRECTORY& directory =
+        nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT];
+    if (!directory.VirtualAddress || !directory.Size) {
+      return;
+    }
+    const auto* exports = reinterpret_cast<const IMAGE_EXPORT_DIRECTORY*>(
+        base + directory.VirtualAddress);
+    const auto* functions =
+        reinterpret_cast<const DWORD*>(base + exports->AddressOfFunctions);
+    const auto* names =
+        reinterpret_cast<const DWORD*>(base + exports->AddressOfNames);
+    const auto* ordinals =
+        reinterpret_cast<const WORD*>(base + exports->AddressOfNameOrdinals);
+    for (DWORD i = 0; i < exports->NumberOfNames; ++i) {
+      if (ordinals[i] >= exports->NumberOfFunctions) {
+        continue;
+      }
+      const DWORD rva = functions[ordinals[i]];
+      // Forwarders point into the export directory.
+      if (rva >= directory.VirtualAddress &&
+          rva < directory.VirtualAddress + directory.Size) {
+        continue;
+      }
+      module->exports.push_back({rva, uint32_t(module->export_names.size())});
+      module->export_names.emplace_back(
+          reinterpret_cast<const char*>(base + names[i]));
+    }
+    std::sort(module->exports.begin(), module->exports.end(),
+              [](const NamedAddress& a, const NamedAddress& b) {
+                return a.rva < b.rva;
+              });
+  }
+
+  uint32_t HostSymbol(uint64_t pc) {
+    Module* module = FindModule(pc);
+    if (!module) {
+      // Executable memory outside any module (overlay and hook trampolines,
+      // other JITs): name it by its allocation.
+      MEMORY_BASIC_INFORMATION info;
+      if (VirtualQuery(reinterpret_cast<const void*>(pc), &info,
+                       sizeof(info)) &&
+          info.State == MEM_COMMIT &&
+          (info.Protect & (PAGE_EXECUTE | PAGE_EXECUTE_READ |
+                           PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY))) {
+        return Intern(fmt::format("(code at {:X})",
+                                  uint64_t(uintptr_t(info.AllocationBase))));
+      }
+      return unknown_;
+    }
+    const uint32_t rva = uint32_t(pc - module->base);
+    const std::vector<NamedAddress>& table =
+        module->executable ? map_symbols_ : module->exports;
+    auto it = std::upper_bound(table.begin(), table.end(), rva,
+                               [](uint32_t value, const NamedAddress& entry) {
+                                 return value < entry.rva;
+                               });
+    if (it == table.begin()) {
+      // Before every name: group by 4 KB.
+      return Intern(fmt::format("{}+{:X}", module->name, rva & ~0xFFFu));
+    }
+    --it;
+    const uint32_t offset = rva - it->rva;
+    auto symbol = module->symbols.find(it->name);
+    if (symbol == module->symbols.end() || offset >= 0x10000) {
+      std::string name;
+      if (module->executable) {
+        name = Undecorate(map_names_[it->name]);
+      } else {
+        name = module->name + "!" + module->export_names[it->name];
+      }
+      if (offset >= 0x10000) {
+        // Far past the nearest name (an unnamed function): group by 4 KB.
+        return Intern(fmt::format("{}+{:X}", name, offset & ~0xFFFu));
+      }
+      symbol = module->symbols.emplace(it->name, Intern(name)).first;
+    }
+    return symbol->second;
+  }
+
+  backend::CodeCache* code_cache_ = nullptr;
+  uint64_t code_begin_ = 0;
+  uint64_t code_end_ = 0;
+  UndecorateFn undecorate_ = nullptr;
+  uint32_t unknown_ = 0;
+  uint32_t thunk_ = 0;
+  std::vector<std::string> names_;
+  std::unordered_map<std::string, uint32_t> name_ids_;
+  std::unordered_map<uint64_t, ResolvedFrame> cache_;
+  std::unordered_map<uint32_t, std::string> guest_names_;
+  std::vector<std::unique_ptr<Module>> modules_;
+  std::filesystem::path map_path_;
+  bool map_stale_ = false;
+  std::vector<NamedAddress> map_symbols_;
+  std::vector<std::string> map_names_;
+};
+
+// ---------------------------------------------------------------------------
+// The sampler, and a thread that turns windows of samples into reports.
+
+class Win32GuestProfiler : public GuestProfiler {
+ public:
+  explicit Win32GuestProfiler(Processor* processor)
+      : processor_(processor),
+        code_cache_(processor->backend() ? processor->backend()->code_cache()
+                                         : nullptr),
+        known_code_(code_cache_ ? code_cache_->execute_base_address() : 0,
+                    code_cache_ ? code_cache_->execute_base_address() +
+                                      code_cache_->total_size()
+                                : 0) {}
+  ~Win32GuestProfiler() override { Stop(); }
+
+  bool Start() {
+    stop_event_ = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+    // 2: CREATE_WAITABLE_TIMER_HIGH_RESOLUTION (Windows 10 1803).
+    timer_ = CreateWaitableTimerExW(nullptr, nullptr, 2, TIMER_ALL_ACCESS);
+    if (!timer_) {
+      timer_ = CreateWaitableTimerExW(nullptr, nullptr, 0, TIMER_ALL_ACCESS);
+    }
+    stack_copy_ = static_cast<uint8_t*>(
+        VirtualAlloc(nullptr, kStackCopySize + 16, MEM_COMMIT | MEM_RESERVE,
+                     PAGE_READWRITE));
+    if (!stop_event_ || !timer_ || !stack_copy_) {
+      XELOGE("guest_profile: couldn't create the sampler's resources");
+      return false;
+    }
+    period_us_ = std::clamp(cvars::guest_profile_period_us, 100u, 100000u);
+    EnableFrameMarks(true);
+    reporter_ = std::thread([this]() { ReporterMain(); });
+    sampler_ = std::thread([this]() { SamplerMain(); });
+    return true;
+  }
+
+  void Stop() override {
+    if (sampler_.joinable()) {
+      SetEvent(stop_event_);
+      sampler_.join();
+    }
+    if (reporter_.joinable()) {
+      {
+        std::lock_guard<std::mutex> lock(report_mutex_);
+        report_stop_ = true;
+      }
+      report_cv_.notify_all();
+      reporter_.join();
+    }
+    EnableFrameMarks(false);
+    for (Slot& slot : slots_) {
+      if (slot.handle) {
+        CloseHandle(slot.handle);
+        slot.handle = nullptr;
+      }
+    }
+    if (timer_) {
+      CloseHandle(timer_);
+      timer_ = nullptr;
+    }
+    if (stop_event_) {
+      CloseHandle(stop_event_);
+      stop_event_ = nullptr;
+    }
+    if (stack_copy_) {
+      VirtualFree(stack_copy_, 0, MEM_RELEASE);
+      stack_copy_ = nullptr;
+    }
+  }
+
+ private:
+  struct Slot {
+    uint32_t thread_id = 0;
+    uint32_t host_id = 0;
+    std::string name;
+    HANDLE handle = nullptr;
+    uint64_t stack_base = 0;
+    bool alive = false;
+    uint64_t last_sample = 0;
+    // The thread's CPU cycles at the last capture, or once it settled after
+    // it; settling: the first tick after a capture that stopped in a system
+    // call, when the capture's own cost is still in the count.
+    uint64_t cycles = 0;
+    bool settling = false;
+    // The wait it settled in (when the system answers wait probes).
+    WaitInfo wait;
+    bool wait_known = false;
+    // The last capture: its frames in the current window, and whether it
+    // was in a system call.
+    bool in_system_call = false;
+    bool truncated = false;
+    uint32_t window = UINT32_MAX;
+    uint32_t frame_begin = 0;
+    uint16_t frame_count = 0;
+  };
+
+  void SamplerMain() {
+    threading::set_name("Guest Profiler");
+    // A sampler preempted while a thread is stopped would keep it stopped:
+    // stay above the game's threads (some run at the highest normal
+    // priority).
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    frequency_ = Clock::QueryHostTickFrequency();
+    random_ = Clock::QueryHostTickCount() | 1;
+    const uint64_t report_ticks =
+        frequency_ * std::max<uint32_t>(cvars::guest_profile_report_s, 1);
+    StartWindow(Clock::QueryHostTickCount());
+    uint64_t next_refresh = 0;
+    for (;;) {
+      // Between half and one and a half periods, so samples don't lock to
+      // anything periodic in the threads.
+      random_ ^= random_ << 13;
+      random_ ^= random_ >> 7;
+      random_ ^= random_ << 17;
+      const uint64_t wait_us =
+          period_us_ / 2 + random_ % std::max<uint32_t>(period_us_, 1);
+      LARGE_INTEGER due;
+      due.QuadPart = -int64_t(wait_us * 10);
+      SetWaitableTimer(timer_, &due, 0, nullptr, nullptr, FALSE);
+      const HANDLE handles[] = {stop_event_, timer_};
+      if (WaitForMultipleObjects(2, handles, FALSE, INFINITE) !=
+          WAIT_OBJECT_0 + 1) {
+        break;
+      }
+      const uint64_t now = Clock::QueryHostTickCount();
+      if (now >= next_refresh) {
+        RefreshThreads(now);
+        next_refresh = now + frequency_;
+      }
+      ++window_.stats.ticks;
+      for (uint16_t i = 0; i < slots_.size(); ++i) {
+        if (slots_[i].alive && !TakeSample(i, now)) {
+          // A thread couldn't be resumed: stop sampling at once.
+          XELOGE(
+              "guest_profile: couldn't resume thread {:X} ({}); sampling "
+              "stopped",
+              slots_[i].thread_id, slots_[i].name);
+          QueueReport(Clock::QueryHostTickCount());
+          return;
+        }
+      }
+      window_.swaps_lost +=
+          TakeFrameMarks(&swap_cursor_, &window_.swaps, &window_.swap_threads);
+      if (now - window_.start >= report_ticks) {
+        QueueReport(now);
+      }
+    }
+    QueueReport(Clock::QueryHostTickCount());
+  }
+
+  void RefreshThreads(uint64_t now) {
+    for (Slot& slot : slots_) {
+      slot.alive = false;
+    }
+    std::vector<size_t> added;
+    processor_->VisitThreadDebugInfos([&](const ThreadDebugInfo& info) {
+      if (!info.thread || info.state == ThreadDebugInfo::State::kExited ||
+          info.state == ThreadDebugInfo::State::kZombie) {
+        return;
+      }
+      threading::Thread* thread = info.thread->thread();
+      if (!thread) {
+        return;
+      }
+      HANDLE native = static_cast<HANDLE>(thread->native_handle());
+      // A pseudo-handle (GetCurrentThread) would name this thread.
+      if (!native || native == GetCurrentThread()) {
+        return;
+      }
+      for (Slot& slot : slots_) {
+        if (slot.handle && slot.thread_id == info.thread_id) {
+          slot.alive = true;
+          return;
+        }
+      }
+      HANDLE handle = nullptr;
+      if (!DuplicateHandle(GetCurrentProcess(), native, GetCurrentProcess(),
+                           &handle, 0, FALSE, DUPLICATE_SAME_ACCESS)) {
+        return;
+      }
+      if (slots_.size() >= UINT16_MAX ||
+          GetThreadId(handle) == GetCurrentThreadId()) {
+        CloseHandle(handle);
+        return;
+      }
+      Slot slot;
+      slot.thread_id = info.thread_id;
+      slot.host_id = GetThreadId(handle);
+      slot.handle = handle;
+      slot.alive = true;
+      added.push_back(slots_.size());
+      slots_.push_back(std::move(slot));
+    });
+    for (size_t index : added) {
+      Slot& slot = slots_[index];
+      if (!ReadStackBase(slot.handle, &slot.stack_base)) {
+        slot.alive = false;
+      }
+      slot.last_sample = now;
+    }
+    for (Slot& slot : slots_) {
+      if (!slot.alive && slot.handle) {
+        CloseHandle(slot.handle);
+        slot.handle = nullptr;
+      } else if (slot.alive) {
+        // Names change (the game names its threads after starting them).
+        slot.name = ThreadDescription(slot.handle);
+        if (slot.name.empty()) {
+          slot.name = fmt::format("thread {:X}", slot.thread_id);
+        }
+      }
+    }
+  }
+
+  // Returns false if the thread couldn't be resumed.
+  bool TakeSample(uint16_t index, uint64_t now) {
+    Slot& slot = slots_[index];
+    const uint64_t period_ticks = frequency_ * period_us_ / 1000000;
+    uint64_t weight = now - slot.last_sample;
+    if (!weight || weight > period_ticks * 50) {
+      weight = period_ticks;
+    }
+    slot.last_sample = now;
+    ULONG64 cycles = 0;
+    if (!QueryThreadCycleTime(slot.handle, &cycles)) {
+      ++window_.stats.failures;
+      return true;
+    }
+    // Hasn't run since the last capture (but for what the capture itself
+    // cost it): still waiting in the same system call, or stopped by
+    // something else (paused, suspended by the guest, created suspended).
+    // A running thread's cycle count may lag, so it must also be in a wait
+    // now: the system's wait probe once it has answered, else a stop in a
+    // system call.
+    if (slot.window == window_id_ && slot.frame_count) {
+      WaitInfo wait;
+      const bool waiting = QueryWaiting(slot.handle, &wait);
+      if (waiting) {
+        wait_probe_ = true;
+      }
+      bool same = false;
+      if (wait_probe_ ? waiting : slot.in_system_call) {
+        if (slot.settling) {
+          const uint64_t cost = cycles - slot.cycles;
+          same = cost <= kCaptureCycleAllowance;
+          if (same) {
+            window_.stats.max_capture_cycles =
+                std::max(window_.stats.max_capture_cycles, cost);
+            slot.settling = false;
+            slot.cycles = cycles;
+            slot.wait = wait;
+            slot.wait_known = waiting;
+          }
+        } else {
+          same = cycles == slot.cycles &&
+                 (!slot.wait_known || !waiting || wait == slot.wait);
+        }
+      }
+      if (same) {
+        AddSample(
+            index, now, weight,
+            kSampleRepeated |
+                (slot.in_system_call ? kSampleSystemCall : kSampleStopped) |
+                (slot.truncated ? kSampleTruncated : 0),
+            slot.frame_begin, slot.frame_count);
+        ++window_.stats.repeats;
+        return true;
+      }
+    }
+    slot.cycles = cycles;
+    const uint64_t stop_start = Clock::QueryHostTickCount();
+    const Capture capture =
+        CaptureStopped(slot.handle, &context_, slot.stack_base, stack_copy_);
+    const uint64_t stopped = Clock::QueryHostTickCount() - stop_start;
+    if (capture.resume_failed) {
+      return false;
+    }
+    window_.stats.stopped_ticks += stopped;
+    window_.stats.max_stopped_ticks =
+        std::max(window_.stats.max_stopped_ticks, stopped);
+    if (!capture.size) {
+      ++window_.stats.failures;
+      slot.frame_count = 0;
+      slot.in_system_call = false;
+      return true;
+    }
+    ++window_.stats.captures;
+    const uint64_t leaf = context_.Rip;
+    const bool complete = UnwindCopy(&context_, stack_copy_ + capture.offset,
+                                     capture.size, known_code_, &frames_);
+    slot.in_system_call = AfterSystemCall(leaf);
+    slot.settling = true;
+    slot.wait_known = false;
+    slot.truncated = !complete;
+    slot.window = window_id_;
+    slot.frame_begin = uint32_t(window_.frames.size());
+    slot.frame_count = uint16_t(frames_.size());
+    window_.frames.insert(window_.frames.end(), frames_.begin(), frames_.end());
+    AddSample(index, now, weight,
+              (slot.in_system_call ? kSampleSystemCall : 0) |
+                  (complete ? 0 : kSampleTruncated),
+              slot.frame_begin, slot.frame_count);
+    return true;
+  }
+
+  void AddSample(uint16_t thread, uint64_t now, uint64_t weight, uint8_t flags,
+                 uint32_t frame_begin, uint16_t frame_count) {
+    Sample sample;
+    sample.time = now;
+    sample.thread = thread;
+    sample.weight = uint32_t(std::min<uint64_t>(weight, UINT32_MAX));
+    sample.flags = flags;
+    sample.frame_begin = frame_begin;
+    sample.frame_count = frame_count;
+    window_.samples.push_back(sample);
+  }
+
+  uint64_t ThreadCpuTicks() {
+    FILETIME creation, exit, kernel, user;
+    if (!GetThreadTimes(GetCurrentThread(), &creation, &exit, &kernel, &user)) {
+      return 0;
+    }
+    const uint64_t hundred_ns =
+        (uint64_t(kernel.dwHighDateTime) << 32 | kernel.dwLowDateTime) +
+        (uint64_t(user.dwHighDateTime) << 32 | user.dwLowDateTime);
+    return hundred_ns * frequency_ / 10000000;
+  }
+
+  void StartWindow(uint64_t now) {
+    window_ = Window();
+    ++window_id_;
+    window_.tick_frequency = frequency_;
+    window_.period_us = period_us_;
+    window_.start = now;
+    window_cpu_start_ = ThreadCpuTicks();
+    for (Slot& slot : slots_) {
+      // Repeats point into the window's frames.
+      slot.window = UINT32_MAX;
+    }
+  }
+
+  // Hands the window to the report thread and starts the next one.
+  void QueueReport(uint64_t now) {
+    if (!window_.samples.empty()) {
+      window_.end = now;
+      window_.stats.sampler_cpu_ticks = ThreadCpuTicks() - window_cpu_start_;
+      window_.stats.report_ticks =
+          last_report_ticks_.load(std::memory_order_relaxed);
+      window_.stats.wait_probe = wait_probe_;
+      window_.threads.clear();
+      for (const Slot& slot : slots_) {
+        window_.threads.push_back({slot.name, slot.thread_id, slot.host_id});
+      }
+      {
+        std::lock_guard<std::mutex> lock(report_mutex_);
+        if (report_queue_.size() >= 2) {
+          ++windows_dropped_;
+        } else {
+          window_.stats.windows_dropped = windows_dropped_;
+          windows_dropped_ = 0;
+          report_queue_.push_back(std::make_unique<Window>(std::move(window_)));
+        }
+      }
+      report_cv_.notify_one();
+    }
+    StartWindow(now);
+  }
+
+  void ReporterMain() {
+    threading::set_name("Guest Profiler Reports");
+    Win32Symbolizer symbolizer(code_cache_);
+    if (symbolizer.map_symbols()) {
+      XELOGI("guest_profile: {} functions from {}", symbolizer.map_symbols(),
+             xe::path_to_utf8(symbolizer.map_path()));
+    } else if (symbolizer.map_stale()) {
+      XELOGW(
+          "guest_profile: {} is from another build of the executable; "
+          "Xenia's own functions are named by address",
+          xe::path_to_utf8(symbolizer.map_path()));
+    } else {
+      XELOGW(
+          "guest_profile: no linker map next to the executable; Xenia's own "
+          "functions are named by address");
+    }
+    ReportOptions options;
+    options.slow_frame_ms = cvars::guest_profile_slow_frame_ms;
+    for (;;) {
+      std::unique_ptr<Window> window;
+      {
+        std::unique_lock<std::mutex> lock(report_mutex_);
+        report_cv_.wait(
+            lock, [&]() { return report_stop_ || !report_queue_.empty(); });
+        if (report_queue_.empty()) {
+          return;
+        }
+        window = std::move(report_queue_.front());
+        report_queue_.pop_front();
+      }
+      const uint64_t start = Clock::QueryHostTickCount();
+      for (const std::string& line :
+           BuildReport(*window, symbolizer, options)) {
+        XELOGI("Guest profile: {}", line);
+      }
+      last_report_ticks_.store(Clock::QueryHostTickCount() - start,
+                               std::memory_order_relaxed);
+    }
+  }
+
+  Processor* processor_;
+  backend::CodeCache* code_cache_ = nullptr;
+  KnownCode known_code_;
+  std::thread sampler_;
+  std::thread reporter_;
+  HANDLE stop_event_ = nullptr;
+  HANDLE timer_ = nullptr;
+  uint8_t* stack_copy_ = nullptr;
+  CONTEXT context_;
+  std::vector<uint64_t> frames_;
+  uint32_t period_us_ = 1000;
+  uint64_t frequency_ = 1;
+  uint64_t random_ = 1;
+  bool wait_probe_ = false;
+  std::vector<Slot> slots_;
+  Window window_;
+  uint32_t window_id_ = 0;
+  uint64_t window_cpu_start_ = 0;
+  uint64_t swap_cursor_ = 0;
+
+  std::mutex report_mutex_;
+  std::condition_variable report_cv_;
+  std::deque<std::unique_ptr<Window>> report_queue_;
+  bool report_stop_ = false;
+  uint32_t windows_dropped_ = 0;
+  std::atomic<uint64_t> last_report_ticks_{0};
+};
+
+}  // namespace
+
+std::unique_ptr<GuestProfiler> GuestProfiler::Create(Processor* processor) {
+  if (!cvars::guest_profile) {
+    return nullptr;
+  }
+  auto profiler = std::make_unique<Win32GuestProfiler>(processor);
+  if (!profiler->Start()) {
+    return nullptr;
+  }
+  XELOGI("guest_profile: sampling every {} us, a report every {} s",
+         cvars::guest_profile_period_us, cvars::guest_profile_report_s);
+  return profiler;
+}
+
+#else  // XE_ARCH_AMD64
+
+std::unique_ptr<GuestProfiler> GuestProfiler::Create(Processor* processor) {
+  if (cvars::guest_profile) {
+    XELOGW("guest_profile: not supported on this platform");
+  }
+  return nullptr;
+}
