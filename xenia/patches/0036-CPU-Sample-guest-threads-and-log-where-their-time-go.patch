+#include <string>
+#include <vector>
+
+#include "third_party/catch/include/catch.hpp"
+#include "xenia/cpu/guest_profiler.h"
+
+namespace xe {
+namespace cpu {
+namespace testing {
+namespace {
+
+using namespace guest_profile;
+
+// Host PCs: 1 << 40 plus a guest instruction (its function is the address
+// rounded down to 0x100) for translated code, 2 << 40 plus a symbol for
+// emulator code; 3 << 40 is a syscall stub.
+constexpr uint64_t kGuest = uint64_t(1) << 40;
+constexpr uint64_t kHost = uint64_t(2) << 40;
+
+class FakeSymbolizer : public Symbolizer {
+ public:
+  ResolvedFrame Resolve(uint64_t pc, bool leaf) override {
+    ResolvedFrame frame;
+    if ((pc >> 40) == 1) {
+      frame.kind = FrameKind::kGuest;
+      frame.guest_pc = uint32_t(pc);
+      frame.guest_function = uint32_t(pc) & ~uint32_t(0xFF);
+      // 820F0000: a register save/restore helper.
+      frame.fold = frame.guest_function == 0x820F0000;
+    } else if ((pc >> 40) == 2) {
+      frame.kind = FrameKind::kHost;
+      frame.symbol = uint32_t(pc & 0xFF);
+    } else {
+      frame.kind = FrameKind::kUnknown;
+      frame.symbol = 99;
+    }
+    return frame;
+  }
+  const std::string* GuestFunctionName(uint32_t function) override {
+    static const std::string kWait = "KeWaitForSingleObject";
+    return function == 0x820D0000 ? &kWait : nullptr;
+  }
+  const std::string& SymbolName(uint32_t symbol) override {
+    names_.resize(100);
+    if (names_[symbol].empty()) {
+      names_[symbol] =
+          symbol == 99 ? "(unknown code)" : "host" + std::to_string(symbol);
+    }
+    return names_[symbol];
+  }
+
+ private:
+  std::vector<std::string> names_;
+};
+
+void AddSample(Window& window, uint16_t thread, uint64_t time, uint32_t weight,
+               uint8_t flags, std::vector<uint64_t> frames) {
+  Sample sample;
+  sample.time = time;
+  sample.thread = thread;
+  sample.weight = weight;
+  sample.flags = flags;
+  sample.frame_begin = uint32_t(window.frames.size());
+  sample.frame_count = uint16_t(frames.size());
+  window.frames.insert(window.frames.end(), frames.begin(), frames.end());
+  window.samples.push_back(sample);
+}
+
+bool Contains(const std::vector<std::string>& lines, const std::string& text) {
+  for (const std::string& line : lines) {
+    if (line.find(text) != std::string::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+TEST_CASE("Guest profiler frame marks", "[guest_profiler]") {
+  uint64_t cursor = 0;
+  std::vector<uint64_t> swaps;
+  std::vector<uint32_t> threads;
+  EnableFrameMarks(false);
+  GuestProfiler::MarkFrame();
+  REQUIRE(TakeFrameMarks(&cursor, &swaps, &threads) == 0);
+  REQUIRE(swaps.empty());
+  EnableFrameMarks(true);
+  for (int i = 0; i < 3; ++i) {
+    GuestProfiler::MarkFrame();
+  }
+  REQUIRE(TakeFrameMarks(&cursor, &swaps, &threads) == 0);
+  REQUIRE(swaps.size() == 3);
+  REQUIRE(threads.size() == 3);
+  REQUIRE(threads[0] == threads[2]);
+  REQUIRE(swaps[0] <= swaps[1]);
+  REQUIRE(swaps[1] <= swaps[2]);
+  // Overflow: only the last ring's worth is kept.
+  for (int i = 0; i < 5000; ++i) {
+    GuestProfiler::MarkFrame();
+  }
+  swaps.clear();
+  threads.clear();
+  REQUIRE(TakeFrameMarks(&cursor, &swaps, &threads) == 5000 - 4096);
+  REQUIRE(swaps.size() == 4096);
+  EnableFrameMarks(false);
+}
+
+TEST_CASE("Guest profiler report", "[guest_profiler]") {
+  Window window;
+  // 1000 ticks a millisecond.
+  window.tick_frequency = 1000000;
+  window.start = 0;
+  window.end = 1000000;  // 1 s
+  window.period_us = 1000;
+  window.threads = {{"Main", 0x10, 1}, {"Idle", 0x20, 2}, {"Stopped", 0x30, 3}};
+  // Frames of 10 ms over the whole second, except one of 50 ms (slow) from
+  // 100 to 150 ms: 96 frames, from host thread 1 (Main); one swap from
+  // thread 2 in between doesn't count.
+  for (uint64_t time = 0; time <= 1000000; time += 10000) {
+    if (time > 100000 && time < 150000) {
+      continue;
+    }
+    window.swaps.push_back(time);
+    window.swap_threads.push_back(1);
+    if (time == 50000) {
+      window.swaps.push_back(55000);
+      window.swap_threads.push_back(2);
+    }
+  }
+
+  // Main, in the 10 ms frames: 820A0010 (own code) called from 820B0020,
+  // 60 samples of 1 ms; 820A0010 calling emulator function host1, 20 samples.
+  for (uint64_t i = 0; i < 60; ++i) {
+    AddSample(window, 0, 1000 + i * 1000, 1000, 0,
+              {kGuest | 0x820A0010, kGuest | 0x820B0024});
+  }
+  for (uint64_t i = 0; i < 20; ++i) {
+    AddSample(window, 0, 61000 + i * 1000, 1000, 0,
+              {kHost | 1, kGuest | 0x820A0040, kGuest | 0x820B0024});
+  }
+  // In the slow frame: 820C0000 runs 40 ms.
+  for (uint64_t i = 0; i < 40; ++i) {
+    AddSample(window, 0, 105000 + i * 1000, 1000, 0,
+              {kGuest | 0x820C0008, kGuest | 0x820B0024});
+  }
+  // A wait: 10 samples in a system call under the named import stub
+  // 820D0000, called from 820B0000.
+  for (uint64_t i = 0; i < 10; ++i) {
+    AddSample(window, 0, 200000 + i * 1000, 1000,
+              kSampleSystemCall | (i ? kSampleRepeated : 0),
+              {kHost | 7, kHost | 2, kGuest | 0x820D0004, kGuest | 0x820B0030});
+  }
+  // The idle thread: only system calls.
+  AddSample(window, 1, 500000, 1000000, kSampleSystemCall, {kHost | 7});
+  // A thread stopped in guest code for half of the window counts as
+  // waiting, not running.
+  AddSample(window, 2, 600000, 500000, kSampleStopped | kSampleRepeated,
+            {kGuest | 0x820E0010});
+
+  FakeSymbolizer symbolizer;
+  ReportOptions options;
+  std::vector<std::string> lines = BuildReport(window, symbolizer, options);
+  // Shown with any failing check below.
+  std::string report;
+  for (const std::string& line : lines) {
+    report += line;
+    report += '\n';
+  }
+  INFO(report);
+  // 96 frames: per-frame figures divide by 96.
+  REQUIRE(Contains(lines, "96 frames"));
+  REQUIRE(Contains(lines,
+                   "frames are Main's swaps, 1 from other threads "
+                   "left out"));
+  REQUIRE(Contains(lines, "1 slow frames over 15.00 ms"));
+  REQUIRE(Contains(lines, "Main: 1.250 ms/frame running, 0.104 waiting"));
+  // Own time: 820A0000 80 samples (60 own code + 20 in host1).
+  REQUIRE(Contains(lines,
+                   "    0.833  66.7%  820A0000  emulator 0.208 "
+                   "(host1 100%)  from 820B0000 100%"));
+  REQUIRE(Contains(lines, "    0.417  33.3%  820C0000  from 820B0000 100%"));
+  // Call trees: 820B0000 is under everything that ran.
+  REQUIRE(Contains(lines, "820B0000 1.250 100%;"));
+  // Waits: the import stub 820D0000 in host7 (a system call).
+  REQUIRE(Contains(lines,
+                   "Main waiting (ms/frame; where it waited, in system calls "
+                   "or stopped): 820D0000 KeWaitForSingleObject 0.104 "
+                   "(host7);"));
+  // Emulator code: host1 for 820A0000.
+  REQUIRE(Contains(lines, "    0.208 /   0.208  host1  for 820A0000 100%"));
+  // Hot instructions: 820A0010 own code 60/80, 820A0040 a call 20/80.
+  REQUIRE(Contains(lines, "  820A0000: 820A0010 75% 820A0040c 25%"));
+  // Slow frames: 820C0000 used 40 ms in the slow frame, nothing in others.
+  REQUIRE(Contains(lines, "own 820C0000 40.00 / 0.00;"));
+  // The idle thread is summarized only.
+  REQUIRE(Contains(lines, "Idle [20] 0/100;"));
+  REQUIRE(Contains(lines, "Stopped [30] 0/50;"));
+  REQUIRE(!Contains(lines, "Idle own time"));
+}
+
+TEST_CASE("Guest profiler folds helpers into their callers",
+          "[guest_profiler]") {
+  Window window;
+  window.tick_frequency = 1000000;
+  window.end = 100000;
+  window.period_us = 1000;
+  window.threads = {{"Main", 0x10}};
+  // Stopped in a save helper called from 820A0010, called from 820B0024.
+  for (uint64_t i = 0; i < 100; ++i) {
+    AddSample(window, 0, i * 1000, 1000, 0,
+              {kGuest | 0x820F0008, kGuest | 0x820A0010, kGuest | 0x820B0024});
+  }
+  FakeSymbolizer symbolizer;
+  std::vector<std::string> lines =
+      BuildReport(window, symbolizer, ReportOptions());
+  // All own time goes to 820A0000 (no swaps: figures per second), and the
+  // helper doesn't show anywhere.
+  REQUIRE(Contains(lines, "  1000.000 100.0%  820A0000  from 820B0000 100%"));
+  REQUIRE(!Contains(lines, "820F0000"));
+}
