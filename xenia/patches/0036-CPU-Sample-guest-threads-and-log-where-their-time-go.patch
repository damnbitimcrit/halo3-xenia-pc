diff --git a/src/xenia/cpu/guest_profiler.cc b/src/xenia/cpu/guest_profiler.cc
new file mode 100644
index 0000000..57d8a71
--- /dev/null
+++ b/src/xenia/cpu/guest_profiler.cc
@@ -0,0 +1,687 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 damnbitimcrit. All rights reserved.                         *
