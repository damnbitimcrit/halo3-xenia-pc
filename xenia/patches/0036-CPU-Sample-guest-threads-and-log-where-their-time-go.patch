+// The thread's name as Windows has it (XThread::set_name forwards there).
+std::string ThreadDescription(HANDLE thread) {
+  using GetThreadDescriptionFn = HRESULT(WINAPI*)(HANDLE, PWSTR*);
+  static const auto get =
+      reinterpret_cast<GetThreadDescriptionFn>(GetProcAddress(
+          GetModuleHandleW(L"kernelbase.dll"), "GetThreadDescription"));
+  PWSTR description = nullptr;
+  if (!get || FAILED(get(thread, &description)) || !description) {
+    return std::string();
+  }
+  std::string name = xe::to_utf8(
+      std::u16string_view(reinterpret_cast<char16_t*>(description)));
+  LocalFree(description);
+  return name;
+}
+
+bool ReadStackBase(HANDLE thread, uint64_t* stack_base) {
+  struct ThreadBasicInformation {
+    LONG exit_status;
+    PVOID teb_base_address;
+    HANDLE client_process;
+    HANDLE client_thread;
+    ULONG_PTR affinity_mask;
+    LONG priority;
+    LONG base_priority;
+  };
+  const NtQueryInformationThreadFn query = QueryInformationThread();
+  ThreadBasicInformation info = {};
+  // 0: ThreadBasicInformation.
+  if (!query || query(thread, 0, &info, sizeof(info), nullptr) < 0 ||
+      !info.teb_base_address) {
+    return false;
+  }
+  NT_TIB tib;
+  if (!CopyMemoryGuarded(&tib, info.teb_base_address, sizeof(tib))) {
+    return false;
+  }
+  *stack_base = uint64_t(uintptr_t(tib.StackBase));
+  return *stack_base != 0;
+}
