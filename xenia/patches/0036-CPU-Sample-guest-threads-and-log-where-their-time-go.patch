+
+#include "xenia/cpu/guest_profiler.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <unordered_map>
+#include <utility>
+
+#include "third_party/fmt/include/fmt/format.h"
+#include "xenia/base/clock.h"
+#include "xenia/base/cvar.h"
+#include "xenia/base/threading.h"
+
+DEFINE_bool(guest_profile, false,
+            "Sample the emulated threads about every guest_profile_period_us "
+            "and log where their time goes every guest_profile_report_s "
+            "seconds (\"Guest profile\" lines). Windows only. Costs about 1% "
+            "of each busy thread.",
+            "CPU");
+DEFINE_uint32(guest_profile_period_us, 1000,
+              "guest_profile: average time between samples of a thread, in "
+              "microseconds (each wait is randomized between half and one "
+              "and a half times this).",
+              "CPU");
+DEFINE_uint32(guest_profile_report_s, 30,
+              "guest_profile: seconds between reports.", "CPU");
+DEFINE_double(guest_profile_slow_frame_ms, 0.0,
+              "guest_profile: frames (VdSwap to VdSwap) longer than this are "
+              "slow; 0: 1.5 times the median frame and at least 1 ms over "
+              "it.",
+              "CPU");
+
+namespace xe {
+namespace cpu {
+
+namespace guest_profile {
+
+namespace {
+
+constexpr size_t kFrameMarkRingSize = 4096;
+std::atomic<bool> frame_marks_enabled{false};
+std::atomic<uint64_t> frame_mark_count{0};
+std::array<std::atomic<uint64_t>, kFrameMarkRingSize> frame_mark_ticks;
+std::array<std::atomic<uint32_t>, kFrameMarkRingSize> frame_mark_threads;
+
+}  // namespace
+
+void EnableFrameMarks(bool enabled) {
+  frame_marks_enabled.store(enabled, std::memory_order_release);
+}
+
+uint32_t TakeFrameMarks(uint64_t* cursor, std::vector<uint64_t>* ticks,
+                        std::vector<uint32_t>* threads) {
+  const uint64_t count = frame_mark_count.load(std::memory_order_acquire);
+  if (count < *cursor) {
+    *cursor = count;
+  }
+  uint32_t lost = 0;
+  if (count - *cursor > kFrameMarkRingSize) {
+    lost = uint32_t(count - kFrameMarkRingSize - *cursor);
+    *cursor = count - kFrameMarkRingSize;
+  }
+  for (; *cursor < count; ++*cursor) {
+    const size_t slot = *cursor % kFrameMarkRingSize;
+    ticks->push_back(frame_mark_ticks[slot].load(std::memory_order_relaxed));
+    threads->push_back(
+        frame_mark_threads[slot].load(std::memory_order_relaxed));
+  }
+  return lost;
+}
+
+namespace {
+
+// Time in microseconds, split by whether the thread was running or in a
+// system call.
+struct Time {
+  double running = 0.0;
+  double system = 0.0;
+  void Add(double us, bool system_call) {
+    (system_call ? system : running) += us;
+  }
+  double total() const { return running + system; }
+};
+
+struct FunctionStats {
+  // As the innermost guest function on the stack: its own code and the
+  // emulator code it called.
+  Time own;
+  // Of own: stopped in emulator code (host or thunks).
+  Time own_emulator;
+  // Anywhere on the stack, once per sample.
+  Time tree;
+  // own and tree (running and system calls) in slow and other frames.
+  double own_slow = 0.0, own_normal = 0.0;
+  double tree_slow = 0.0, tree_normal = 0.0;
+  // own by the guest function that called it (0: none).
+  std::unordered_map<uint32_t, double> callers;
+  // own by guest instruction; bit 32 set for a call into emulator code.
+  std::unordered_map<uint64_t, double> instructions;
+  // own_emulator (running) by the emulator function stopped in; system
+  // calls by the system call stopped in.
+  std::unordered_map<uint32_t, double> emulator_leaves;
+  std::unordered_map<uint32_t, double> system_calls;
+};
+
+struct HostStats {
+  // Stopped in this function.
+  Time own;
+  // Anywhere between the stop and the innermost guest function.
+  Time tree;
+  double tree_slow = 0.0, tree_normal = 0.0;
+  // tree by the innermost guest function (0: none).
+  std::unordered_map<uint32_t, double> guest_callers;
+};
+
+struct ThreadStats {
+  Time time;
+  uint32_t samples = 0;
+  uint32_t repeated = 0;
+  uint32_t truncated = 0;
+  uint64_t depth = 0;
+  std::unordered_map<uint32_t, FunctionStats> functions;
+  std::unordered_map<uint32_t, HostStats> host;
+};
+
+template <typename Map>
+std::vector<std::pair<typename Map::key_type, double>> Top(const Map& map,
+                                                           size_t count) {
+  std::vector<std::pair<typename Map::key_type, double>> entries(map.begin(),
+                                                                 map.end());
+  std::sort(entries.begin(), entries.end(), [](const auto& a, const auto& b) {
+    return a.second != b.second ? a.second > b.second : a.first < b.first;
+  });
+  if (entries.size() > count) {
+    entries.resize(count);
+  }
+  return entries;
+}
+
+double Percentile(const std::vector<double>& sorted, double fraction) {
+  if (sorted.empty()) {
+    return 0.0;
+  }
+  const size_t index = std::min(
+      sorted.size() - 1, size_t(fraction * double(sorted.size() - 1) + 0.5));
+  return sorted[index];
+}
+
+std::string GuestName(uint32_t function) {
+  return function ? fmt::format("{:08X}", function) : std::string("(none)");
+}
+
+}  // namespace
+
+std::vector<std::string> BuildReport(const Window& window,
+                                     Symbolizer& symbolizer,
+                                     const ReportOptions& options) {
+  std::vector<std::string> lines;
+  const double frequency = double(std::max<uint64_t>(window.tick_frequency, 1));
+  const double ticks_to_us = 1000000.0 / frequency;
+  const double ticks_to_ms = 1000.0 / frequency;
+  const double seconds = double(window.end - window.start) / frequency;
+
+  // Frames: the time between consecutive swaps of the thread that swapped
+  // most (a game may also swap from a loading or keep-alive thread).
+  std::vector<uint64_t> swaps = window.swaps;
+  uint32_t swap_thread = 0;
+  size_t other_swaps = 0;
+  if (window.swap_threads.size() == window.swaps.size() && !swaps.empty()) {
+    std::unordered_map<uint32_t, size_t> counts;
+    for (uint32_t thread : window.swap_threads) {
+      ++counts[thread];
+    }
+    size_t most = 0;
+    for (const auto& [thread, count] : counts) {
+      if (count > most || (count == most && thread < swap_thread)) {
+        most = count;
+        swap_thread = thread;
+      }
+    }
+    swaps.clear();
+    for (size_t i = 0; i < window.swaps.size(); ++i) {
+      if (window.swap_threads[i] == swap_thread) {
+        swaps.push_back(window.swaps[i]);
+      }
+    }
+    other_swaps = window.swaps.size() - swaps.size();
+  }
+  std::vector<double> frame_ms;
+  for (size_t i = 1; i < swaps.size(); ++i) {
+    if (swaps[i] >= swaps[i - 1]) {
+      frame_ms.push_back(double(swaps[i] - swaps[i - 1]) * ticks_to_ms);
+    }
+  }
+  std::vector<double> sorted_ms = frame_ms;
+  std::sort(sorted_ms.begin(), sorted_ms.end());
+  const double median_ms = Percentile(sorted_ms, 0.5);
+  double slow_ms = options.slow_frame_ms;
+  if (slow_ms <= 0.0) {
+    slow_ms = std::max(median_ms * 1.5, median_ms + 1.0);
+  }
+  uint32_t slow_frames = 0;
+  double slow_total_ms = 0.0;
+  uint32_t over[3] = {};
+  const double over_ms[3] = {1000.0 / 120.0, 1000.0 / 60.0, 1000.0 / 30.0};
+  for (double ms : frame_ms) {
+    if (ms > slow_ms) {
+      ++slow_frames;
+      slow_total_ms += ms;
+    }
+    for (size_t i = 0; i < 3; ++i) {
+      if (ms > over_ms[i]) {
+        ++over[i];
+      }
+    }
+  }
+  const uint32_t normal_frames = uint32_t(frame_ms.size()) - slow_frames;
+  // 0: outside the frames, 1: in a frame, 2: in a slow frame.
+  const auto classify = [&](uint64_t time) -> int {
+    auto it = std::upper_bound(swaps.begin(), swaps.end(), time);
+    if (it == swaps.begin() || it == swaps.end()) {
+      return 0;
+    }
+    const uint64_t frame_ticks = *it - *(it - 1);
+    return double(frame_ticks) * ticks_to_ms > slow_ms ? 2 : 1;
+  };
+
+  // Per-frame figures cover the samples between the first and the last swap,
+  // divided by the frames between them; with too few frames, per second over
+  // the whole window.
+  const bool per_frame = frame_ms.size() >= std::max(options.min_frames, 1u);
+  const uint64_t span_begin = per_frame ? swaps.front() : window.start;
+  const uint64_t span_end = per_frame ? swaps.back() : window.end;
+  const double span_seconds =
+      std::max(double(span_end - span_begin) / frequency, 1e-9);
+  const double divisor = per_frame ? double(frame_ms.size()) : span_seconds;
+  const char* const unit = per_frame ? "ms/frame" : "ms/s";
+  const auto ms = [&](double us) { return us / 1000.0 / divisor; };
+
+  const SamplerStats& s = window.stats;
+  std::string summary = fmt::format("{:.1f} s; ", seconds);
+  if (per_frame) {
+    summary += fmt::format(
+        "{} frames ({:.1f}/s), frame ms median {:.2f}, p90 {:.2f}, p99 "
+        "{:.2f}, max {:.2f}; over 8.3 ms {}, 16.7 ms {}, 33.3 ms {}; {} slow "
+        "frames over {:.2f} ms ({:.0f} ms in all); ",
+        frame_ms.size(), double(frame_ms.size()) / span_seconds, median_ms,
+        Percentile(sorted_ms, 0.9), Percentile(sorted_ms, 0.99),
+        sorted_ms.empty() ? 0.0 : sorted_ms.back(), over[0], over[1], over[2],
+        slow_frames, slow_ms, slow_total_ms);
+    if (span_seconds < seconds * 0.9) {
+      summary += fmt::format("figures from the {:.1f} s between swaps; ",
+                             span_seconds);
+    }
+    if (other_swaps) {
+      std::string swapper = fmt::format("host thread {:X}", swap_thread);
+      for (const ThreadInfo& info : window.threads) {
+        if (info.host_id == swap_thread) {
+          swapper = info.name;
+          break;
+        }
+      }
+      summary +=
+          fmt::format("frames are {}'s swaps, {} from other threads left out; ",
+                      swapper, other_swaps);
+    }
+    if (window.swaps_lost) {
+      summary += fmt::format("{} swaps not seen; ", window.swaps_lost);
+    }
+  } else {
+    summary += fmt::format(
+        "{} frames, too few for per-frame figures (figures per second); ",
+        frame_ms.size());
+  }
+  summary += fmt::format(
+      "sampling every {} us: {} stacks, {} repeated (wait probe {}), {} "
+      "failed; threads stopped {:.1f} us a stack (longest {:.0f} us), a "
+      "capture costs a waiting thread up to {} cycles; sampler {:.1f}% of a "
+      "core; the last report took {:.0f} ms{}",
+      window.period_us, s.captures, s.repeats, s.wait_probe ? "on" : "off",
+      s.failures,
+      s.captures ? double(s.stopped_ticks) * ticks_to_us / s.captures : 0.0,
+      double(s.max_stopped_ticks) * ticks_to_us, s.max_capture_cycles,
+      seconds > 0.0
+          ? double(s.sampler_cpu_ticks) * ticks_to_us / (seconds * 10000.0)
+          : 0.0,
+      double(s.report_ticks) * ticks_to_ms,
+      s.windows_dropped
+          ? fmt::format("; {} windows not reported (report thread behind)",
+                        s.windows_dropped)
+          : std::string());
+  lines.push_back(std::move(summary));
+
+  std::vector<ThreadStats> threads(window.threads.size());
+  std::vector<ResolvedFrame> resolved;
+  std::vector<uint32_t> seen_functions;
+  std::vector<uint32_t> seen_symbols;
+  for (const Sample& sample : window.samples) {
+    if (sample.thread >= threads.size() || !sample.frame_count) {
+      continue;
+    }
+    if (sample.time < span_begin || sample.time >= span_end) {
+      continue;
+    }
+    ThreadStats& t = threads[sample.thread];
+    const double us = double(sample.weight) * ticks_to_us;
+    // Waiting: in a system call, or stopped by something else.
+    const bool system_call =
+        (sample.flags & (kSampleSystemCall | kSampleStopped)) != 0;
+    t.time.Add(us, system_call);
+    ++t.samples;
+    if (sample.flags & kSampleRepeated) {
+      ++t.repeated;
+    }
+    if (sample.flags & kSampleTruncated) {
+      ++t.truncated;
+    }
+    t.depth += sample.frame_count;
+
+    resolved.clear();
+    int innermost = -1;
+    for (uint32_t i = 0; i < sample.frame_count; ++i) {
+      const ResolvedFrame frame =
+          symbolizer.Resolve(window.frames[sample.frame_begin + i], i == 0);
+      if (frame.kind == FrameKind::kGuest && frame.fold) {
+        // Part of its caller: leave it out.
+        continue;
+      }
+      if (innermost < 0 && frame.kind == FrameKind::kGuest) {
+        innermost = int(resolved.size());
+      }
+      resolved.push_back(frame);
+    }
+    if (resolved.empty()) {
+      continue;
+    }
+    const int frame_class = classify(sample.time);
+    const uint32_t function =
+        innermost >= 0 ? resolved[innermost].guest_function : 0;
+
+    FunctionStats& f = t.functions[function];
+    f.own.Add(us, system_call);
+    if (frame_class == 2) {
+      f.own_slow += us;
+    } else if (frame_class == 1) {
+      f.own_normal += us;
+    }
+    if (innermost != 0) {
+      f.own_emulator.Add(us, system_call);
+      const uint32_t leaf_symbol = resolved[0].symbol;
+      (system_call ? f.system_calls : f.emulator_leaves)[leaf_symbol] += us;
+    }
+    if (innermost >= 0) {
+      f.instructions[uint64_t(resolved[innermost].guest_pc) |
+                     (innermost > 0 ? uint64_t(1) << 32 : 0)] += us;
+      uint32_t caller = 0;
+      for (size_t i = size_t(innermost) + 1; i < resolved.size(); ++i) {
+        if (resolved[i].kind == FrameKind::kGuest) {
+          caller = resolved[i].guest_function;
+          break;
+        }
+      }
+      f.callers[caller] += us;
+    }
+
+    seen_functions.clear();
+    for (const ResolvedFrame& frame : resolved) {
+      if (frame.kind != FrameKind::kGuest ||
+          std::find(seen_functions.begin(), seen_functions.end(),
+                    frame.guest_function) != seen_functions.end()) {
+        continue;
+      }
+      seen_functions.push_back(frame.guest_function);
+      FunctionStats& g = t.functions[frame.guest_function];
+      g.tree.Add(us, system_call);
+      if (frame_class == 2) {
+        g.tree_slow += us;
+      } else if (frame_class == 1) {
+        g.tree_normal += us;
+      }
+    }
+
+    if (resolved[0].kind != FrameKind::kGuest) {
+      t.host[resolved[0].symbol].own.Add(us, system_call);
+    }
+    seen_symbols.clear();
+    const size_t host_end =
+        innermost >= 0 ? size_t(innermost) : resolved.size();
+    for (size_t i = 0; i < host_end; ++i) {
+      const uint32_t symbol = resolved[i].symbol;
+      if (resolved[i].kind == FrameKind::kGuest ||
+          std::find(seen_symbols.begin(), seen_symbols.end(), symbol) !=
+              seen_symbols.end()) {
+        continue;
+      }
+      seen_symbols.push_back(symbol);
+      HostStats& h = t.host[symbol];
+      h.tree.Add(us, system_call);
+      h.guest_callers[function] += us;
+      if (frame_class == 2) {
+        h.tree_slow += us;
+      } else if (frame_class == 1) {
+        h.tree_normal += us;
+      }
+    }
+  }
+
+  // Thread summary, busiest first.
+  std::vector<size_t> order;
+  for (size_t i = 0; i < threads.size(); ++i) {
+    if (threads[i].samples) {
+      order.push_back(i);
+    }
+  }
+  std::sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+    return threads[a].time.running > threads[b].time.running;
+  });
+  const double window_us = span_seconds * 1000000.0;
+  {
+    std::string line = "threads (running / waiting, % of the time):";
+    size_t listed = 0;
+    for (size_t i : order) {
+      if (listed++ == 16) {
+        line += fmt::format(" and {} more", order.size() - 16);
+        break;
+      }
+      const ThreadStats& t = threads[i];
+      line += fmt::format(" {} [{:X}] {:.0f}/{:.0f};", window.threads[i].name,
+                          window.threads[i].thread_id,
+                          t.time.running * 100.0 / window_us,
+                          t.time.system * 100.0 / window_us);
+    }
+    lines.push_back(std::move(line));
+  }
+
+  const auto name_of = [&](uint32_t symbol) -> const std::string& {
+    return symbolizer.SymbolName(symbol);
+  };
+  const auto guest_name = [&](uint32_t function) {
+    const std::string* name =
+        function ? symbolizer.GuestFunctionName(function) : nullptr;
+    return name ? GuestName(function) + " " + *name : GuestName(function);
+  };
+  for (size_t index : order) {
+    const ThreadStats& t = threads[index];
+    if (t.time.running * 100.0 < options.min_thread_percent * window_us) {
+      continue;
+    }
+    const std::string& name = window.threads[index].name;
+    lines.push_back(fmt::format(
+        "{}: {:.3f} {} running, {:.3f} waiting; {} samples ({} "
+        "repeated), {:.1f}% of stacks cut short, {:.1f} frames deep",
+        name, ms(t.time.running), unit, ms(t.time.system), t.samples,
+        t.repeated, t.truncated * 100.0 / t.samples,
+        double(t.depth) / t.samples));
+
+    // Own time, by the running part.
+    std::vector<std::pair<uint32_t, const FunctionStats*>> functions;
+    for (const auto& [function, stats] : t.functions) {
+      functions.emplace_back(function, &stats);
+    }
+    std::sort(functions.begin(), functions.end(),
+              [](const auto& a, const auto& b) {
+                return a.second->own.running != b.second->own.running
+                           ? a.second->own.running > b.second->own.running
+                           : a.first < b.first;
+              });
+    lines.push_back(fmt::format(
+        "{} own time ({} running, share of running; of it in emulator code, "
+        "the top emulator functions; called from):",
+        name, unit));
+    std::vector<uint32_t> top_functions;
+    for (const auto& [function, stats] : functions) {
+      if (top_functions.size() >= options.rows ||
+          stats->own.running < t.time.running * 0.002) {
+        break;
+      }
+      top_functions.push_back(function);
+      std::string line = fmt::format(
+          "  {:7.3f} {:5.1f}%  {}", ms(stats->own.running),
+          stats->own.running * 100.0 / t.time.running, guest_name(function));
+      if (stats->own_emulator.running > 0.0) {
+        line +=
+            fmt::format("  emulator {:.3f}", ms(stats->own_emulator.running));
+        std::string leaves;
+        for (const auto& [symbol, us] : Top(stats->emulator_leaves, 3)) {
+          leaves += fmt::format("{}{} {:.0f}%", leaves.empty() ? "" : ", ",
+                                name_of(symbol),
+                                us * 100.0 / stats->own_emulator.running);
+        }
+        line += " (" + leaves + ")";
+      }
+      std::string callers;
+      for (const auto& [caller, us] : Top(stats->callers, 3)) {
+        callers +=
+            fmt::format("{}{} {:.0f}%", callers.empty() ? "" : ", ",
+                        guest_name(caller), us * 100.0 / stats->own.total());
+      }
+      if (!callers.empty()) {
+        line += "  from " + callers;
+      }
+      lines.push_back(std::move(line));
+    }
+
+    // Waits: own time in system calls or stopped.
+    std::sort(functions.begin(), functions.end(),
+              [](const auto& a, const auto& b) {
+                return a.second->own.system != b.second->own.system
+                           ? a.second->own.system > b.second->own.system
+                           : a.first < b.first;
+              });
+    {
+      std::string line = fmt::format(
+          "{} waiting ({}; where it waited, in system calls or stopped):", name,
+          unit);
+      size_t listed = 0;
+      for (const auto& [function, stats] : functions) {
+        if (listed++ == 8 || stats->own.system <= 0.0 ||
+            stats->own.system < t.time.system * 0.01) {
+          break;
+        }
+        std::string calls;
+        for (const auto& [symbol, us] : Top(stats->system_calls, 2)) {
+          calls +=
+              fmt::format("{}{}", calls.empty() ? "" : ", ", name_of(symbol));
+        }
+        line += fmt::format(" {} {:.3f} ({});", guest_name(function),
+                            ms(stats->own.system), calls);
+      }
+      lines.push_back(std::move(line));
+    }
+
+    // Call trees: every guest function with what it called, by running time.
+    std::sort(functions.begin(), functions.end(),
+              [](const auto& a, const auto& b) {
+                return a.second->tree.running != b.second->tree.running
+                           ? a.second->tree.running > b.second->tree.running
+                           : a.first < b.first;
+              });
+    {
+      std::string line = fmt::format(
+          "{} call trees ({} running, share of running):", name, unit);
+      size_t listed = 0;
+      for (const auto& [function, stats] : functions) {
+        if (!function) {
+          continue;
+        }
+        if (listed++ == options.rows ||
+            stats->tree.running < t.time.running * 0.01) {
+          break;
+        }
+        line += fmt::format(" {} {:.3f} {:.0f}%;", guest_name(function),
+                            ms(stats->tree.running),
+                            stats->tree.running * 100.0 / t.time.running);
+      }
+      lines.push_back(std::move(line));
+    }
+
+    // Emulator code: by the time under each emulator function.
+    {
+      std::vector<std::pair<uint32_t, const HostStats*>> host;
+      for (const auto& [symbol, stats] : t.host) {
+        host.emplace_back(symbol, &stats);
+      }
+      std::sort(host.begin(), host.end(), [](const auto& a, const auto& b) {
+        return a.second->tree.running != b.second->tree.running
+                   ? a.second->tree.running > b.second->tree.running
+                   : a.first < b.first;
+      });
+      lines.push_back(fmt::format(
+          "{} emulator code ({} running: stopped in it / under it; for "
+          "guest functions):",
+          name, unit));
+      size_t listed = 0;
+      for (const auto& [symbol, stats] : host) {
+        if (listed++ == options.rows ||
+            stats->tree.running < t.time.running * 0.002) {
+          break;
+        }
+        std::string callers;
+        for (const auto& [caller, us] : Top(stats->guest_callers, 3)) {
+          callers +=
+              fmt::format("{}{} {:.0f}%", callers.empty() ? "" : ", ",
+                          guest_name(caller), us * 100.0 / stats->tree.total());
+        }
+        lines.push_back(fmt::format(
+            "  {:7.3f} / {:7.3f}  {}  for {}", ms(stats->own.running),
+            ms(stats->tree.running), name_of(symbol), callers));
+      }
+    }
+
+    // The hottest instructions of the functions with the most own time.
+    {
+      lines.push_back(fmt::format(
+          "{} hot instructions (share of the function's own time; c: a call "
+          "into emulator code):",
+          name));
+      size_t listed = 0;
+      for (uint32_t function : top_functions) {
+        if (!function) {
+          continue;
+        }
+        if (listed++ == 12) {
+          break;
+        }
+        const FunctionStats& stats = t.functions.at(function);
+        std::string line = fmt::format("  {}:", guest_name(function));
+        for (const auto& [key, us] : Top(stats.instructions, 6)) {
+          line += fmt::format(" {:08X}{} {:.0f}%", uint32_t(key),
+                              (key >> 32) ? "c" : "",
+                              us * 100.0 / stats.own.total());
+        }
+        lines.push_back(std::move(line));
+      }
+    }
+
+    // What grew in slow frames: per slow frame against per other frame.
+    if (slow_frames && normal_frames) {
+      struct Growth {
+        std::string name;
+        double slow, normal;
+      };
+      std::vector<Growth> growth;
+      for (const auto& [function, stats] : t.functions) {
+        growth.push_back({"own " + guest_name(function),
+                          stats.own_slow / slow_frames,
+                          stats.own_normal / normal_frames});
+        if (function) {
+          growth.push_back({"tree " + guest_name(function),
+                            stats.tree_slow / slow_frames,
+                            stats.tree_normal / normal_frames});
+        }
+      }
+      for (const auto& [symbol, stats] : t.host) {
+        growth.push_back({"emulator " + name_of(symbol),
+                          stats.tree_slow / slow_frames,
+                          stats.tree_normal / normal_frames});
+      }
+      std::sort(growth.begin(), growth.end(),
+                [](const Growth& a, const Growth& b) {
+                  return a.slow - a.normal > b.slow - b.normal;
+                });
+      std::string line = fmt::format(
+          "{} in slow frames (ms per slow frame / per other frame, {} slow, "
+          "{} others):",
+          name, slow_frames, normal_frames);
+      size_t listed = 0;
+      for (const Growth& g : growth) {
+        if (listed++ == 15 || g.slow - g.normal < 100.0) {
+          break;
+        }
+        line += fmt::format(" {} {:.2f} / {:.2f};", g.name, g.slow / 1000.0,
+                            g.normal / 1000.0);
+      }
+      lines.push_back(std::move(line));
+    }
+  }
+  return lines;
+}
+
+}  // namespace guest_profile
+
+void GuestProfiler::MarkFrame() {
+  if (!guest_profile::frame_marks_enabled.load(std::memory_order_relaxed)) {
+    return;
+  }
+  const uint64_t index =
+      guest_profile::frame_mark_count.load(std::memory_order_relaxed);
+  const size_t slot = index % guest_profile::kFrameMarkRingSize;
+  guest_profile::frame_mark_ticks[slot].store(Clock::QueryHostTickCount(),
+                                              std::memory_order_relaxed);
+  guest_profile::frame_mark_threads[slot].store(
+      threading::current_thread_system_id(), std::memory_order_relaxed);
+  guest_profile::frame_mark_count.store(index + 1, std::memory_order_release);
+}
+
+}  // namespace cpu
+}  // namespace xe
diff --git a/src/xenia/cpu/guest_profiler.h b/src/xenia/cpu/guest_profiler.h
new file mode 100644
index 0000000..cef8268
--- /dev/null
+++ b/src/xenia/cpu/guest_profiler.h
@@ -0,0 +1,202 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 damnbitimcrit. All rights reserved.                         *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_CPU_GUEST_PROFILER_H_
+#define XENIA_CPU_GUEST_PROFILER_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace xe {
+namespace cpu {
+
+class Processor;
+
+// Sampling profiler for the emulated threads (guest_profile, off by default).
+// About every millisecond a sampler thread stops each thread for a few
+// microseconds, copies its stack and lets it run again; the copy is unwound
+// afterwards, so nothing the stopped thread may hold (heap, loader or code
+// cache locks) is needed while it is stopped. Translated code is named by the
+// guest function and instruction it came from, Xenia's own code by the linker
+// map next to the executable (xenia_canary.map) and system libraries by their
+// exports. Every guest_profile_report_s seconds the log gets a report per
+// busy thread: time per frame by guest function (own code and the emulator
+// code it called), by whole call tree, by emulator function, the hottest
+// guest instructions, the waits, and what grew in slow frames (frames are the
+// guest's VdSwap calls).
+class GuestProfiler {
+ public:
+  // Starts sampling if guest_profile is set and the platform supports it.
+  static std::unique_ptr<GuestProfiler> Create(Processor* processor);
+  virtual ~GuestProfiler() = default;
+
+  // Stops the sampler and logs the last report. Idempotent.
+  virtual void Stop() = 0;
+
+  // The guest handed a frame to the GPU (VdSwap). Any thread; one relaxed
+  // load when the profiler is off.
+  static void MarkFrame();
+};
+
+namespace guest_profile {
+
+// The platform-independent half: what a sample holds and how a report is
+// built from a window of samples.
+
+enum class FrameKind : uint8_t {
+  kUnknown,
+  // Translated guest code.
+  kGuest,
+  // Code in the code cache that isn't a guest function (thunks).
+  kThunk,
+  // Host code (Xenia, system libraries, drivers).
+  kHost,
+};
+
+struct ResolvedFrame {
+  FrameKind kind = FrameKind::kUnknown;
+  // kGuest: the guest function's address and the guest instruction.
+  uint32_t guest_function = 0;
+  uint32_t guest_pc = 0;
+  // kHost / kThunk / kUnknown: the symbol's index (Symbolizer::SymbolName).
+  uint32_t symbol = 0;
+  // kGuest: a helper counted as part of its caller (register save and
+  // restore helpers).
+  bool fold = false;
+};
+
+class Symbolizer {
+ public:
+  virtual ~Symbolizer() = default;
+  // leaf: pc is where the thread was stopped rather than a return address
+  // (a return address is looked up one byte back, inside the call).
+  virtual ResolvedFrame Resolve(uint64_t pc, bool leaf) = 0;
+  virtual const std::string& SymbolName(uint32_t symbol) = 0;
+  // A guest function's name if it has one (kernel imports), else null.
+  virtual const std::string* GuestFunctionName(uint32_t function) {
+    return nullptr;
+  }
+};
+
+enum SampleFlags : uint8_t {
+  // The thread was stopped right after a system call instruction: waiting,
+  // sleeping, or in the kernel.
+  kSampleSystemCall = 1 << 0,
+  // The thread hadn't run since the previous sample, which was in a system
+  // call: the previous stack, not captured again.
+  kSampleRepeated = 1 << 1,
+  // The unwind stopped before the thread's first frame.
+  kSampleTruncated = 1 << 2,
+  // The thread hadn't run since the previous sample, which wasn't in a
+  // system call: stopped (suspended) there. Counted as waiting.
+  kSampleStopped = 1 << 3,
+};
+
+struct Sample {
+  // Host ticks when it was taken.
+  uint64_t time = 0;
+  // Frames (leaf first) are frames[frame_begin, frame_begin + frame_count).
+  uint32_t frame_begin = 0;
+  uint16_t frame_count = 0;
+  // Index into Window::threads.
+  uint16_t thread = 0;
+  // Host ticks since the thread's previous sample: the time it stands for.
+  uint32_t weight = 0;
+  uint8_t flags = 0;
+};
+
+struct ThreadInfo {
+  std::string name;
+  // The guest's thread id, and the host's (the swap marks carry that one).
+  uint32_t thread_id = 0;
+  uint32_t host_id = 0;
+};
+
+struct SamplerStats {
+  uint32_t ticks = 0;
+  uint32_t captures = 0;
+  uint32_t repeats = 0;
+  uint32_t failures = 0;
+  // Host ticks the stopped threads were stopped (in all, and the longest),
+  // and the sampler thread's CPU time over the window.
+  uint64_t stopped_ticks = 0;
+  uint64_t max_stopped_ticks = 0;
+  uint64_t sampler_cpu_ticks = 0;
+  // Host ticks the previous report took to build (on its own thread).
+  uint64_t report_ticks = 0;
+  // Whether the system says if a thread is waiting (repeats need it then),
+  // and the CPU cycles a capture cost a waiting thread (largest seen).
+  bool wait_probe = false;
+  uint64_t max_capture_cycles = 0;
+  // Windows not reported because the report thread was behind.
+  uint32_t windows_dropped = 0;
+};
+
+struct Window {
+  uint64_t tick_frequency = 1;
+  uint64_t start = 0;
+  uint64_t end = 0;
+  uint32_t period_us = 0;
+  std::vector<ThreadInfo> threads;
+  std::vector<Sample> samples;
+  std::vector<uint64_t> frames;
+  // Host ticks of the guest's swaps (MarkFrame), in order, and the host
+  // thread that made each.
+  std::vector<uint64_t> swaps;
+  std::vector<uint32_t> swap_threads;
+  // Swaps the sampler missed (its ring overflowed).
+  uint32_t swaps_lost = 0;
+  SamplerStats stats;
+
+  void Clear() {
+    samples.clear();
+    frames.clear();
+    swaps.clear();
+    swap_threads.clear();
+    swaps_lost = 0;
+    stats = {};
+  }
+};
+
+struct ReportOptions {
+  // A frame is slow above this many milliseconds; 0: 1.5 times the median
+  // frame and at least 1 ms over it.
+  double slow_frame_ms = 0.0;
+  // Fewer frames than this in a window: figures per second over the whole
+  // window instead of per frame over the frames.
+  uint32_t min_frames = 10;
+  // Threads using less of the window than this (percent) get only their
+  // summary.
+  double min_thread_percent = 3.0;
+  // Rows per table.
+  uint32_t rows = 25;
+};
+
+// The report's log lines (without the "Guest profile" prefix the caller
+// adds).
+std::vector<std::string> BuildReport(const Window& window,
+                                     Symbolizer& symbolizer,
+                                     const ReportOptions& options);
+
+// The swaps GuestProfiler::MarkFrame records while enabled.
+void EnableFrameMarks(bool enabled);
+// Appends the host ticks of the swaps after *cursor, and the host thread of
+// each, and advances *cursor; returns how many were lost to the ring
+// wrapping. One reader.
+uint32_t TakeFrameMarks(uint64_t* cursor, std::vector<uint64_t>* ticks,
+                        std::vector<uint32_t>* threads);
+
+}  // namespace guest_profile
+
+}  // namespace cpu
+}  // namespace xe
+
+#endif  // XENIA_CPU_GUEST_PROFILER_H_
