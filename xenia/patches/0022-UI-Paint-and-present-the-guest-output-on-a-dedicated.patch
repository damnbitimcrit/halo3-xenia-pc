+Presenter::PaintResult Presenter::PresentGuestOutputWithPaintModeLocked(
+    bool on_present_thread) {
+  switch (paint_mode_) {
+    case PaintMode::kNone:
+      // Neither painting nor window paint requesting is accessible.
+      return PaintResult::kNotPresented;
+    case PaintMode::kUIThreadOnRequest:
+      // Only window paint requesting is accessible.
+      RequestPaintOrConnectionRecoveryViaWindow(true);
+      return PaintResult::kNotPresented;
+    case PaintMode::kGuestOutputThreadImmediately: {
+      // Both painting and window paint requesting are accessible.
+      if (surface_paint_connection_state_ !=
+          SurfacePaintConnectionState::kConnectedPaintable) {
+        // Outdated - the UI thread has been requested to reconnect.
+        return PaintResult::kNotPresented;
+      }
+      gpu::GpuThreadStats& stats = gpu::gpu_thread_stats();
+      gpu::GuestOutputPaintStats& paint_stats = on_present_thread
+                                                    ? stats.present_thread_paint
+                                                    : stats.gpu_thread_paint;
+      PaintResult paint_result;
+      {
+        gpu::ScopedGpuThreadTicks paint_ticks(paint_stats.ticks);
+        gpu::guest_output_paint_stats = &paint_stats;
+        paint_result = PaintAndPresent(false);
+        gpu::guest_output_paint_stats = nullptr;
+      }
+      paint_stats.paints.fetch_add(1, std::memory_order_relaxed);
+      if (surface_paint_connection_state_ ==
+          SurfacePaintConnectionState::kConnectedOutdated) {
+        RequestPaintOrConnectionRecoveryViaWindow(true);
+      }
+      return paint_result;
+    }
+  }
+  return PaintResult::kNotPresented;
+}
+
+void Presenter::PresentThread() {
+  xe::threading::set_name("Present");
+#if XE_PLATFORM_WIN32
+  // Above the GPU emulation thread and the guest threads (normal priority) so
+  // the paint is submitted and presented soon after the refresh even when they
+  // keep the cores busy - this thread sleeps for most of the frame otherwise.
+  // Not higher, in case the host present call ever spins.
+  SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+#endif  // XE_PLATFORM
+  // The newest refresh that has been presented (or of which the UI thread has
+  // been requested to paint, or that couldn't be presented in the current paint
+  // mode at all) - including the newer image a paint may have taken over the
+  // one it has been notified about, so a later notification about that image
+  // doesn't present it again (with variable refresh rate, presenting the same
+  // image twice would delay the next one).
+  uint64_t handled_refresh = 0;
+  std::unique_lock<std::mutex> present_thread_lock(present_thread_mutex_);
+  while (true) {
+    present_thread_condition_.wait(
+        present_thread_lock, [this, &handled_refresh]() {
+          return present_thread_shutdown_ ||
+                 present_thread_latest_refresh_ > handled_refresh;
+        });
+    if (present_thread_shutdown_) {
+      return;
+    }
+    // Coalesce all the refreshes since the last paint into one paint, of the
+    // newest ready image.
+    handled_refresh = present_thread_latest_refresh_;
+    const uint64_t refresh_host_ticks =
+        present_thread_latest_refresh_host_ticks_;
+    // present_thread_mutex_ is a leaf lock, not held while painting.
+    present_thread_lock.unlock();
+    PaintResult paint_result;
+    {
+      // Held for the whole check of the paint mode and the paint, so the UI
+      // thread can take over painting with SetPaintModeFromUIThread.
+      std::lock_guard<std::mutex> paint_mode_mutex_lock(paint_mode_mutex_);
+      gpu::GpuThreadStats& stats = gpu::gpu_thread_stats();
+      stats.present_thread_wakes.fetch_add(1, std::memory_order_relaxed);
+      stats.present_thread_delay_ticks.fetch_add(
+          Clock::QueryHostTickCount() - refresh_host_ticks,
+          std::memory_order_relaxed);
+      consumed_guest_output_refresh = 0;
+      paint_result = PresentGuestOutputWithPaintModeLocked(true);
+      handled_refresh =
+          std::max(handled_refresh, consumed_guest_output_refresh);
+    }
+    if (paint_result == PaintResult::kGpuLostResponsible ||
+        paint_result == PaintResult::kGpuLostExternally) {
+      // The end of the entry point, with no locks held. The callback must not
+      // destroy the presenter synchronously from this thread, as destruction
+      // joins it.
+      if (host_gpu_loss_callback_) {
+        host_gpu_loss_callback_(
+            paint_result == PaintResult::kGpuLostResponsible, false);
+      }
+      // Don't paint with the lost device anymore - stay idle until the
+      // presenter is destroyed (without waiting for any other thread).
+      present_thread_lock.lock();
+      present_thread_condition_.wait(
+          present_thread_lock, [this]() { return present_thread_shutdown_; });
+      return;
+    }
+    present_thread_lock.lock();
+  }
+}
