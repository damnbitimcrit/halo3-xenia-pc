+        if (SubmitBuffer(frames_[held], channel_samples_, nullptr)) {
+          queued_frames_.fetch_add(1, std::memory_order_acq_rel);
+          frames_submitted_.fetch_add(1, std::memory_order_acq_rel);
+          last_frame_ = held;
+        } else {
+          semaphore_->Release(1, nullptr);
+        }
+      }
+      held_count_ = 0;
+      playing_ = true;
+      stats.resumes.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+  const uint32_t queued =
+      queued_frames_.load(std::memory_order_relaxed) + held_count_;
+  uint32_t min_queued = stats.min_queued_frames.load(std::memory_order_relaxed);
+  while (queued < min_queued &&
+         !stats.min_queued_frames.compare_exchange_weak(
+             min_queued, queued, std::memory_order_relaxed)) {
+  }
+
+  // Keep audio in sync with the game clock.
+  const float frequency_ratio =
+      static_cast<float>(xe::Clock::guest_time_scalar());
+  if (frequency_ratio != frequency_ratio_) {
+    frequency_ratio_ = frequency_ratio;
+    if (api_minor_version_ >= 8) {
+      objects_.api_2_8.pcm_voice->SetFrequencyRatio(frequency_ratio);
+    } else {
+      objects_.api_2_7.pcm_voice->SetFrequencyRatio(frequency_ratio);
+    }
   }
 }
 
