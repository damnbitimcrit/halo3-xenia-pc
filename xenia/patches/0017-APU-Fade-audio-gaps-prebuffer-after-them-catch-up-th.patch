+void XAudio2AudioDriver::OnBufferEnd(void* context) {
+  // Fade outs (context set) don't hold a frame of the semaphore.
+  if (context) {
+    return;
+  }
+  if (smoothing_) {
+    queued_frames_.fetch_sub(1, std::memory_order_acq_rel);
+  }
+  auto ret = semaphore_->Release(1, nullptr);
+  assert_true(ret);
