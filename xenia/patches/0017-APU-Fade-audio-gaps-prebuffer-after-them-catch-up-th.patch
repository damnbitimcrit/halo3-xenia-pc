 #include "xenia/apu/xma_decoder.h"
 #include "xenia/base/assert.h"
 #include "xenia/base/byte_stream.h"
@@ -184,8 +187,54 @@ void AudioSystem::WorkerThreadMain() {
 
       SCOPE_profile_cpu_i("apu", "xe::apu::AudioSystem->client_callback");
       uint64_t args[] = {client_callback_arg};
-      processor_->Execute(worker_thread_->thread_state(), client_callback, args,
-                          xe::countof(args));
+      AudioStats& stats = audio_stats();
+      const auto pump = [&]() {
+        const auto pump_start = std::chrono::steady_clock::now();
+        processor_->Execute(worker_thread_->thread_state(), client_callback,
+                            args, xe::countof(args));
+        const uint64_t pump_us =
+            uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                         std::chrono::steady_clock::now() - pump_start)
+                         .count());
+        if (pump_us > kAudioPumpInterval) {
+          stats.slow_pumps.fetch_add(1, std::memory_order_relaxed);
+          uint32_t slowest =
+              stats.slowest_pump_us.load(std::memory_order_relaxed);
+          while (pump_us > slowest &&
+                 !stats.slowest_pump_us.compare_exchange_weak(
+                     slowest, uint32_t(pump_us), std::memory_order_relaxed)) {
+          }
+        }
+      };
+      const uint64_t pump_start_us = static_cast<uint64_t>(
+          std::chrono::duration_cast<std::chrono::microseconds>(
+              std::chrono::steady_clock::now().time_since_epoch())
+              .count());
+      if (pump_start_us > earliest_pump_us + 1000) {
+        stats.late_pumps.fetch_add(1, std::memory_order_relaxed);
+      }
+      stats.pumps.fetch_add(1, std::memory_order_relaxed);
+      pump();
+
+      // The cadence never runs ahead of itself, so each late pump lowers the
+      // output queue for good, until it runs dry. While the queue is below
+      // the prebuffer target, request a few extra frames right away; this
+      // only refills it, it doesn't move the cadence.
+      auto& client = clients_[client_index];
+      const uint32_t max_catchup =
+          uint32_t(std::max(cvars::apu_max_catchup_frames, 0));
+      client.catchup_tokens = std::min(client.catchup_tokens + 1, max_catchup);
+      const uint32_t target =
+          uint32_t(std::max(cvars::apu_prebuffer_frames, 0));
+      while (client.catchup_tokens && client.driver &&
+             client.driver->QueuedFrames() < target &&
+             xe::threading::Wait(client_semaphores_[client_index].get(), false,
+                                 std::chrono::milliseconds(0)) ==
+                 xe::threading::WaitResult::kSuccess) {
+        --client.catchup_tokens;
+        stats.catchup_pumps.fetch_add(1, std::memory_order_relaxed);
+        pump();
+      }
     }
   }
   worker_running_ = false;
