+void XAudio2AudioDriver::OnVoiceProcessingPassStart(uint32_t bytes_required) {
+  // A non-zero count means the queued frames don't cover this pass. Anything
+  // submitted after this returns is too late for it, so queue a fade out
+  // that continues from the last sample instead of the output cutting off.
+  if (!smoothing_ || !bytes_required || !fade_samples_) {
+    return;
+  }
+  const uint32_t frames_submitted =
+      frames_submitted_.load(std::memory_order_acquire);
+  // Never wait here. If SubmitFrame holds the lock, a frame is arriving now,
+  // which may still be in time for this pass; if not, the pass ends early
+  // without a fade, as without smoothing.
+  std::unique_lock<std::mutex> lock(smoothing_mutex_, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    audio_stats().hard_underruns.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  if (!playing_ || last_frame_ >= frame_count_ ||
+      frames_submitted_.load(std::memory_order_acquire) != frames_submitted) {
+    // Already dry, or a frame was submitted while this waited for the lock.
     return;
   }
+  // The last frame played backwards from its last sample, under a raised
+  // cosine: no step at the join and none at the end.
+  const float* last = frames_[last_frame_];
+  float* fade_out = fade_out_[fade_out_next_];
+  fade_out_next_ ^= 1;
+  for (uint32_t i = 0; i < fade_samples_; ++i) {
+    const float gain = 0.5f * (1.0f + std::cos(3.14159265f * float(i + 1) /
+                                               float(fade_samples_ + 1)));
+    const float* source = last + (channel_samples_ - 1 - i) * frame_channels_;
+    float* target = fade_out + i * frame_channels_;
+    for (uint32_t c = 0; c < frame_channels_; ++c) {
+      target[c] = source[c] * gain;
+    }
+  }
+  SubmitBuffer(fade_out, fade_samples_, fade_out);
+  playing_ = false;
+  audio_stats().underruns.fetch_add(1, std::memory_order_relaxed);
+}
