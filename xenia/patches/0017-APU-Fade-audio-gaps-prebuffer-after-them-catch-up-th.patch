+#ifndef XENIA_APU_AUDIO_STATS_H_
+#define XENIA_APU_AUDIO_STATS_H_
+
+#include <atomic>
+#include <cstdint>
+
+namespace xe {
+namespace apu {
+
+// Counters for the audio output path, for titles that log performance
+// statistics; readers exchange them with 0. Header only, so any library can
+// read them without linking the audio code.
+struct AudioStats {
+  // AudioSystem worker: guest audio callbacks run on the regular cadence and
+  // as catch-up after a late one, callbacks that started more than 1 ms late,
+  // and callbacks that took longer than a frame (5.3 ms), with the longest.
+  std::atomic<uint32_t> pumps{0};
+  std::atomic<uint32_t> catchup_pumps{0};
+  std::atomic<uint32_t> late_pumps{0};
+  std::atomic<uint32_t> slow_pumps{0};
+  std::atomic<uint32_t> slowest_pump_us{0};
+  // Output (XAudio2 with apu_prebuffer_frames): times it ran dry with a fade
+  // out, passes that started short while a frame was being submitted (no
+  // fade out; the frame may still have been in time), and resumes after
+  // prebuffering; the fewest frames queued after a frame was submitted.
+  std::atomic<uint32_t> underruns{0};
+  std::atomic<uint32_t> hard_underruns{0};
+  std::atomic<uint32_t> resumes{0};
+  std::atomic<uint32_t> min_queued_frames{UINT32_MAX};
+};
+
+inline AudioStats& audio_stats() {
+  static AudioStats stats;
+  return stats;
+}
+
+}  // namespace apu
+}  // namespace xe
+
+#endif  // XENIA_APU_AUDIO_STATS_H_
