+UnitAim LoadAim(cpu::ppc::PPCContext* ctx, uint32_t object) {
+  return {LoadVector3(ctx, object + kUnitAiming),
+          LoadVector3(ctx, object + kBipedEyeOffset)};
+}
+void StoreAim(cpu::ppc::PPCContext* ctx, uint32_t object, const UnitAim& aim) {
+  StoreVector3(ctx, object + kUnitAiming, aim.aiming);
+  StoreVector3(ctx, object + kBipedEyeOffset, aim.eye_offset);
+}
+
+UnitAim BlendAim(const UnitAim& a, const UnitAim& b, float t) {
+  UnitAim r;
+  r.eye_offset = Lerp(a.eye_offset, b.eye_offset, t);
+  r.aiming = b.aiming;
+  if (!SameBits(a.aiming, b.aiming) && IsUnitVector(a.aiming) &&
+      IsUnitVector(b.aiming)) {
+    const Vector3 v = Lerp(a.aiming, b.aiming, t);
+    const float length_squared = Dot(v, v);
+    if (length_squared > 1e-6f) {
+      const float inv = 1.0f / std::sqrt(length_squared);
+      r.aiming = {v.x * inv, v.y * inv, v.z * inv};
+    }
+  }
+  return r;
+}
