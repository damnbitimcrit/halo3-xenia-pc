-constexpr uint32_t kRenderThreadModeAddress = 0x82948F68;
 
 // Only the game's main thread runs main_time_update.
 struct FramePacer {
@@ -70,7 +80,12 @@ struct FramePacer {
   uint64_t deadline = 0;
 };
 FramePacer pacer;
