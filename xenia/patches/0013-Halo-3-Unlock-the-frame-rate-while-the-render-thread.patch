 }
 
-bool Unlocked(cpu::ppc::PPCContext* ctx) {
-  return cvars::halo3_unlock_framerate &&
-         !xe::load_and_swap<uint32_t>(
-             ctx->TranslateVirtual(kRenderThreadModeAddress));
-}
+bool Unlocked() { return cvars::halo3_unlock_framerate; }
 
 // Run right before a conditional branch on CR6[EQ] to pick its direction:
 // ForceEqual takes a `beq` / falls through a `bne`, ForceNotEqual the reverse.
 void ForceEqual(cpu::ppc::PPCContext* ctx, void*) {
-  if (Unlocked(ctx)) {
+  if (Unlocked()) {
     ctx->cr6.cr6_none_equal = 1;  // CR6[EQ]
   }
 }
 void ForceNotEqual(cpu::ppc::PPCContext* ctx, void*) {
-  if (Unlocked(ctx)) {
+  if (Unlocked()) {
     ctx->cr6.cr6_none_equal = 0;
   }
 }
 
-// The present's wait branch runs once per present, on the main thread in
-// game and on the render thread for loading screens.
+// The present's wait branch runs once per present: on the render thread in
+// game, on the main thread while the game draws single-threaded.
 void OnPresent(cpu::ppc::PPCContext* ctx, void*) {
-  stats().presents++;
+  Stats& s = stats();
+  s.presents++;
+  if (!OnMainThread(ctx)) {
+    s.render_thread_presents++;
+    if (Unlocked()) {
+      const uint64_t now = Clock::QueryGuestTickCount();
+      frame_delta_seconds = last_present_ticks
+                                ? float(double(now - last_present_ticks) /
+                                        double(Clock::guest_tick_frequency()))
+                                : 0.0f;
+      last_present_ticks = now;
+    } else {
+      frame_delta_seconds = 0.0f;
+      last_present_ticks = 0;
+    }
+  }
   ForceEqual(ctx, nullptr);
 }
 
@@ -146,8 +172,8 @@ void OnMainTimeDtComputed(cpu::ppc::PPCContext* ctx, void*) {
 
 float FrameDeltaSeconds() { return frame_delta_seconds; }
 
-void OnPacingFrameStart(cpu::ppc::PPCContext* ctx) {
