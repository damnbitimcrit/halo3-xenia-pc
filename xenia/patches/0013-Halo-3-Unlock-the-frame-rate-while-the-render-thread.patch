+thread_local float frame_delta_seconds = 0.0f;
+thread_local uint64_t last_present_ticks = 0;
 
 void WaitForFrameDeadline(uint64_t frequency) {
   const int32_t limit = cvars::halo3_framerate_limit;
@@ -99,29 +114,40 @@ void WaitForFrameDeadline(uint64_t frequency) {
