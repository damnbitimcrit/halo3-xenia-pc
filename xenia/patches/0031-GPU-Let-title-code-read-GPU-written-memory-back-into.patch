+void CommandProcessor::ServiceGuestReadback() {
+  GuestReadback& readback = guest_readback();
+  if (!readback.pending.load(std::memory_order_acquire)) {
+    return;
+  }
+  uint32_t starts[GuestReadback::kMaxRanges];
+  uint32_t lengths[GuestReadback::kMaxRanges];
+  uint32_t count;
+  {
+    // The requester holds the mutex only for a few stores between its waits:
+    // don't wait for it here, poll again instead (finishing below waits for
+    // those stores at most).
+    std::unique_lock<std::mutex> lock(readback.mutex, std::try_to_lock);
+    if (!lock.owns_lock()) {
+      return;
+    }
+    readback.pending.store(false, std::memory_order_relaxed);
+    if (readback.state != GuestReadback::State::kPending) {
+      return;
+    }
+    readback.state = GuestReadback::State::kRunning;
+    count = readback.count;
+    std::copy_n(readback.starts, count, starts);
+    std::copy_n(readback.lengths, count, lengths);
+  }
+  GpuProfileZone profile_zone(GpuProfileBucket::kSync);
+  const uint64_t start_ticks = Clock::QueryHostTickCount();
+  uint32_t bytes = 0;
+  const bool succeeded = ReadbackToGuestMemory(starts, lengths, count, bytes);
+  const uint64_t service_us = (Clock::QueryHostTickCount() - start_ticks) *
+                              1000000 / Clock::QueryHostTickFrequency();
+  {
+    std::lock_guard<std::mutex> lock(readback.mutex);
+    readback.succeeded = succeeded;
+    readback.bytes = bytes;
+    readback.service_us = service_us;
+    readback.state = GuestReadback::State::kDone;
+  }
+  readback.changed.notify_all();
+}
