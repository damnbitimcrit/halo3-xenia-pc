+bool D3D12CommandProcessor::ReadbackToGuestMemory(const uint32_t* starts,
+                                                  const uint32_t* lengths,
+                                                  uint32_t count,
+                                                  uint32_t& bytes) {
+  bytes = 0;
+  std::vector<std::pair<uint32_t, uint32_t>>& parts = guest_readback_parts_;
+  parts.clear();
+  uint64_t total_length = 0;
+  {
+    auto global_lock = global_critical_region::Acquire();
+    for (uint32_t i = 0; i < count; ++i) {
+      shared_memory_->ForEachGpuNewerPart(
+          starts[i], lengths[i],
+          [&](uint32_t part_start, uint32_t part_length) {
+            parts.emplace_back(part_start, part_length);
+            total_length += part_length;
+          });
+    }
+  }
+  if (!total_length) {
+    return true;
+  }
+  if (total_length > SharedMemory::kBufferSize) {
+    return false;
+  }
+  // d3d12_submit_on_primary_buffer_end has usually ended the submission, and
+  // commands recorded outside one would be dropped.
+  if (!BeginSubmission(false)) {
+    return false;
+  }
+  ID3D12Resource* readback_buffer =
+      RequestReadbackBuffer(uint32_t(total_length));
+  if (!readback_buffer) {
+    return false;
+  }
+  // Also commits the UAV writes of memory export draws.
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  ID3D12Resource* shared_memory_buffer = shared_memory_->GetBuffer();
+  uint32_t readback_offset = 0;
+  for (const std::pair<uint32_t, uint32_t>& part : parts) {
+    deferred_command_list_.D3DCopyBufferRegion(readback_buffer, readback_offset,
+                                               shared_memory_buffer, part.first,
+                                               part.second);
+    readback_offset += part.second;
+  }
+  // Ends the submission, drains the submission thread and awaits the GPU. If
+  // ending it failed, the copies haven't been submitted.
+  if (!AwaitAllQueueOperationsCompletion() || submission_open_) {
+    return false;
+  }
+  D3D12_RANGE read_range;
+  read_range.Begin = 0;
+  read_range.End = SIZE_T(total_length);
+  void* mapping;
+  if (FAILED(readback_buffer->Map(0, &read_range, &mapping))) {
+    return false;
+  }
+  {
+    // Guest writes invalidate pages under this lock (their access violations
+    // wait for it): a part the CPU wrote since the copy is skipped. The
+    // physical view has no write watches, so nothing is invalidated, and the
+    // pages stay valid with the same data as guest memory now.
+    auto global_lock = global_critical_region::Acquire();
+    const uint8_t* part_bytes = static_cast<const uint8_t*>(mapping);
+    for (const std::pair<uint32_t, uint32_t>& part : parts) {
+      shared_memory_->ForEachGpuNewerPart(
+          part.first, part.second,
+          [&](uint32_t copy_start, uint32_t copy_length) {
+            std::memcpy(memory_->TranslatePhysical(copy_start),
+                        part_bytes + (copy_start - part.first), copy_length);
+            bytes += copy_length;
+          });
+      part_bytes += part.second;
+    }
+  }
+  D3D12_RANGE written_range = {};
+  readback_buffer->Unmap(0, &written_range);
+  return true;
+}
