+bool VulkanCommandProcessor::ReadbackToGuestMemory(const uint32_t* starts,
+                                                   const uint32_t* lengths,
+                                                   uint32_t count,
+                                                   uint32_t& bytes) {
+  bytes = 0;
+  std::vector<std::pair<uint32_t, uint32_t>>& parts = guest_readback_parts_;
+  parts.clear();
+  uint64_t total_length = 0;
+  {
+    auto global_lock = global_critical_region::Acquire();
+    for (uint32_t i = 0; i < count; ++i) {
+      shared_memory_->ForEachGpuNewerPart(
+          starts[i], lengths[i],
+          [&](uint32_t part_start, uint32_t part_length) {
+            parts.emplace_back(part_start, part_length);
+            total_length += part_length;
+          });
+    }
+  }
+  if (!total_length) {
+    return true;
+  }
+  if (total_length > SharedMemory::kBufferSize) {
+    return false;
+  }
+  if (!BeginSubmission(false)) {
+    return false;
+  }
+  VkBuffer readback_buffer = RequestReadbackBuffer(uint32_t(total_length));
+  if (readback_buffer == VK_NULL_HANDLE) {
+    return false;
+  }
+  // Unlike the readback_memexport copy in IssueDraw: commit the shader writes
+  // and leave the render pass before the copy, then make the copy visible to
+  // the host (as VulkanSharedMemory::InitializeTraceSubmitDownloads does).
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  SubmitBarriers(true);
+  VkBufferCopy* regions = deferred_command_buffer_.CmdCopyBufferEmplace(
+      shared_memory_->buffer(), readback_buffer, uint32_t(parts.size()));
+  VkDeviceSize readback_offset = 0;
+  for (size_t i = 0; i < parts.size(); ++i) {
+    regions[i].srcOffset = parts[i].first;
+    regions[i].dstOffset = readback_offset;
+    regions[i].size = parts[i].second;
+    readback_offset += parts[i].second;
+  }
+  PushBufferMemoryBarrier(
+      readback_buffer, 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_ACCESS_HOST_READ_BIT);
+  SubmitBarriers(true);
+  if (!AwaitAllQueueOperationsCompletion()) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  void* mapping;
+  if (dfn.vkMapMemory(device, memexport_readback_buffer_memory_, 0,
+                      VK_WHOLE_SIZE, 0, &mapping) != VK_SUCCESS) {
+    return false;
+  }
+  // Readback memory prefers HOST_CACHED, which may not be coherent.
+  VkMappedMemoryRange mapped_range;
+  mapped_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+  mapped_range.pNext = nullptr;
+  mapped_range.memory = memexport_readback_buffer_memory_;
+  mapped_range.offset = 0;
+  mapped_range.size = VK_WHOLE_SIZE;
+  dfn.vkInvalidateMappedMemoryRanges(device, 1, &mapped_range);
+  {
+    // Guest writes invalidate pages under this lock (their access violations
+    // wait for it): a part the CPU wrote since the copy is skipped. The
+    // physical view has no write watches, so nothing is invalidated, and the
+    // pages stay valid with the same data as guest memory now.
+    auto global_lock = global_critical_region::Acquire();
+    const uint8_t* part_bytes = static_cast<const uint8_t*>(mapping);
+    for (const std::pair<uint32_t, uint32_t>& part : parts) {
+      shared_memory_->ForEachGpuNewerPart(
+          part.first, part.second,
+          [&](uint32_t copy_start, uint32_t copy_length) {
+            std::memcpy(memory_->TranslatePhysical(copy_start),
+                        part_bytes + (copy_start - part.first), copy_length);
+            bytes += copy_length;
+          });
+      part_bytes += part.second;
+    }
+  }
+  dfn.vkUnmapMemory(device, memexport_readback_buffer_memory_);
+  return true;
+}
