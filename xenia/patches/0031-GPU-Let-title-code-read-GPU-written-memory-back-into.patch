diff --git a/src/xenia/gpu/shared_memory.h b/src/xenia/gpu/shared_memory.h
index 19b66ad..c9b9022 100644
--- a/src/xenia/gpu/shared_memory.h
+++ b/src/xenia/gpu/shared_memory.h
@@ -86,6 +86,66 @@ class SharedMemory {
   // Whether every page in the range was last written by the GPU (a resolve or
   // memory export) with no CPU write since. Hold the global critical region.
   bool IsRangeValidAndGpuWritten(uint32_t start, uint32_t length) const;
+  // Calls part(start, length) for the bytes of [start, start + length) whose
+  // copy here is newer than guest memory, merging adjacent ones: pages last
+  // written by the GPU (a resolve or memory export) with no CPU write since,
+  // and elsewhere the memory export results memexport_keep_gpu_data keeps.
+  // Everywhere else guest memory is as new or newer, except in pages of
+  // resolves at a draw resolution scale above 1 (written to the scaled resolve
+  // buffer, not here) and words the command processor writes to guest memory
+  // directly (fences, occlusion query results). Hold the global critical
+  // region across the call and whatever relies on its result.
+  template <typename PartFunction>
+  void ForEachGpuNewerPart(uint32_t start, uint32_t length,
+                           PartFunction&& part) const {
+    if (!length || start >= kBufferSize) {
+      return;
+    }
+    const uint32_t end = start + std::min(length, kBufferSize - start);
+    uint32_t part_start = 0, part_end = 0;
+    const auto add = [&](uint32_t add_start, uint32_t add_end) {
+      if (part_end > part_start && part_end == add_start) {
+        part_end = add_end;
+        return;
+      }
+      if (part_end > part_start) {
+        part(part_start, part_end - part_start);
+      }
+      part_start = add_start;
+      part_end = add_end;
+    };
+    // The first kept range ending after start.
+    auto kept_it = std::upper_bound(
+        memexport_kept_ranges_.cbegin(), memexport_kept_ranges_.cend(), start,
+        [](uint32_t value, const std::pair<uint32_t, uint32_t>& range) {
+          return value < range.second;
+        });
+    for (uint32_t position = start; position < end;) {
+      const uint32_t page = position >> page_size_log2_;
+      const uint32_t page_end = std::min(end, (page + 1) << page_size_log2_);
+      if (system_page_flags_valid_and_gpu_written_[page >> 6] &
+          (uint64_t(1) << (page & 63))) {
+        add(position, page_end);
+      } else {
+        for (; kept_it != memexport_kept_ranges_.cend() &&
+               kept_it->first < page_end;
+             ++kept_it) {
+          const uint32_t kept_start = std::max(position, kept_it->first);
+          const uint32_t kept_end = std::min(page_end, kept_it->second);
+          if (kept_start < kept_end) {
+            add(kept_start, kept_end);
+          }
+          if (kept_it->second > page_end) {
+            break;
+          }
+        }
+      }
+      position = page_end;
+    }
+    if (part_end > part_start) {
+      part(part_start, part_end - part_start);
+    }
+  }
 
   void TryFindUploadRange(const uint32_t& block_first,
                           const uint32_t& block_last,
