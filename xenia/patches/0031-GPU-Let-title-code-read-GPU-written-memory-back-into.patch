+#ifndef XENIA_GPU_GUEST_READBACK_H_
+#define XENIA_GPU_GUEST_READBACK_H_
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+namespace xe {
+namespace gpu {
+
+// A guest thread's request that the GPU command processor thread copy what
+// the host GPU wrote into guest memory, for ranges title code knows the CPU is
+// about to read. With readback_memexport off, memory export results otherwise
+// never reach guest memory. Meant for memory export targets: not for ranges
+// with destinations of resolves at a draw resolution scale above 1 (their
+// shared memory copy is older) or words the command processor writes itself
+// (fences, occlusion query results). One request at a time. Header-only, so
+// title code can make it without linking the GPU code.
+struct GuestReadback {
+  static constexpr uint32_t kMaxRanges = 8;
+  enum class State : uint32_t { kIdle, kPending, kRunning, kDone };
+  std::mutex mutex;
+  std::condition_variable changed;
+  // Under mutex.
+  State state = State::kIdle;
+  uint32_t count = 0;
+  uint32_t starts[kMaxRanges] = {};
+  uint32_t lengths[kMaxRanges] = {};
+  bool succeeded = false;
+  uint32_t bytes = 0;
+  uint64_t service_us = 0;
+  // Whether a request may be pending: polled by the command processor thread
+  // without the mutex.
+  std::atomic<bool> pending{false};
+};
+
+inline GuestReadback& guest_readback() {
+  static GuestReadback readback;
+  return readback;
+}
+
+// Set on the command processor thread, which takes the requests: a request
+// made there (by a guest interrupt callback) would wait for itself.
+inline thread_local bool guest_readback_service_thread = false;
+
+enum class GuestReadbackResult { kCopied, kFailed, kNotTaken };
+
+struct GuestReadbackOutcome {
+  GuestReadbackResult result = GuestReadbackResult::kNotTaken;
+  // Copied into guest memory.
+  uint32_t bytes = 0;
+  // On the command processor thread.
+  uint64_t service_us = 0;
+};
+
+// Guest threads only. Copies the bytes of the physical ranges
+// [start, start + length) whose host GPU copy is newer than guest memory,
+// after everything the command processor has executed so far, waiting for the
+// host GPU. If the command processor thread doesn't take the request within
+// timeout, it is withdrawn and guest memory stays as it is. Once taken, it is
+// always finished before this returns, so guest memory never changes after
+// this returns.
+inline GuestReadbackOutcome RequestGuestReadback(
+    const uint32_t* starts, const uint32_t* lengths, uint32_t count,
+    std::chrono::milliseconds timeout) {
+  using State = GuestReadback::State;
+  GuestReadbackOutcome outcome;
+  if (guest_readback_service_thread) {
+    return outcome;
+  }
+  GuestReadback& readback = guest_readback();
+  count = std::min(count, GuestReadback::kMaxRanges);
+  std::unique_lock<std::mutex> lock(readback.mutex);
+  if (!readback.changed.wait_for(lock, timeout, [&readback] {
+        return readback.state == State::kIdle;
+      })) {
+    return outcome;
+  }
+  readback.count = count;
+  std::copy_n(starts, count, readback.starts);
+  std::copy_n(lengths, count, readback.lengths);
+  readback.state = State::kPending;
+  readback.pending.store(true, std::memory_order_release);
+  if (!readback.changed.wait_for(lock, timeout, [&readback] {
+        return readback.state == State::kDone;
+      })) {
+    if (readback.state == State::kPending) {
+      // Not taken: withdraw it.
+      readback.pending.store(false, std::memory_order_relaxed);
+      readback.state = State::kIdle;
+      readback.changed.notify_all();
+      return outcome;
+    }
+    // Taken: only host GPU work is left, which no guest thread holds up.
+    readback.changed.wait(
+        lock, [&readback] { return readback.state == State::kDone; });
+  }
+  outcome.result = readback.succeeded ? GuestReadbackResult::kCopied
+                                      : GuestReadbackResult::kFailed;
+  outcome.bytes = readback.bytes;
+  outcome.service_us = readback.service_us;
+  readback.state = State::kIdle;
+  readback.changed.notify_all();
+  return outcome;
+}
+
+}  // namespace gpu
+}  // namespace xe
+
+#endif  // XENIA_GPU_GUEST_READBACK_H_
