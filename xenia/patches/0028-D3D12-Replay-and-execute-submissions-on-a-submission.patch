+bool D3D12CommandProcessor::PrepareSubmissionThreadJobSlot() {
+  if (submission_thread_unavailable_) {
+    return false;
+  }
+  // A slot whose storage exists is only read by the submission thread while
+  // its job is pending, and a new one has never been handed off.
+  SubmissionThreadJob& job = submission_thread_jobs_[size_t(
+      submission_thread_jobs_enqueued_ % kSubmissionThreadJobSlots)];
+  if (!job.commands) {
+    job.commands = std::make_unique<DeferredCommandList>(*this);
+    if (!job.commands->IsValid()) {
+      XELOGE(
+          "Failed to commit the command storage of a submission thread job; "
+          "submitting on the GPU command processor thread");
+      job.commands.reset();
+      submission_thread_unavailable_ = true;
+      return false;
+    }
+  }
+  if (!submission_thread_.joinable()) {
+    // Started on the first submission handed to it (everything submissions use
+    // exists by now, and the setting may come from per-game configuration,
+    // loaded after SetupContext). Before anything is handed off, so a failure
+    // leaves the submission on this thread.
+    submission_thread_shutdown_ = false;
+    try {
+      submission_thread_ =
+          std::thread(&D3D12CommandProcessor::SubmissionThread, this,
+                      GetD3D12Provider().GetDirectQueue(),
+                      completion_timeline_->GetFence());
+    } catch (const std::system_error& error) {
+      XELOGE(
+          "Failed to start the submission thread ({}); submitting on the GPU "
+          "command processor thread",
+          error.what());
+      submission_thread_unavailable_ = true;
+      return false;
+    }
+  }
+  return true;
+}
+
+void D3D12CommandProcessor::HandOffSubmission(
+    ID3D12CommandAllocator* command_allocator, bool is_swap) {
+  // Started by PrepareSubmissionThreadJobSlot.
+  assert_true(submission_thread_.joinable());
+  // A free slot: at most kSubmissionThreadJobSlots submissions handed off and
+  // not executed yet.
+  // At a swap, part of waiting for the swap's own submission.
+  if (submission_thread_jobs_enqueued_ >= kSubmissionThreadJobSlots) {
+    AwaitSubmissionThreadJobs(
+        submission_thread_jobs_enqueued_ - (kSubmissionThreadJobSlots - 1),
+        is_swap);
+  }
+  SubmissionThreadJob& job = submission_thread_jobs_[size_t(
+      submission_thread_jobs_enqueued_ % kSubmissionThreadJobSlots)];
+  assert_not_null(job.commands);
+  // O(1), without copying. deferred_command_list_ keeps its identity, since
+  // subsystems hold references to it, and gets the slot's previous commands,
+  // already executed.
+  job.commands->SwapCommands(deferred_command_list_);
+  deferred_command_list_.Reset();
+  job.command_allocator = command_allocator;
+  // The number everything recorded for the submission and its allocator were
+  // tagged with. From now on GetCurrentSubmission() is the next one, as after
+  // SignalAndAdvance; the submission thread signals this value after executing.
+  job.fence_value = GetCurrentSubmission();
+  completion_timeline_->IncrementUpcomingSubmission();
+  GpuProfileAdd(GpuProfileCount::kSubmissions);
+  GpuProfileAdd(GpuProfileCount::kSubmissionsThreaded);
+  // Constants, uploads and descriptors of the submission were written through
+  // write-combined mappings: make them globally visible before another thread
+  // executes the command list (the mutex's locked instructions do too).
+  xe::swcache::WriteFence();
+  {
+    std::lock_guard<std::mutex> lock(submission_thread_mutex_);
+    ++submission_thread_jobs_enqueued_;
+  }
+  submission_thread_job_condition_.notify_one();
+}
+
+void D3D12CommandProcessor::AwaitSubmissionThreadJobs(uint64_t jobs_done,
+                                                      bool is_swap) {
+  if (!submission_thread_.joinable()) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(submission_thread_mutex_);
+  if (submission_thread_jobs_done_ >= jobs_done) {
+    return;
+  }
+  ScopedGpuThreadTicks wait_ticks(gpu_thread_stats().submission_wait_ticks);
+  GpuProfileZone profile_zone(GpuProfileBucket::kSubmissionWait);
+  GpuProfileAdd(GpuProfileCount::kSubmissionWaits);
+  const uint64_t wait_start = gpu_thread_profiler ? GpuProfileTicks() : 0;
+  submission_thread_done_condition_.wait(lock, [this, jobs_done]() {
+    return submission_thread_jobs_done_ >= jobs_done;
+  });
+  if (is_swap && gpu_thread_profiler) {
+    GpuProfileAdd(GpuProfileCount::kSubmissionSwapWaitTicks,
+                  GpuProfileTicks() - wait_start);
+  }
+}
+
+void D3D12CommandProcessor::SubmissionThread(ID3D12CommandQueue* direct_queue,
+                                             ID3D12Fence* fence) {
+  xe::threading::set_name("GPU Submission");
+#if XE_PLATFORM_WIN32
+  // Above the GPU emulation thread and the guest threads (normal priority),
+  // like the present thread: the GPU emulation thread waits for this one at
+  // every guest swap and shouldn't also wait for it to be scheduled.
+  SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+#endif  // XE_PLATFORM_WIN32
+  std::unique_lock<std::mutex> lock(submission_thread_mutex_);
+  while (true) {
+    submission_thread_job_condition_.wait(lock, [this]() {
+      return submission_thread_jobs_done_ < submission_thread_jobs_enqueued_ ||
+             submission_thread_shutdown_;
+    });
+    if (submission_thread_jobs_done_ >= submission_thread_jobs_enqueued_) {
+      // Shutting down with every handed-off number signaled (one that isn't
+      // would be awaited forever).
+      break;
+    }
+    SubmissionThreadJob& job = submission_thread_jobs_[size_t(
+        submission_thread_jobs_done_ % kSubmissionThreadJobSlots)];
+    lock.unlock();
+    ExecuteSubmissionThreadJob(job, direct_queue, fence);
+    lock.lock();
+    ++submission_thread_jobs_done_;
+    submission_thread_done_condition_.notify_all();
+  }
+}
+
+void D3D12CommandProcessor::ExecuteSubmissionThreadJob(
+    SubmissionThreadJob& job, ID3D12CommandQueue* direct_queue,
+    ID3D12Fence* fence) {
+  ScopedGpuThreadTicks busy_ticks(gpu_thread_stats().submission_thread_ticks);
+  // gpu_thread_profiler is the GPU thread's: add to the shared counts.
+  GpuThreadProfile& profile = gpu_thread_profile();
+  const bool profiling = profile.enabled.load(std::memory_order_relaxed);
+  const uint64_t replay_start = profiling ? GpuProfileTicks() : 0;
+  job.command_allocator->Reset();
+  command_list_->Reset(job.command_allocator, nullptr);
+  const uint32_t replayed_commands = job.commands->Execute(
+      command_list_, command_list_1_, command_list_2_);
+  const uint64_t execute_start = profiling ? GpuProfileTicks() : 0;
+  command_list_->Close();
+  ID3D12CommandList* execute_command_lists[] = {command_list_};
+  direct_queue->ExecuteCommandLists(1, execute_command_lists);
+  if (profiling) {
+    const uint64_t execute_end = GpuProfileTicks();
+    profile.counts[size_t(GpuProfileCount::kReplayTicks)].fetch_add(
+        execute_start - replay_start, std::memory_order_relaxed);
+    profile.counts[size_t(GpuProfileCount::kReplayCommands)].fetch_add(
+        replayed_commands, std::memory_order_relaxed);
+    profile.counts[size_t(GpuProfileCount::kExecuteTicks)].fetch_add(
+        execute_end - execute_start, std::memory_order_relaxed);
+  }
+  // The last use of the job: once the fence reaches the value, the GPU thread
+  // may reuse or release the allocator and everything the commands reference.
+  const HRESULT signal_result = direct_queue->Signal(fence, job.fence_value);
+  if (FAILED(signal_result)) {
+    XELOGE(
+        "Failed to signal a Direct3D 12 fence for submission {}, result "
+        "0x{:08X}",
+        job.fence_value, uint32_t(signal_result));
+    // Unlike SignalAndAdvance, the number has been given out already and may
+    // be awaited, so it can't be skipped.
+    graphics_system_->OnHostGpuLossFromAnyThread(signal_result !=
+                                                 DXGI_ERROR_DEVICE_REMOVED);
+  }
+}
+
+void D3D12CommandProcessor::ShutdownSubmissionThread() {
+  if (submission_thread_.joinable()) {
+    {
+      std::lock_guard<std::mutex> lock(submission_thread_mutex_);
+      submission_thread_shutdown_ = true;
+    }
+    submission_thread_job_condition_.notify_all();
+    // Executes and signals whatever is still handed off first.
+    submission_thread_.join();
+    submission_thread_shutdown_ = false;
+  }
+  for (SubmissionThreadJob& job : submission_thread_jobs_) {
+    job.commands.reset();
+    job.command_allocator = nullptr;
+    job.fence_value = 0;
+  }
+  submission_thread_jobs_enqueued_ = 0;
+  submission_thread_jobs_done_ = 0;
+}
+
+void D3D12CommandProcessor::ReleaseResourceAfterSubmissions(
+    ID3D12Resource* resource) {
+  // Also without the submission thread: the GPU may still be copying to it
+  // from an earlier submission (readback_resolve = "fast" doesn't wait).
+  resources_for_deletion_.emplace_back(GetCurrentSubmission(), resource);
+}
