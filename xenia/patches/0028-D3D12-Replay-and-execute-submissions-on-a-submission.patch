   ID3D12GraphicsCommandList2* command_list_2_ = nullptr;
   DeferredCommandList deferred_command_list_;
 
+  // d3d12_submission_thread: replaying, closing, executing and signaling
+  // submissions on a dedicated host thread, in order, one ExecuteCommandLists
+  // and one Signal each. While submissions are handed to it, only that thread
+  // uses command_list_ (_1_, _2_) and signals completion_timeline_'s fence;
+  // the numbering (GetCurrentSubmission) and everything else stay here.
+  static constexpr uint32_t kSubmissionThreadJobSlots = 2;
+  struct SubmissionThreadJob {
