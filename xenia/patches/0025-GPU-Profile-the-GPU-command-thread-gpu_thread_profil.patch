+// Profile of the GPU command thread (gpu_thread_profile): where its time
+// goes, in exclusive buckets that together cover all of it, and counts of
+// the work behind them. The command thread keeps them in plain variables
+// (GpuThreadProfiler, reached through gpu_thread_profiler, which is null on
+// every other thread and while profiling is off) and adds them to the shared
+// atomics below once per swap.
+enum class GpuProfileBucket : uint32_t {
+  kIdle,             // waiting for commands
+  kStream,           // packets, register and constant writes, small packets
+  kShaderLoads,      // IM_LOAD(_IMMEDIATE): hashing and looking up shaders
+  kSync,             // WAIT_REG_MEM waits, host GPU waits, guest interrupts
+  kDrawSetup,        // the rest of a draw, recording it included
+  kPrimitives,       // primitive processing (index conversion and caching)
+  kRenderTargets,    // render target cache updates (and transfers)
+  kPipeline,         // shader translations and pipeline lookup / creation
+  kTextures,         // texture cache: bindings, lookups, loads
+  kSystemConstants,  // system constant updates
+  kBindings,         // root signature, constant buffers, descriptors
+  kSharedMemory,     // vertex and memexport ranges, uploads from any caller
+  kResolves,         // EDRAM resolves
+  kSubmission,       // beginning and ending submissions (replay, execute)
+  kPresent,          // the swap, minus what it submits
+  kCount,
+};
+
+enum class GpuProfileCount : uint32_t {
+  kPrimaryBuffers,
+  kPackets,
+  kShaderLoads,
+  kInterrupts,
+  kDrawsEntered,    // draws (not resolves) IssueDraw was called for
+  kDrawsRecorded,   // and recorded
+  kDrawsNotReady,   // skipped while a pipeline was being created
+  kPipelinesSame,   // pipeline lookups: the current one again,
+  kPipelinesFound,  // found in the cache,
+  kPipelinesNew,    // created
+  kRootSignatures,  // root signature changes
+  kSubmissions,     // submissions ended
+  kReplayTicks,     // of them, replaying the deferred command list
+  kReplayCommands,  // deferred commands replayed
+  kExecuteTicks,    // closing, executing and signalling
+  kUploadRanges,    // shared memory upload ranges
+  kUploadBytes,
+  kTextureLoads,
+  kTextureLoadBytes,
+  kRenderTargetTransfers,
+  kResolves,
+  kCount,
+};
+
+constexpr size_t kGpuProfileBucketCount = size_t(GpuProfileBucket::kCount);
+constexpr size_t kGpuProfileCountCount = size_t(GpuProfileCount::kCount);
+
+// The profiler's clock: the time stamp counter where available (a read costs
+// about 10 ns, against 20-30 ns and a 100 ns resolution for the performance
+// counter), so the reader works out its frequency against the host clock.
+inline uint64_t GpuProfileTicks() {
+#if XE_ARCH_AMD64
+  return __rdtsc();
+#else
+  return Clock::QueryHostTickCount();
+#endif
+}
+
+struct GpuThreadProfile {
+  // Set while the command thread profiles.
+  std::atomic<bool> enabled{false};
+  // What switching buckets costs, measured when profiling starts, to take
+  // out of each entered bucket's time.
+  std::atomic<uint64_t> lap_cost_ticks{0};
+  std::atomic<uint64_t> ticks[kGpuProfileBucketCount] = {};
+  std::atomic<uint64_t> entries[kGpuProfileBucketCount] = {};
+  std::atomic<uint64_t> counts[kGpuProfileCountCount] = {};
+};
+
+inline GpuThreadProfile& gpu_thread_profile() {
+  static GpuThreadProfile profile;
+  return profile;
+}
+
+class GpuThreadProfiler {
+ public:
+  GpuThreadProfiler() : last_(GpuProfileTicks()) {}
+
+  GpuProfileBucket current() const { return current_; }
+  // Ends the current bucket's time and starts the next's.
+  void Lap(GpuProfileBucket next) {
+    const uint64_t now = GpuProfileTicks();
+    ticks_[size_t(current_)] += now - last_;
+    last_ = now;
+    current_ = next;
+    ++entries_[size_t(next)];
+  }
+  void Count(GpuProfileCount count, uint64_t amount = 1) {
+    counts_[size_t(count)] += amount;
+  }
+
+  // Measures a lap and publishes the cost.
+  void Calibrate() {
+    GpuThreadProfiler scratch;
+    constexpr uint32_t kLaps = 4096;
+    const uint64_t start = GpuProfileTicks();
+    for (uint32_t i = 0; i < kLaps; ++i) {
+      scratch.Lap(GpuProfileBucket(i & 1));
+    }
+    gpu_thread_profile().lap_cost_ticks.store(
+        (GpuProfileTicks() - start) / kLaps, std::memory_order_relaxed);
+  }
+
+  // Adds everything so far to the shared profile.
+  void Publish() {
+    const uint64_t now = GpuProfileTicks();
+    ticks_[size_t(current_)] += now - last_;
+    last_ = now;
+    GpuThreadProfile& profile = gpu_thread_profile();
+    for (size_t i = 0; i < kGpuProfileBucketCount; ++i) {
+      profile.ticks[i].fetch_add(ticks_[i], std::memory_order_relaxed);
+      profile.entries[i].fetch_add(entries_[i], std::memory_order_relaxed);
+      ticks_[i] = 0;
+      entries_[i] = 0;
+    }
+    for (size_t i = 0; i < kGpuProfileCountCount; ++i) {
+      profile.counts[i].fetch_add(counts_[i], std::memory_order_relaxed);
+      counts_[i] = 0;
+    }
+  }
+
+ private:
+  uint64_t last_;
+  GpuProfileBucket current_ = GpuProfileBucket::kStream;
+  uint64_t ticks_[kGpuProfileBucketCount] = {};
+  uint64_t entries_[kGpuProfileBucketCount] = {};
+  uint64_t counts_[kGpuProfileCountCount] = {};
+};
+
+// The command thread's profiler while it profiles, null otherwise and on
+// other threads (which may run some of the same code).
+inline thread_local GpuThreadProfiler* gpu_thread_profiler = nullptr;
+
+inline void GpuProfileLap(GpuProfileBucket bucket) {
+  if (GpuThreadProfiler* profiler = gpu_thread_profiler) {
+    profiler->Lap(bucket);
+  }
+}
+
+inline void GpuProfileAdd(GpuProfileCount count, uint64_t amount = 1) {
+  if (GpuThreadProfiler* profiler = gpu_thread_profiler) {
+    profiler->Count(count, amount);
+  }
+}
+
+// Times its scope into a bucket, then returns to the one it interrupted.
+class GpuProfileZone {
+ public:
+  explicit GpuProfileZone(GpuProfileBucket bucket)
+      : profiler_(gpu_thread_profiler) {
+    if (profiler_) {
+      interrupted_ = profiler_->current();
+      profiler_->Lap(bucket);
+    }
+  }
+  ~GpuProfileZone() {
+    if (profiler_) {
+      profiler_->Lap(interrupted_);
+    }
+  }
+  GpuProfileZone(const GpuProfileZone&) = delete;
+  GpuProfileZone& operator=(const GpuProfileZone&) = delete;
+
+ private:
+  GpuThreadProfiler* profiler_;
+  GpuProfileBucket interrupted_ = GpuProfileBucket::kStream;
+};
+
 }  // namespace gpu
 }  // namespace xe
 
