+// gpu_thread_profile: the GPU command thread's time by kind, per frame and
+// per draw, and the work behind it. swaps = the frames in the interval.
+void LogGpuProfile(double seconds, uint32_t swaps) {
+  using gpu::GpuProfileBucket;
+  using gpu::GpuProfileCount;
+  gpu::GpuThreadProfile& p = gpu::gpu_thread_profile();
+  // The profiler's clock (the time stamp counter) against the host clock.
+  static uint64_t last_profile_ticks = 0;
+  const uint64_t profile_ticks = gpu::GpuProfileTicks();
+  const double tick_frequency =
+      double(profile_ticks - last_profile_ticks) / seconds;
+  const bool clock_known = last_profile_ticks != 0;
+  last_profile_ticks = profile_ticks;
+  // Each entry into a bucket carries about one lap of the profiler's own
+  // time: take it out.
+  const uint64_t lap_cost = p.lap_cost_ticks.load(std::memory_order_relaxed);
+  double ticks[gpu::kGpuProfileBucketCount];
+  uint64_t entries = 0;
+  for (size_t i = 0; i < gpu::kGpuProfileBucketCount; ++i) {
+    const uint64_t bucket_entries = p.entries[i].exchange(0);
+    const uint64_t cost = bucket_entries * lap_cost;
+    const uint64_t bucket_ticks = p.ticks[i].exchange(0);
+    ticks[i] = double(bucket_ticks > cost ? bucket_ticks - cost : 0);
+    entries += bucket_entries;
+  }
+  double counts[gpu::kGpuProfileCountCount];
+  for (size_t i = 0; i < gpu::kGpuProfileCountCount; ++i) {
+    counts[i] = double(p.counts[i].exchange(0));
+  }
+  if (!p.enabled.load(std::memory_order_relaxed) || !clock_known || !swaps ||
+      tick_frequency <= 0.0) {
+    return;
+  }
+  const double frames = double(swaps);
+  const auto count = [&](GpuProfileCount c) {
+    return counts[size_t(c)] / frames;
+  };
+  // Milliseconds per frame.
+  const auto ms = [&](double bucket_ticks) {
+    return bucket_ticks * 1000.0 / tick_frequency / frames;
+  };
+  const auto bucket = [&](GpuProfileBucket b) { return ticks[size_t(b)]; };
+  const GpuProfileBucket draw_buckets[] = {
+      GpuProfileBucket::kDrawSetup,     GpuProfileBucket::kPrimitives,
+      GpuProfileBucket::kRenderTargets, GpuProfileBucket::kPipeline,
+      GpuProfileBucket::kTextures,      GpuProfileBucket::kSystemConstants,
+      GpuProfileBucket::kBindings,      GpuProfileBucket::kSharedMemory};
+  double draw_ticks = 0.0;
+  for (GpuProfileBucket b : draw_buckets) {
+    draw_ticks += bucket(b);
+  }
+  double busy_ticks = 0.0;
+  for (size_t i = 0; i < gpu::kGpuProfileBucketCount; ++i) {
+    if (i != size_t(GpuProfileBucket::kIdle)) {
+      busy_ticks += ticks[i];
+    }
+  }
+  // Microseconds per draw entered.
+  const double draws = counts[size_t(GpuProfileCount::kDrawsEntered)];
+  const auto us_per_draw = [&](GpuProfileBucket b) {
+    return draws ? bucket(b) * 1000000.0 / tick_frequency / draws : 0.0;
+  };
+  const double submissions = counts[size_t(GpuProfileCount::kSubmissions)];
+  XELOGI(
+      "Halo 3 GPU profile: {:.0f} draws/frame ({:.0f} recorded, {:.1f} "
+      "waiting for a pipeline), {:.1f} resolves; ms/frame: busy {:.2f} = "
+      "stream {:.2f} ({:.0f} packets in {:.1f} buffers), shader loads {:.2f} "
+      "({:.0f}), sync {:.2f} ({:.1f} interrupts), draws {:.2f}, resolves "
+      "{:.2f}, submissions {:.2f} ({:.1f}; replaying {:.2f} for {:.0f} "
+      "commands, executing {:.2f}), present {:.2f}; idle {:.2f}; us/draw: "
+      "setup {:.2f}, primitives {:.2f}, render targets {:.2f}, pipeline "
+      "{:.2f}, textures {:.2f}, system constants {:.2f}, bindings {:.2f}, "
+      "shared memory {:.2f}; per frame: pipelines {:.0f} same, {:.1f} found, "
+      "{:.2f} new, {:.1f} root signatures, {:.1f} uploads {:.0f} KB, {:.1f} "
+      "texture loads {:.0f} KB, {:.1f} render target transfers; profiler "
+      "{:.1f} ns a lap, {:.1f}% of the time (taken out)",
+      count(GpuProfileCount::kDrawsEntered),
+      count(GpuProfileCount::kDrawsRecorded),
+      count(GpuProfileCount::kDrawsNotReady), count(GpuProfileCount::kResolves),
+      ms(busy_ticks), ms(bucket(GpuProfileBucket::kStream)),
+      count(GpuProfileCount::kPackets), count(GpuProfileCount::kPrimaryBuffers),
+      ms(bucket(GpuProfileBucket::kShaderLoads)),
+      count(GpuProfileCount::kShaderLoads), ms(bucket(GpuProfileBucket::kSync)),
+      count(GpuProfileCount::kInterrupts), ms(draw_ticks),
+      ms(bucket(GpuProfileBucket::kResolves)),
+      ms(bucket(GpuProfileBucket::kSubmission)), submissions / frames,
+      ms(counts[size_t(GpuProfileCount::kReplayTicks)]),
+      count(GpuProfileCount::kReplayCommands),
+      ms(counts[size_t(GpuProfileCount::kExecuteTicks)]),
+      ms(bucket(GpuProfileBucket::kPresent)),
+      ms(bucket(GpuProfileBucket::kIdle)),
+      us_per_draw(GpuProfileBucket::kDrawSetup),
+      us_per_draw(GpuProfileBucket::kPrimitives),
+      us_per_draw(GpuProfileBucket::kRenderTargets),
+      us_per_draw(GpuProfileBucket::kPipeline),
+      us_per_draw(GpuProfileBucket::kTextures),
+      us_per_draw(GpuProfileBucket::kSystemConstants),
+      us_per_draw(GpuProfileBucket::kBindings),
+      us_per_draw(GpuProfileBucket::kSharedMemory),
+      count(GpuProfileCount::kPipelinesSame),
+      count(GpuProfileCount::kPipelinesFound),
+      count(GpuProfileCount::kPipelinesNew),
+      count(GpuProfileCount::kRootSignatures),
