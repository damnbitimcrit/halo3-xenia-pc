+DEFINE_bool(gpu_thread_profile, false,
+            "Time the GPU command thread's work by kind (stream, draws by "
+            "stage, resolves, submissions, swaps) and count the work behind "
+            "it, for titles that log performance statistics. Costs about 5% "
+            "of the thread's time. Checked at every swap.",
+            "GPU");
+
 DEFINE_uint32(readback_resolve_small_bytes, 16384,
               "Largest resolve destination, in bytes, that readback_resolve = "
               "\"small\" reads back. A resolve within one 32x32 tile takes "
@@ -381,6 +388,7 @@ void CommandProcessor::WorkerThreadMain() {
       // We spin here waiting for new ones, as the overhead of waiting on our
       // event is too high.
       const uint64_t idle_start = Clock::QueryHostTickCount();
+      GpuProfileLap(GpuProfileBucket::kIdle);
       PrepareForWait();
       uint32_t loop_count = 0;
       do {
@@ -403,6 +411,7 @@ void CommandProcessor::WorkerThreadMain() {
                (write_ptr_index == 0xBAADF00D ||
                 read_ptr_index_ == write_ptr_index));
       ReturnFromWait();
+      GpuProfileLap(GpuProfileBucket::kStream);
       gpu_thread_stats().idle_ticks.fetch_add(
           Clock::QueryHostTickCount() - idle_start, std::memory_order_relaxed);
       if (!worker_running_ || !pending_fns_.empty()) {
@@ -430,9 +439,32 @@ void CommandProcessor::WorkerThreadMain() {
     // but no games seem to actually use it.
   }
 
+  if (thread_profiler_) {
+    gpu_thread_profiler = nullptr;
+    thread_profiler_.reset();
+    gpu_thread_profile().enabled.store(false, std::memory_order_relaxed);
+  }
   ShutdownContext();
 }
 
+void CommandProcessor::UpdateThreadProfiler() {
+  if (cvars::gpu_thread_profile == bool(thread_profiler_)) {
+    return;
+  }
+  GpuThreadProfile& profile = gpu_thread_profile();
+  if (thread_profiler_) {
+    thread_profiler_->Publish();
+    gpu_thread_profiler = nullptr;
+    thread_profiler_.reset();
+    profile.enabled.store(false, std::memory_order_relaxed);
+    return;
+  }
+  thread_profiler_ = std::make_unique<GpuThreadProfiler>();
+  thread_profiler_->Calibrate();
+  gpu_thread_profiler = thread_profiler_.get();
+  profile.enabled.store(true, std::memory_order_relaxed);
+}
