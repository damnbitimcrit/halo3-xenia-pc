+// The frame queue (see the top of the file). The mode word is 1 while the
+// render thread draws and 0 while the main thread does (never 2 here).
+constexpr uint32_t kRenderModeWord = 0x82948F68;
+constexpr uint32_t kQueue = 0x8294CA9C;
+constexpr uint32_t kQueueSlotState = kQueue + 0x0C;  // + kQueueSlotStride * i
+constexpr uint32_t kQueueSlotStride = 0x10;
+constexpr uint32_t kQueueWriteIndex = kQueue + 0x48;  // wr, ++ by a take
+constexpr uint32_t kQueueReadIndex = kQueue + 0x4C;   // rd, ++ by a release
+constexpr uint32_t kQueueSlotCount = kQueue + 0x6C;   // n, 2 once set up
+constexpr uint32_t kMaxQueueSlots = 4;
+// Render thread (sub_821A8500) in mode 1. `bl sub_82080608` starting each
+// round of waiting for a frame (66 ms each), reached only by falling through
+// the loop storing 82948F6C = 1.
+constexpr uint32_t kRenderPollStart = 0x821A8588;
+// The poll loop, before it re-reads rd; reached only by falling through the
+// `bge` at 821A85CC (the round's time not up).
+constexpr uint32_t kRenderPollLoop = 0x821A85D0;
+// The return of the take (`bl sub_821D5A08` at 821A8668): r3 = the frame, or
+// 0 if there was none.
+constexpr uint32_t kRenderTakeReturn = 0x821A866C;
+// The mode word, in r11, isn't 1; reached only by the `bne` at 821A8564. In
+// mode 0 the thread loops back here without a call.
+constexpr uint32_t kRenderModeNotOne = 0x821A8730;
+// Main thread. sub_82080278 after its publish (`bl sub_821D5888` at
+// 820802C8): the low byte of r3 is whether it published.
+constexpr uint32_t kPublishReturn = 0x820802CC;
+// Publish (sub_821D5888) found its slot still holding a frame nobody took
+// (the `beq` at 821D5900 not taken) and overwrites it.
+constexpr uint32_t kPublishOverwrite = 0x821D5904;
+
+// Pacing stops once the render thread takes longer than this per frame, where
+// each wait would add more latency than late start can win back, and resumes
+// below the second; the gap keeps it from toggling on every frame.
+constexpr uint64_t kMaxPacedRenderMs = 30;
+constexpr uint64_t kResumePacedRenderMs = 24;
+// The wait for a take times out after twice the longest recent render time
+// plus this, clamped to the bounds below.
+constexpr uint64_t kTakeTimeoutExtraMs = 4;
+constexpr uint64_t kTakeTimeoutMinMs = 10;
+constexpr uint64_t kTakeTimeoutMaxMs = 64;
+// Timeouts in a row with no take in between before pacing stops until the
+// render thread takes a frame again.
+constexpr uint32_t kTimeoutsBeforeBypass = 2;
+// Render and main work times are tracked over this many frames.
+constexpr uint32_t kTimingFrames = 8;
+
 // Only the game's main thread runs main_time_update.
 struct FramePacer {
   uint64_t last_ticks = 0;
-  uint64_t deadline = 0;
+  uint64_t deadline = 0;  // host ticks
 };
 FramePacer pacer;
 
@@ -87,6 +188,171 @@ FramePacer pacer;
 thread_local float frame_delta_seconds = 0.0f;
 thread_local uint64_t last_present_ticks = 0;
 
+bool LogStatsOn() { return cvars::halo3_log_stats; }
+
+uint64_t TicksToUs(uint64_t ticks, uint64_t frequency) {
+  return uint64_t(double(ticks) * 1000000.0 / double(frequency));
+}
+int64_t TicksToNs(uint64_t ticks, uint64_t frequency) {
+  return int64_t(double(ticks) * 1000000000.0 / double(frequency));
+}
+
+uint32_t Guest32(const cpu::ppc::PPCContext* ctx, uint32_t address) {
+  return *ctx->TranslateVirtualBE<uint32_t>(address);
+}
+
+bool RenderThreadDraws(const cpu::ppc::PPCContext* ctx) {
+  return Guest32(ctx, kRenderModeWord) == 1;
+}
+
+// The state word of the slot at a queue index (wr or rd), non-zero while the
+// slot holds a frame; nullopt before the queue is set up.
+std::optional<uint32_t> SlotState(const cpu::ppc::PPCContext* ctx,
+                                  uint32_t index_address) {
+  const uint32_t count = Guest32(ctx, kQueueSlotCount);
+  if (!count || count > kMaxQueueSlots) {
+    return std::nullopt;
+  }
+  const uint32_t slot = Guest32(ctx, index_address) % count;
+  return Guest32(ctx, kQueueSlotState + slot * kQueueSlotStride);
+}
+
+// The frame the main thread published last hasn't been taken yet. Read
+// without the queue's locks: the take clears the state before wr++, so an old
+// wr shows the old slot (1, or 0 once taken) and a new one a slot released
+// earlier (0); the waiting main thread is the only publisher.
+bool PublishedFramePending(const cpu::ppc::PPCContext* ctx) {
+  const std::optional<uint32_t> state = SlotState(ctx, kQueueWriteIndex);
+  return state && *state;
+}
+
+// Set by the render thread's takes (for the main thread's wait) and by the
+// main thread's publishes (for the render thread's). Never destroyed: guest
+// threads may still run hooks while the process exits.
+threading::Event* take_event = nullptr;
+threading::Event* publish_event = nullptr;
+
+void WaitForEvent(threading::Event* event, uint64_t milliseconds) {
+  if (event) {
+    threading::Wait(event, false, std::chrono::milliseconds(milliseconds));
+  } else {
+    threading::NanoSleep(250000);
+  }
+}
+
+// The render thread's timing, measured by its hooks.
+struct RenderTiming {
+  // Read by the main thread.
+  std::atomic<uint32_t> takes{0};
+  std::atomic<uint64_t> last_take{0};  // host ticks
+  // The shortest and longest of the last kTimingFrames times from a take to
+  // the next wait for a frame; 0 until there are that many.
+  std::atomic<uint64_t> busy_low{0};
+  std::atomic<uint64_t> busy_high{0};
+  // Takes after waiting more than 0.5 ms for a frame.
+  std::atomic<uint32_t> starved{0};
+  // Render thread only.
+  uint64_t take_ticks = 0;   // the last take, 0 after a mode 0 stretch
+  uint64_t ready_ticks = 0;  // the start of the current wait for a frame
+  bool waiting = false;
+  uint64_t busy[kTimingFrames] = {};
+  uint32_t busy_count = 0;
+};
+RenderTiming render;
+
+// The main thread's pacing state.
+struct MainPacing {
+  uint64_t build_start = 0;  // host ticks; 0 if the last pass didn't count
+  uint64_t work[kTimingFrames] = {};
+  uint32_t work_count = 0;
+  uint64_t work_high = 0;  // the longest of the last kTimingFrames passes
+  bool too_slow = false;   // the render thread draws too slowly to pace
+  uint32_t takes_at_timeout = 0;
+  uint32_t timeouts_without_take = 0;
+  bool bypass = false;
+  uint32_t takes_at_bypass = 0;
+  uint64_t margin = 0;  // late start: how early the frame should be ready
+  uint32_t starved_seen = 0;
+  bool late_start_last = false;  // the previous pass started late
+};
+MainPacing pacing;
+
+// Sleeps the calling thread for about ns nanoseconds.
+#if XE_PLATFORM_WIN32
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+void HostSleepNs(int64_t ns) {
+  // A high-resolution waitable timer (Windows 10 1803 and later) wakes up
+  // within a fraction of a millisecond; otherwise fall back to NanoSleep.
+  struct Timer {
+    HANDLE handle = nullptr;
+    bool tried = false;
+    ~Timer() {
+      if (handle) {
+        CloseHandle(handle);
+      }
+    }
+  };
+  thread_local Timer timer;
+  if (!timer.tried) {
+    timer.tried = true;
+    timer.handle = CreateWaitableTimerExW(nullptr, nullptr,
+                                          CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                          TIMER_ALL_ACCESS);
+  }
+  LARGE_INTEGER due;
+  due.QuadPart = -std::max<int64_t>(ns / 100, 1);
+  if (!timer.handle ||
+      !SetWaitableTimer(timer.handle, &due, 0, nullptr, nullptr, FALSE)) {
+    threading::NanoSleep(ns);
+    return;
+  }
+  WaitForSingleObject(timer.handle, INFINITE);
+}
+#else
+void HostSleepNs(int64_t ns) { threading::NanoSleep(ns); }
+#endif
+
+// Sleeps until the host tick count reaches target, busy-waiting for at most
+// the last halo3_pacer_spin_us. Returns the time spent spinning in ticks.
+uint64_t SleepUntil(uint64_t target, uint64_t frequency) {
+  // How late a sleep tends to wake up: rises at once, decays slowly.
+  thread_local int64_t oversleep_ns = 500000;
+  const int64_t spin_ns =
+      int64_t(std::clamp<int32_t>(cvars::halo3_pacer_spin_us, 0, 2000)) * 1000;
+  for (;;) {
+    const uint64_t now = Clock::QueryHostTickCount();
+    if (now >= target) {
+      return 0;
+    }
+    const int64_t request =
+        TicksToNs(target - now, frequency) - std::min(spin_ns, oversleep_ns);
+    if (request >= 50000) {
+      HostSleepNs(request);
+      const int64_t over = std::max<int64_t>(
+          TicksToNs(Clock::QueryHostTickCount() - now, frequency) - request, 0);
+      oversleep_ns = over > oversleep_ns
+                         ? over
+                         : oversleep_ns - (oversleep_ns - over) / 16;
+      if (!spin_ns) {
+        return 0;
+      }
+      continue;
+    }
+    if (!spin_ns) {
+      return 0;
+    }
+    // The tail, with no system calls and no guest clock lock.
+    while (Clock::QueryHostTickCount() < target) {
+#if XE_ARCH_AMD64
+      _mm_pause();
+#endif
+    }
+    return Clock::QueryHostTickCount() - now;
+  }
+}
