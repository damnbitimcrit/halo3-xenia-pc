+// Render thread: the start of each round of waiting for a frame.
+void OnRenderPollStart(cpu::ppc::PPCContext*, void*) {
+  if (render.waiting) {
+    // Another round of the same wait.
+    return;
+  }
+  const uint64_t now = Clock::QueryHostTickCount();
+  render.ready_ticks = now;
+  render.waiting = true;
+  if (!render.take_ticks) {
+    return;
+  }
+  const uint64_t busy = now - render.take_ticks;
+  render.busy[render.busy_count++ % kTimingFrames] = busy;
+  if (render.busy_count >= kTimingFrames) {
+    uint64_t low = busy;
+    uint64_t high = busy;
+    for (uint64_t sample : render.busy) {
+      low = std::min(low, sample);
+      high = std::max(high, sample);
+    }
+    render.busy_low.store(low, std::memory_order_release);
+    render.busy_high.store(high, std::memory_order_release);
+  }
+  const uint64_t frequency = Clock::QueryHostTickFrequency();
+  if (LogStatsOn() && busy < frequency / 10) {
+    Stats& s = stats();
+    s.render_busy_frames.fetch_add(1, std::memory_order_relaxed);
+    s.render_busy_us.fetch_add(TicksToUs(busy, frequency),
+                               std::memory_order_relaxed);
+  }
+}
+
+// Render thread: the poll loop found no frame on its first look.
+void OnRenderPollLoop(cpu::ppc::PPCContext* ctx, void*) {
+  if (!cvars::halo3_render_thread_sleep) {
+    return;
+  }
+  // Reset, then test, so a publish between the two still ends the wait.
+  if (publish_event) {
+    publish_event->Reset();
+  }
+  const std::optional<uint32_t> state = SlotState(ctx, kQueueReadIndex);
+  if (!state || *state) {
+    return;
+  }
+  // The guest's own 66 ms limit keeps working: its tick count advances
+  // every millisecond.
+  WaitForEvent(publish_event, 1);
+}
+
+// Render thread: the return of the take.
+void OnRenderTakeReturn(cpu::ppc::PPCContext* ctx, void*) {
+  if (!static_cast<uint32_t>(ctx->r[3])) {
+    return;
+  }
+  const uint64_t now = Clock::QueryHostTickCount();
+  const uint64_t frequency = Clock::QueryHostTickFrequency();
+  const bool log_stats = LogStatsOn();
+  Stats& s = stats();
+  if (render.waiting) {
+    const uint64_t idle = now - render.ready_ticks;
+    if (idle > frequency / 2000) {
+      render.starved.fetch_add(1, std::memory_order_release);
+      if (log_stats) {
+        s.render_starved.fetch_add(1, std::memory_order_relaxed);
+      }
+    }
+    if (log_stats && idle < frequency / 10) {
+      s.render_idle_us.fetch_add(TicksToUs(idle, frequency),
+                                 std::memory_order_relaxed);
+    }
+    render.waiting = false;
+  }
+  render.take_ticks = now;
+  render.last_take.store(now, std::memory_order_release);
+  render.takes.fetch_add(1, std::memory_order_release);
+  if (log_stats) {
+    s.render_takes.fetch_add(1, std::memory_order_relaxed);
+  }
+  if (take_event) {
+    take_event->Set();
+  }
+}
