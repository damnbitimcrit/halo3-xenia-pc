+// Right after a take: delays this pass so its frame is ready a margin before
+// the render thread finishes the frame it just took.
+void LateStart(uint64_t frequency) {
+  const uint64_t busy = render.busy_low.load(std::memory_order_acquire);
+  if (!busy || pacing.work_count < kTimingFrames) {
+    return;
+  }
+  const uint64_t min_margin = frequency / 1000;  // 1 ms
+  const uint64_t step = frequency / 1000;        // 1 ms
+  const uint64_t decay = frequency / 50000;      // 20 us
+  if (!pacing.margin) {
+    pacing.margin = 2 * min_margin;
+  }
+  const uint32_t starved = render.starved.load(std::memory_order_acquire);
+  if (pacing.late_start_last && starved != pacing.starved_seen) {
+    // The render thread waited for our late frame: back off quickly.
+    pacing.margin = std::min(pacing.margin + step, busy);
+  } else if (pacing.margin > min_margin + decay) {
+    pacing.margin -= decay;
+  }
+  pacing.starved_seen = starved;
+  pacing.late_start_last = false;
+  Stats& s = stats();
+  if (LogStatsOn()) {
+    s.late_start_margin_us.store(uint32_t(TicksToUs(pacing.margin, frequency)),
+                                 std::memory_order_relaxed);
+  }
+  const int64_t lead =
+      int64_t(busy) - int64_t(pacing.work_high) - int64_t(pacing.margin);
+  if (lead <= 0) {
+    return;
+  }
+  const uint64_t target =
+      render.last_take.load(std::memory_order_acquire) + uint64_t(lead);
+  const uint64_t now = Clock::QueryHostTickCount();
+  if (target <= now + frequency * 3 / 10000) {
+    // Under 0.3 ms: not worth a sleep.
+    return;
+  }
+  SleepUntil(target, frequency);
+  pacing.late_start_last = true;
+  if (LogStatsOn()) {
+    s.late_starts.fetch_add(1, std::memory_order_relaxed);
+    s.late_start_us.fetch_add(
+        TicksToUs(Clock::QueryHostTickCount() - now, frequency),
+        std::memory_order_relaxed);
+  }
+}
