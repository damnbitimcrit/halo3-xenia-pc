+// Render thread: the mode word isn't 1. In mode 0 the main thread draws, and
+// this thread spins until the mode is 1 again.
+void OnRenderModeNotOne(cpu::ppc::PPCContext* ctx, void*) {
+  // Don't count the stretch as drawing or waiting time.
+  render.waiting = false;
+  render.take_ticks = 0;
+  if (cvars::halo3_render_thread_sleep && !static_cast<uint32_t>(ctx->r[11])) {
+    threading::NanoSleep(1000000);
+  }
+}
+
+// Main thread: sub_82080278's publish returned.
+void OnPublishReturn(cpu::ppc::PPCContext* ctx, void*) {
+  if ((ctx->r[3] & 0xFF) && publish_event) {
+    publish_event->Set();
+  }
+}
+
+// Main thread: a published frame is overwritten before it was taken.
+void OnPublishOverwrite(cpu::ppc::PPCContext*, void*) {
+  if (LogStatsOn()) {
+    stats().frames_overwritten.fetch_add(1, std::memory_order_relaxed);
+  }
+}
