+// Waits for the render thread to take the frame published last. Returns
+// whether it waited for a take that happened.
+bool WaitForRenderTake(cpu::ppc::PPCContext* ctx, uint64_t frequency) {
+  if (!cvars::halo3_pace_to_render) {
+    pacing.bypass = false;
+    pacing.timeouts_without_take = 0;
+    return false;
+  }
+  const uint64_t busy_high = render.busy_high.load(std::memory_order_acquire);
+  if (!busy_high) {
+    return false;
+  }
+  if (busy_high > frequency * kMaxPacedRenderMs / 1000) {
+    pacing.too_slow = true;
+  } else if (busy_high <= frequency * kResumePacedRenderMs / 1000) {
+    pacing.too_slow = false;
+  }
+  if (!PublishedFramePending(ctx)) {
+    return false;
+  }
+  Stats& s = stats();
+  if (pacing.too_slow) {
+    if (LogStatsOn()) {
+      s.pace_too_slow.fetch_add(1, std::memory_order_relaxed);
+    }
+    return false;
+  }
+  if (pacing.bypass) {
+    if (render.takes.load(std::memory_order_acquire) ==
+        pacing.takes_at_bypass) {
+      if (LogStatsOn()) {
+        s.pace_bypassed.fetch_add(1, std::memory_order_relaxed);
+      }
+      return false;
+    }
+    pacing.bypass = false;
+    pacing.timeouts_without_take = 0;
+  }
+  const uint64_t timeout = std::clamp<uint64_t>(
+      2 * busy_high + frequency * kTakeTimeoutExtraMs / 1000,
+      frequency * kTakeTimeoutMinMs / 1000,
+      frequency * kTakeTimeoutMaxMs / 1000);
+  const uint64_t start = Clock::QueryHostTickCount();
+  for (;;) {
+    // Reset, then test, so a take between the two still ends the wait.
+    if (take_event) {
+      take_event->Reset();
+    }
+    if (!RenderThreadDraws(ctx)) {
+      // The main thread draws now (mode 0); nothing more to wait for.
+      return false;
+    }
+    if (!PublishedFramePending(ctx)) {
+      break;
+    }
+    const uint64_t now = Clock::QueryHostTickCount();
+    if (now - start >= timeout) {
+      const uint32_t takes = render.takes.load(std::memory_order_acquire);
+      pacing.timeouts_without_take = takes == pacing.takes_at_timeout
+                                         ? pacing.timeouts_without_take + 1
+                                         : 1;
+      pacing.takes_at_timeout = takes;
+      if (pacing.timeouts_without_take >= kTimeoutsBeforeBypass) {
+        // The render thread has stopped taking frames: don't pace until it
+        // takes one again.
+        pacing.bypass = true;
+        pacing.takes_at_bypass = takes;
+      }
+      if (LogStatsOn()) {
+        s.pace_timeouts.fetch_add(1, std::memory_order_relaxed);
+      }
+      return false;
+    }
+    const uint64_t left_ms =
+        ((start + timeout - now) * 1000 + frequency - 1) / frequency;
+    WaitForEvent(take_event, std::clamp<uint64_t>(left_ms, 1, 2));
+  }
+  pacing.timeouts_without_take = 0;
+  if (LogStatsOn()) {
+    s.pace_waits.fetch_add(1, std::memory_order_relaxed);
+    s.pace_wait_us.fetch_add(
+        TicksToUs(Clock::QueryHostTickCount() - start, frequency),
+        std::memory_order_relaxed);
+  }
+  return true;
+}
