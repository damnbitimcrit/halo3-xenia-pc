+// Any thread, lock-free: whether a post hasn't been taken, or its copy not
+// recorded, yet. posted[] first: a post exchanged out by the command
+// processor thread was preceded by its store to taking.
+inline bool GuestSnapshotPostsUntaken() {
+  GuestSnapshots& snapshots = guest_snapshots();
+  for (const std::atomic<GuestSnapshotPost*>& post : snapshots.posted) {
+    if (post.load()) {
+      return true;
+    }
+  }
+  return snapshots.taking.load() != 0;
+}
+
+// Guest threads. Returns true once the command processor thread has recorded
+// the copy of every post (before anything it executes next) or failed it,
+// waking it. A post still not taken after timeout is withdrawn (its slot
+// fails) and this returns false; one taken but still being recorded then is
+// either recorded before anything the thread executes next or failed if what
+// it covers was replaced first, never copied from replaced data. Call it
+// before replacing what posted ranges cover in a way the GPU copy of guest
+// memory follows (a game state load: a protect, then file reads and uploads),
+// so no copy sees the replaced data.
+inline bool FlushGuestSnapshotPosts(std::chrono::milliseconds timeout) {
+  if (!GuestSnapshotPostsUntaken()) {
+    return true;
+  }
+  if (guest_readback_service_thread) {
+    return false;
+  }
+  GuestSnapshots& snapshots = guest_snapshots();
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  std::unique_lock<std::mutex> lock(snapshots.mutex);
+  for (;;) {
+    if (!GuestSnapshotPostsUntaken()) {
+      return true;
+    }
+    if (std::chrono::steady_clock::now() >= deadline) {
+      bool withdrawn = false;
+      for (uint32_t i = 0; i < GuestSnapshots::kMaxSlots; ++i) {
+        // Exactly one side gets the post: if the command processor thread
+        // took it meanwhile, it records the copy (or fails it) at once.
+        std::unique_ptr<GuestSnapshotPost> post(
+            snapshots.posted[i].exchange(nullptr));
+        if (post) {
+          snapshots.slots[i].state = GuestSnapshots::State::kFailed;
+          withdrawn = true;
+        }
+      }
+      snapshots.changed.notify_all();
+      return !withdrawn;
+    }
+    if (snapshots.service.wake) {
+      snapshots.service.wake(snapshots.service.context);
+    }
+    // Recording is notified without the mutex (that thread never waits for
+    // it), so a notification can fall between the check above and this wait:
+    // recheck every millisecond.
+    snapshots.changed.wait_until(
+        lock, std::min(deadline, std::chrono::steady_clock::now() +
+                                     std::chrono::milliseconds(1)));
+  }
+}
+
+// Guest threads. Forgets the slot's snapshot.
+inline void DropGuestSnapshot(uint32_t slot_index) {
+  if (slot_index >= GuestSnapshots::kMaxSlots) {
+    return;
+  }
+  std::unique_ptr<GuestSnapshotPost> dropped_post;
+  std::shared_ptr<const GuestSnapshotData> dropped_data;
+  GuestSnapshots& snapshots = guest_snapshots();
+  std::lock_guard<std::mutex> lock(snapshots.mutex);
+  dropped_post.reset(snapshots.posted[slot_index].exchange(nullptr));
+  GuestSnapshots::Slot& slot = snapshots.slots[slot_index];
+  slot.sequence = snapshots.next_sequence++;
+  slot.state = GuestSnapshots::State::kEmpty;
+  dropped_data = std::move(slot.data);
+  snapshots.changed.notify_all();
+}
+
+inline void DropGuestSnapshots() {
+  for (uint32_t i = 0; i < GuestSnapshots::kMaxSlots; ++i) {
+    DropGuestSnapshot(i);
+  }
+}
+
+// Command processor thread, after SetupContext.
+inline void StartGuestSnapshotService(const GuestSnapshots::Service& service) {
+  GuestSnapshots& snapshots = guest_snapshots();
+  std::lock_guard<std::mutex> lock(snapshots.mutex);
+  snapshots.service = service;
+}
+
+// Command processor thread, leaving its loop, before ShutdownContext: nothing
+// calls the callbacks afterwards, posts fail at once, and every snapshot not
+// delivered yet has failed. Guest threads hold the mutex only briefly (a
+// title's termination runs them out of host code first).
+inline void StopGuestSnapshotService() {
+  GuestSnapshots& snapshots = guest_snapshots();
+  std::lock_guard<std::mutex> lock(snapshots.mutex);
+  snapshots.service = GuestSnapshots::Service();
+  for (uint32_t i = 0; i < GuestSnapshots::kMaxSlots; ++i) {
+    delete snapshots.posted[i].exchange(nullptr);
+    GuestSnapshots::Slot& slot = snapshots.slots[i];
+    if (slot.state == GuestSnapshots::State::kPending) {
+      slot.state = GuestSnapshots::State::kFailed;
+    }
+  }
+  snapshots.taking.store(0);
+  snapshots.attention.store(0);
+  snapshots.changed.notify_all();
+}
