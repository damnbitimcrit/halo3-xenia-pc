+
+bool VulkanCommandProcessor::ReadGuestSnapshotCopy(GuestSnapshotJob& job) {
+  if (job.buffer == UINT32_MAX) {
+    job.failed = true;
+    return true;
+  }
+  if (GetCompletedSubmission() < job.submission) {
+    return false;
+  }
+  GuestSnapshotBuffer& buffer = guest_snapshot_buffers_[job.buffer];
+  if (!buffer.coherent) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+    VkMappedMemoryRange mapped_range;
+    mapped_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    mapped_range.pNext = nullptr;
+    mapped_range.memory = buffer.memory;
+    mapped_range.offset = 0;
+    mapped_range.size = VK_WHOLE_SIZE;
+    vulkan_device->functions().vkInvalidateMappedMemoryRanges(
+        vulkan_device->device(), 1, &mapped_range);
+  }
+  job.data->bytes.assign(buffer.mapping, buffer.mapping + job.length);
+  buffer.owned = false;
+  job.buffer = UINT32_MAX;
+  return true;
+}
+
+void VulkanCommandProcessor::ReleaseGuestSnapshotBuffer(GuestSnapshotJob& job) {
+  if (job.buffer == UINT32_MAX) {
+    return;
+  }
+  // last_submission keeps it from being reused until the copy is done.
+  guest_snapshot_buffers_[job.buffer].owned = false;
+  job.buffer = UINT32_MAX;
+}
