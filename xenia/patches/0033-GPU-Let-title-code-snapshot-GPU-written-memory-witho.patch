+    kPending,
+    // data holds the snapshot (no parts if nothing was newer).
+    kReady,
+    // Couldn't be made (too large, no GPU backend, replaced since the post,
+    // no readback buffer, host GPU error, withdrawn, shutdown).
+    kFailed,
+  };
