+void CommandProcessor::WakeForGuestReadback(void* context) {
+  // Ends the idle loop's 2 ms wait now (an extra set only ends a later wait
+  // early). The event lives as long as this object, and the service is
+  // stopped before it's destroyed.
+  static_cast<CommandProcessor*>(context)->write_ptr_index_event_->Set();
+}
+
+void CommandProcessor::CollectGpuNewerParts(
+    void* context, const uint32_t* starts, const uint32_t* lengths,
+    uint32_t count, std::vector<std::pair<uint32_t, uint32_t>>& parts) {
+  const SharedMemory* shared_memory =
+      static_cast<CommandProcessor*>(context)->GetGuestReadbackSharedMemory();
+  // Page flags and kept ranges change only under this lock.
+  auto global_lock = global_critical_region::Acquire();
+  for (uint32_t i = 0; i < count; ++i) {
+    shared_memory->ForEachGpuNewerPart(
+        starts[i], lengths[i], [&parts](uint32_t start, uint32_t length) {
+          parts.emplace_back(start, length);
+        });
+  }
+}
+
+void CommandProcessor::FailGuestSnapshotJob(GuestSnapshotJob& job,
+                                            const char* reason) {
+  ReleaseGuestSnapshotBuffer(job);
+  job.completed = true;
+  job.failed = true;
+  XELOGW("GPU: guest snapshot {} not copied: {}", job.slot, reason);
+}
+
+bool CommandProcessor::DeliverGuestSnapshot(GuestSnapshotJob& job) {
+  GuestSnapshots& snapshots = guest_snapshots();
+  // Never wait for a guest thread: retried later.
+  std::unique_lock<std::mutex> lock(snapshots.mutex, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    return false;
+  }
+  GuestSnapshots::Slot& slot = snapshots.slots[job.slot];
+  // Otherwise posted again or dropped since: discarded.
+  if (slot.sequence == job.sequence &&
+      slot.state == GuestSnapshots::State::kPending) {
+    if (job.failed) {
+      slot.state = GuestSnapshots::State::kFailed;
+    } else {
+      job.data->ready_time = std::chrono::steady_clock::now();
+      slot.data = std::move(job.data);
+      slot.state = GuestSnapshots::State::kReady;
+    }
+    snapshots.changed.notify_all();
+  }
+  return true;
+}
+
+void CommandProcessor::PumpGuestSnapshots() {
+  for (size_t i = 0; i < guest_snapshot_jobs_.size();) {
+    GuestSnapshotJob& job = guest_snapshot_jobs_[i];
+    if (!job.completed && ReadGuestSnapshotCopy(job)) {
+      job.completed = true;
+    }
+    if (job.completed && DeliverGuestSnapshot(job)) {
+      guest_snapshot_jobs_.erase(guest_snapshot_jobs_.begin() + i);
+    } else {
+      ++i;
+    }
+  }
+}
+
+void CommandProcessor::ServiceGuestSnapshots() {
+  GuestSnapshots& snapshots = guest_snapshots();
+  const uint32_t attention = snapshots.attention.load(std::memory_order_acquire)
+                                 ? snapshots.attention.exchange(0)
+                                 : 0;
+  if (!attention && !guest_snapshot_redeliver_) {
+    return;
+  }
+  const uint32_t posts =
+      attention & ((UINT32_C(1) << GuestSnapshots::kMaxSlots) - 1);
+  if (posts) {
+    // Until the copies are recorded, a flush before a load keeps waiting.
+    snapshots.taking.store(1);
+    bool recorded = false;
+    for (uint32_t i = 0; i < GuestSnapshots::kMaxSlots; ++i) {
+      if (!(posts & (UINT32_C(1) << i))) {
+        continue;
+      }
+      std::unique_ptr<GuestSnapshotPost> post(
+          snapshots.posted[i].exchange(nullptr));
+      if (!post) {
+        continue;
+      }
+      GuestSnapshotJob job;
+      job.slot = post->slot;
+      job.sequence = post->sequence;
+      job.data = std::move(post->data);
+      // Copy what's newer now, one consistent state: still everything listed
+      // at the post (a load since would have dropped some, and the copy would
+      // see the loaded data), plus whatever the GPU wrote since. Only this
+      // thread uploads or marks GPU writes, and the copy is recorded next.
+      std::vector<std::pair<uint32_t, uint32_t>>& current =
+          guest_snapshot_current_parts_;
+      current.clear();
+      CollectGpuNewerParts(this, job.data->range_starts,
+                           job.data->range_lengths, job.data->range_count,
+                           current);
+      // Recording may pump guest_snapshot_jobs_ (BeginSubmission ->
+      // CheckSubmissionCompletion): push only afterwards.
+      const bool covered = GuestSnapshotPartsCovered(job.data->parts, current);
+      uint64_t length = 0;
+      for (const std::pair<uint32_t, uint32_t>& part : current) {
+        length += part.second;
+      }
+      if (!covered) {
+        FailGuestSnapshotJob(job,
+                             "its memory was replaced since it was posted");
+      } else if (length > GuestSnapshots::kMaxBytes) {
+        FailGuestSnapshotJob(job, "over the size limit when taken");
+      } else {
+        job.data->parts = current;
+        job.length = uint32_t(length);
+        if (RecordGuestSnapshotCopy(job)) {
+          recorded = true;
+        } else {
+          FailGuestSnapshotJob(
+              job,
+              "couldn't record the copy (no readback buffer or no "
+              "submission)");
+        }
+      }
+      guest_snapshot_jobs_.push_back(std::move(job));
+    }
+    if (recorded) {
+      SubmitGuestSnapshotCopies();
+    }
+    snapshots.taking.store(0);
+    // Flushers; without the mutex.
+    snapshots.changed.notify_all();
+  }
+  const uint32_t awaited =
+      (attention >> GuestSnapshots::kAwaitedShift) | guest_snapshot_redeliver_;
+  if (!awaited) {
+    return;
+  }
+  GpuProfileZone profile_zone(GpuProfileBucket::kSync);
+  // By value: awaiting may pump guest_snapshot_jobs_.
+  uint64_t await_submission = 0;
+  for (const GuestSnapshotJob& job : guest_snapshot_jobs_) {
+    if ((awaited & (UINT32_C(1) << job.slot)) && !job.completed) {
+      await_submission = std::max(await_submission, job.submission);
+    }
+  }
+  if (await_submission) {
+    AwaitGuestSnapshotSubmission(await_submission);
+  }
+  for (GuestSnapshotJob& job : guest_snapshot_jobs_) {
+    if (!(awaited & (UINT32_C(1) << job.slot)) || job.completed) {
+      continue;
+    }
+    if (ReadGuestSnapshotCopy(job)) {
+      job.completed = true;
+    } else {
+      FailGuestSnapshotJob(job,
+                           "the copy didn't complete (host GPU error, or the "
+                           "submission couldn't be ended)");
+    }
+  }
+  PumpGuestSnapshots();
+  // A delivery that missed the mutex: retried at the next service point.
+  guest_snapshot_redeliver_ = 0;
+  for (const GuestSnapshotJob& job : guest_snapshot_jobs_) {
+    if (awaited & (UINT32_C(1) << job.slot)) {
+      guest_snapshot_redeliver_ |= UINT32_C(1) << job.slot;
+    }
+  }
+}
