+// What the host GPU copy of guest memory held newer than guest memory in some
+// physical ranges. Immutable once ready.
+struct GuestSnapshotData {
+  static constexpr uint32_t kMaxRanges = GuestReadback::kMaxRanges;
+  // As posted.
+  uint32_t range_count = 0;
+  uint32_t range_starts[kMaxRanges] = {};
+  uint32_t range_lengths[kMaxRanges] = {};
+  // (physical start, length), ascending: listed at the post, then again when
+  // the command processor thread records the copy (a superset by then: only
+  // that thread adds GPU-written bytes). bytes holds them back to back once
+  // ready.
+  std::vector<std::pair<uint32_t, uint32_t>> parts;
