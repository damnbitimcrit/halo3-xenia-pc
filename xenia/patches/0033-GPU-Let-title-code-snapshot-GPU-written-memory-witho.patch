+// Sorts (start, length) parts and merges those that overlap or touch (from
+// overlapping ranges).
+inline void MergeGuestSnapshotParts(
+    std::vector<std::pair<uint32_t, uint32_t>>& parts) {
+  std::sort(parts.begin(), parts.end());
+  size_t merged = 0;
+  for (size_t i = 0; i < parts.size(); ++i) {
+    if (merged &&
+        uint64_t(parts[merged - 1].first) + parts[merged - 1].second >=
+            parts[i].first) {
+      const uint64_t end =
+          std::max(uint64_t(parts[merged - 1].first) + parts[merged - 1].second,
+                   uint64_t(parts[i].first) + parts[i].second);
+      parts[merged - 1].second = uint32_t(end - parts[merged - 1].first);
+    } else {
+      parts[merged++] = parts[i];
+    }
+  }
+  parts.resize(merged);
+}
+
+// Whether every byte of each part is inside one of the current runs, both
+// (start, length); current is merged here.
+inline bool GuestSnapshotPartsCovered(
+    const std::vector<std::pair<uint32_t, uint32_t>>& parts,
+    std::vector<std::pair<uint32_t, uint32_t>>& current) {
+  MergeGuestSnapshotParts(current);
+  for (const std::pair<uint32_t, uint32_t>& part : parts) {
+    auto it = std::upper_bound(
+        current.cbegin(), current.cend(), part.first,
+        [](uint32_t value, const std::pair<uint32_t, uint32_t>& run) {
+          return value < run.first;
+        });
+    if (it == current.cbegin()) {
+      return false;
+    }
+    --it;
+    if (uint64_t(it->first) + it->second < uint64_t(part.first) + part.second) {
+      return false;
+    }
+  }
+  return true;
