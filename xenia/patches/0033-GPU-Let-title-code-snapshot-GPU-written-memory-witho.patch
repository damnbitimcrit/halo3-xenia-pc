+void VulkanCommandProcessor::SubmitGuestSnapshotCopies() {
+  // Vulkan submissions otherwise end only at swaps (or awaits): to the GPU
+  // now. Ending one never waits for pipeline creation here (draws hold the
+  // pipeline or a placeholder).
