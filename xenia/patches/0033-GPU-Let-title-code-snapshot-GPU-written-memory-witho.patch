+uint32_t VulkanCommandProcessor::RequestGuestSnapshotBuffer() {
+  const auto find_free = [this]() -> uint32_t {
+    const uint64_t completed_submission = GetCompletedSubmission();
+    for (uint32_t i = 0; i < uint32_t(guest_snapshot_buffers_.size()); ++i) {
+      const GuestSnapshotBuffer& buffer = guest_snapshot_buffers_[i];
+      if (!buffer.owned && buffer.last_submission <= completed_submission) {
+        return i;
+      }
+    }
+    return UINT32_MAX;
+  };
+  uint32_t index = find_free();
+  if (index != UINT32_MAX) {
+    return index;
+  }
+  if (guest_snapshot_buffers_.size() >= GuestSnapshots::kMaxSlots) {
+    // Refresh the completed submission, without waiting.
+    completion_timeline_.AwaitSubmissionAndUpdateCompleted(
+        GetCompletedSubmission());
+    // Read the completed copies (the job being recorded isn't listed yet).
+    PumpGuestSnapshots();
+    return find_free();
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  GuestSnapshotBuffer buffer;
+  uint32_t memory_type;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, GuestSnapshots::kMaxBytes,
+          VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, buffer.buffer,
+          buffer.memory, &memory_type)) {
+    XELOGE(
+        "VulkanCommandProcessor: Failed to create a guest snapshot "
+        "readback buffer");
+    return UINT32_MAX;
+  }
+  void* mapping;
+  if (dfn.vkMapMemory(device, buffer.memory, 0, VK_WHOLE_SIZE, 0, &mapping) !=
+      VK_SUCCESS) {
+    XELOGE(
+        "VulkanCommandProcessor: Failed to map a guest snapshot readback "
+        "buffer");
+    dfn.vkDestroyBuffer(device, buffer.buffer, nullptr);
+    dfn.vkFreeMemory(device, buffer.memory, nullptr);
+    return UINT32_MAX;
+  }
+  buffer.mapping = static_cast<const uint8_t*>(mapping);
+  buffer.coherent =
+      ((vulkan_device->memory_types().host_coherent >> memory_type) & 1) != 0;
+  guest_snapshot_buffers_.push_back(buffer);
+  return uint32_t(guest_snapshot_buffers_.size() - 1);
+}
+
+bool VulkanCommandProcessor::RecordGuestSnapshotCopy(GuestSnapshotJob& job) {
+  if (!BeginSubmission(false)) {
+    return false;
+  }
+  const uint32_t index = RequestGuestSnapshotBuffer();
+  if (index == UINT32_MAX) {
+    return false;
+  }
+  GuestSnapshotBuffer& buffer = guest_snapshot_buffers_[index];
+  // As ReadbackToGuestMemory: commit the shader writes and leave the render
+  // pass before the copy, then make the copy visible to the host.
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  SubmitBarriers(true);
+  const std::vector<std::pair<uint32_t, uint32_t>>& parts = job.data->parts;
+  VkBufferCopy* regions = deferred_command_buffer_.CmdCopyBufferEmplace(
+      shared_memory_->buffer(), buffer.buffer, uint32_t(parts.size()));
+  VkDeviceSize offset = 0;
+  for (size_t i = 0; i < parts.size(); ++i) {
+    regions[i].srcOffset = parts[i].first;
+    regions[i].dstOffset = offset;
+    regions[i].size = parts[i].second;
+    offset += parts[i].second;
+  }
+  PushBufferMemoryBarrier(
+      buffer.buffer, 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_ACCESS_HOST_READ_BIT);
+  SubmitBarriers(true);
+  job.submission = GetCurrentSubmission();
+  job.buffer = index;
+  buffer.owned = true;
+  buffer.last_submission = job.submission;
+  return true;
+}
