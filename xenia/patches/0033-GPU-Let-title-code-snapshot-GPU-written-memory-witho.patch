+  uint32_t slot = 0;
+  uint64_t sequence = 0;
+  std::shared_ptr<GuestSnapshotData> data;
+};
+
+struct GuestSnapshots {
+  static constexpr uint32_t kMaxSlots = 16;
+  static constexpr uint32_t kMaxRanges = GuestSnapshotData::kMaxRanges;
+  // Per snapshot, and the size of each readback buffer.
+  static constexpr uint32_t kMaxBytes = UINT32_C(1) << 20;
+  // attention: bit slot for a post, bit kAwaitedShift + slot for an awaiter.
+  static constexpr uint32_t kAwaitedShift = 16;
