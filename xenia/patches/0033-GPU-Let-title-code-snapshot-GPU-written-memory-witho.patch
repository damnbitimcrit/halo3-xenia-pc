+uint32_t D3D12CommandProcessor::RequestGuestSnapshotBuffer() {
+  const auto find_free = [this]() -> uint32_t {
+    const uint64_t completed_submission = GetCompletedSubmission();
+    for (uint32_t i = 0; i < uint32_t(guest_snapshot_buffers_.size()); ++i) {
+      const GuestSnapshotBuffer& buffer = guest_snapshot_buffers_[i];
+      if (!buffer.owned && buffer.last_submission <= completed_submission) {
+        return i;
+      }
+    }
+    return UINT32_MAX;
+  };
+  uint32_t index = find_free();
+  if (index != UINT32_MAX) {
+    return index;
+  }
+  if (guest_snapshot_buffers_.size() >= GuestSnapshots::kMaxSlots) {
+    // Refresh the completed submission, without waiting.
+    completion_timeline_->AwaitSubmissionAndUpdateCompleted(0);
+    // Read the completed copies (the job being recorded isn't listed yet).
+    PumpGuestSnapshots();
+    return find_free();
+  }
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  D3D12_RESOURCE_DESC buffer_desc;
+  ui::d3d12::util::FillBufferResourceDesc(
+      buffer_desc, GuestSnapshots::kMaxBytes, D3D12_RESOURCE_FLAG_NONE);
+  GuestSnapshotBuffer buffer;
+  if (FAILED(provider.GetDevice()->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesReadback,
+          provider.GetHeapFlagCreateNotZeroed(), &buffer_desc,
+          D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+          IID_PPV_ARGS(&buffer.resource)))) {
+    XELOGE("Failed to create a guest snapshot readback buffer");
+    return UINT32_MAX;
+  }
+  guest_snapshot_buffers_.push_back(buffer);
+  return uint32_t(guest_snapshot_buffers_.size() - 1);
+}
+
+bool D3D12CommandProcessor::RecordGuestSnapshotCopy(GuestSnapshotJob& job) {
+  if (!BeginSubmission(false)) {
+    return false;
+  }
+  const uint32_t index = RequestGuestSnapshotBuffer();
+  if (index == UINT32_MAX) {
+    return false;
+  }
+  GuestSnapshotBuffer& buffer = guest_snapshot_buffers_[index];
+  // Also commits the UAV writes of memory export draws.
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  ID3D12Resource* shared_memory_buffer = shared_memory_->GetBuffer();
+  uint64_t offset = 0;
+  for (const std::pair<uint32_t, uint32_t>& part : job.data->parts) {
+    deferred_command_list_.D3DCopyBufferRegion(
+        buffer.resource, offset, shared_memory_buffer, part.first, part.second);
+    offset += part.second;
+  }
+  job.submission = GetCurrentSubmission();
+  job.buffer = index;
+  buffer.owned = true;
+  buffer.last_submission = job.submission;
+  return true;
+}
+
+void D3D12CommandProcessor::SubmitGuestSnapshotCopies() {
+  // To the GPU now, unless ending the submission would wait for pipeline
+  // creation (then the next primary buffer end, an idle wake-up or an await
+  // ends it).
+  if (!submission_open_ || !CanEndSubmissionImmediately()) {
+    return;
+  }
+  bool copies_open = false;
+  for (const GuestSnapshotJob& job : guest_snapshot_jobs_) {
+    if (!job.completed && job.submission == GetCurrentSubmission()) {
+      copies_open = true;
+      break;
+    }
+  }
+  if (copies_open) {
+    EndSubmission(false);
+  }
+}
+
+bool D3D12CommandProcessor::AwaitGuestSnapshotSubmission(uint64_t submission) {
+  if (GetCompletedSubmission() >= submission) {
+    return true;
+  }
+  if (device_removed_) {
+    return false;
+  }
+  // Ends it if it's still open, drains the submission thread, waits.
+  CheckSubmissionCompletion(std::min(submission, GetCurrentSubmission()));
+  return GetCompletedSubmission() >= submission;
+}
+
+bool D3D12CommandProcessor::ReadGuestSnapshotCopy(GuestSnapshotJob& job) {
+  if (job.buffer == UINT32_MAX) {
+    job.failed = true;
+    return true;
+  }
+  if (GetCompletedSubmission() < job.submission) {
+    return false;
+  }
+  GuestSnapshotBuffer& buffer = guest_snapshot_buffers_[job.buffer];
+  D3D12_RANGE read_range;
+  read_range.Begin = 0;
+  read_range.End = SIZE_T(job.length);
+  void* mapping;
+  if (SUCCEEDED(buffer.resource->Map(0, &read_range, &mapping))) {
+    const uint8_t* bytes = static_cast<const uint8_t*>(mapping);
+    job.data->bytes.assign(bytes, bytes + job.length);
+    D3D12_RANGE written_range = {};
+    buffer.resource->Unmap(0, &written_range);
+  } else {
+    job.failed = true;
+  }
+  buffer.owned = false;
+  job.buffer = UINT32_MAX;
+  return true;
+}
+
+void D3D12CommandProcessor::ReleaseGuestSnapshotBuffer(GuestSnapshotJob& job) {
+  if (job.buffer == UINT32_MAX) {
+    return;
+  }
+  // last_submission keeps it from being reused until the copy is done.
+  guest_snapshot_buffers_[job.buffer].owned = false;
+  job.buffer = UINT32_MAX;
+}
