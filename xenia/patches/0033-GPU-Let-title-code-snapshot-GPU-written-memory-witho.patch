+enum class GuestSnapshotAwaitResult {
+  // data holds the snapshot (possibly with no parts).
+  kReady,
+  // Nothing posted in the slot (never, or dropped), or it was posted again or
+  // dropped by another thread meanwhile.
+  kEmpty,
+  // Its copy couldn't be made.
+  kFailed,
+  // Not ready within the timeout (emulator paused, a stalled command
+  // processor thread). The slot keeps it, and gets it later.
+  kTimedOut,
+};
+
+// Guest threads. Gets the slot's snapshot, waiting (at most timeout) only if
+// its bytes haven't arrived yet: the command processor thread then ends the
+// submission with the copy if needed and waits for the host GPU to complete
+// it, which needs no guest thread.
+inline GuestSnapshotAwaitResult AwaitGuestSnapshot(
+    uint32_t slot_index, std::chrono::milliseconds timeout,
+    std::shared_ptr<const GuestSnapshotData>& data) {
+  using State = GuestSnapshots::State;
+  data.reset();
+  if (slot_index >= GuestSnapshots::kMaxSlots ||
+      guest_readback_service_thread) {
+    return GuestSnapshotAwaitResult::kFailed;
+  }
+  GuestSnapshots& snapshots = guest_snapshots();
+  std::unique_lock<std::mutex> lock(snapshots.mutex);
+  GuestSnapshots::Slot& slot = snapshots.slots[slot_index];
+  const uint64_t sequence = slot.sequence;
+  const auto resolved = [&slot, sequence] {
+    return slot.sequence != sequence || slot.state != State::kPending;
+  };
+  if (!resolved()) {
+    snapshots.attention.fetch_or(
+        UINT32_C(1) << (GuestSnapshots::kAwaitedShift + slot_index));
+    if (snapshots.service.wake) {
+      snapshots.service.wake(snapshots.service.context);
+    }
+    if (!snapshots.changed.wait_for(lock, timeout, resolved)) {
+      return GuestSnapshotAwaitResult::kTimedOut;
+    }
+  }
+  if (slot.sequence != sequence) {
+    return GuestSnapshotAwaitResult::kEmpty;
+  }
+  switch (slot.state) {
+    case State::kReady:
+      data = slot.data;
+      return GuestSnapshotAwaitResult::kReady;
+    case State::kFailed:
+      return GuestSnapshotAwaitResult::kFailed;
+    default:
+      return GuestSnapshotAwaitResult::kEmpty;
+  }
+}
