+  // A guest snapshot (guest_readback.h) whose copy this thread has recorded.
+  struct GuestSnapshotJob {
+    uint32_t slot = 0;
+    uint64_t sequence = 0;
+    // Sum of the part lengths.
+    uint32_t length = 0;
+    std::shared_ptr<GuestSnapshotData> data;
+    // The submission with the copy, and the backend's readback buffer.
+    uint64_t submission = 0;
+    uint32_t buffer = UINT32_MAX;
+    bool completed = false;
+    bool failed = false;
+  };
+  // Takes posted guest snapshots and records their copies, then serves
+  // awaits. At the loop top, at idle wake-ups, in WAIT_REG_MEM's poll, and
+  // (for the ordering posts rely on) right before ExecutePrimaryBuffer. One
+  // load when nothing is posted or awaited.
+  void ServiceGuestSnapshots();
+  // Reads the copies that have completed and delivers them; never waits.
+  void PumpGuestSnapshots();
+  bool DeliverGuestSnapshot(GuestSnapshotJob& job);
+  void FailGuestSnapshotJob(GuestSnapshotJob& job, const char* reason);
+  static void WakeForGuestReadback(void* context);
+  static void CollectGpuNewerParts(
+      void* context, const uint32_t* starts, const uint32_t* lengths,
+      uint32_t count, std::vector<std::pair<uint32_t, uint32_t>>& parts);
+  // The backend's part: null and false where it can't copy.
+  virtual SharedMemory* GetGuestReadbackSharedMemory() { return nullptr; }
+  // Records the copy of job.data->parts (job.length bytes) into a readback
+  // buffer in the open submission, setting job.submission and job.buffer.
+  virtual bool RecordGuestSnapshotCopy(GuestSnapshotJob& job) { return false; }
+  // Ends the submission with recorded copies if that doesn't wait.
+  virtual void SubmitGuestSnapshotCopies() {}
+  // Ends the submission if needed and waits for it to complete on the GPU.
+  virtual bool AwaitGuestSnapshotSubmission(uint64_t submission) {
+    return false;
+  }
+  // If the copy has completed, reads it into job.data->bytes (or fails the
+  // job) and frees the buffer, returning true.
+  virtual bool ReadGuestSnapshotCopy(GuestSnapshotJob& job) { return false; }
+  virtual void ReleaseGuestSnapshotBuffer(GuestSnapshotJob& job) {}
+  // This thread only.
+  std::vector<GuestSnapshotJob> guest_snapshot_jobs_;
+  std::vector<std::pair<uint32_t, uint32_t>> guest_snapshot_current_parts_;
+  // Awaited slots whose delivery missed the mutex: retried at each service
+  // point (not through attention, so the idle loop still waits).
+  uint32_t guest_snapshot_redeliver_ = 0;
