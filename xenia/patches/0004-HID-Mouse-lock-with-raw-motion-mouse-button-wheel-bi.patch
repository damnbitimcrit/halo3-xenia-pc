+void KeyboardInputDriver::OnMouseButton(ui::MouseEvent::Button button,
+                                        bool is_down) {
+  if (static_cast<KeyboardMode>(cvars::keyboard_mode) !=
+      KeyboardMode::Enabled) {
+    return;
+  }
+  ui::VirtualKey key;
+  switch (button) {
+    case ui::MouseEvent::Button::kLeft:
+      key = ui::VirtualKey::kLButton;
+      break;
+    case ui::MouseEvent::Button::kRight:
+      key = ui::VirtualKey::kRButton;
+      break;
+    case ui::MouseEvent::Button::kMiddle:
+      key = ui::VirtualKey::kMButton;
+      break;
+    case ui::MouseEvent::Button::kX1:
+      key = ui::VirtualKey::kXButton1;
+      break;
+    case ui::MouseEvent::Button::kX2:
+      key = ui::VirtualKey::kXButton2;
+      break;
+    default:
+      return;
+  }
+  auto global_lock = global_critical_region_.Acquire();
+  SetBindingsForKey(key, is_down);
+}
+
+void KeyboardInputDriver::OnMouseWheel(int32_t scroll_y) {
+  if (static_cast<KeyboardMode>(cvars::keyboard_mode) !=
+          KeyboardMode::Enabled ||
+      !scroll_y) {
+    return;
+  }
+  auto global_lock = global_critical_region_.Acquire();
+  if (scroll_y > 0) {
+    wheel_up_polls_ = kWheelPressPolls;
+  } else {
+    wheel_down_polls_ = kWheelPressPolls;
+  }
+}
