+#ifndef XENIA_HID_KEYBOARD_ANALOG_KEYS_H_
+#define XENIA_HID_KEYBOARD_ANALOG_KEYS_H_
+
+#include <cstdint>
+
+namespace xe {
+namespace hid {
+namespace keyboard {
+
+// Analog key travel from keyboards with analog switches (Wooting, through the
+// Wooting Analog SDK that Wootility installs). Unavailable when the SDK or a
+// supported keyboard is missing.
+class AnalogKeys {
+ public:
+  // Loads the SDK on first use. Returns nullptr if it isn't usable.
+  static AnalogKeys* Get();
+
+  // How far a key is pressed, 0 (released) to 1 (bottomed out), by Windows
+  // virtual-key code; negative if the key has no analog reading.
+  virtual float Read(uint16_t virtual_key) = 0;
+
+ protected:
+  virtual ~AnalogKeys() = default;
+};
+
+}  // namespace keyboard
+}  // namespace hid
+}  // namespace xe
