+
+#include "xenia/hid/keyboard/analog_keys.h"
+
+#include <mutex>
+
+#include "xenia/base/logging.h"
+#include "xenia/base/platform_win.h"
+
+namespace xe {
+namespace hid {
+namespace keyboard {
+namespace {
+
+// C API of the Wooting Analog SDK (includes/wooting-analog-sdk.h).
+using InitialiseFn = int (*)();
+using SetKeycodeModeFn = int (*)(unsigned int mode);
+using ReadAnalogFn = float (*)(unsigned short code);
+constexpr unsigned int kKeycodeTypeVirtualKey = 2;
+// Virtual keys as the current keyboard layout maps them, like WM_KEYDOWN.
+constexpr unsigned int kKeycodeTypeVirtualKeyTranslate = 3;
+
+class WootingAnalogKeys final : public AnalogKeys {
+ public:
+  bool Load() {
+    // The bundled distributable if the user placed one next to Xenia, then
+    // the system SDK that Wootility installs (current and pre-0.9 locations).
+    static const wchar_t* const kCandidates[] = {
+        L"wooting_analog_sdk_dist.dll",
+        L"C:\\Program Files\\wooting-analog-sdk\\wooting_analog_sdk.dll",
+        L"C:\\Program Files\\WootingAnalogSDK\\wooting_analog_sdk.dll",
+        L"wooting_analog_sdk.dll",
+    };
+    for (const wchar_t* candidate : kCandidates) {
+      library_ = LoadLibraryW(candidate);
+      if (library_) {
+        break;
+      }
+    }
+    if (!library_) {
+      return false;
+    }
+    auto initialise = reinterpret_cast<InitialiseFn>(
+        GetProcAddress(library_, "wooting_analog_initialise"));
+    auto set_keycode_mode = reinterpret_cast<SetKeycodeModeFn>(
+        GetProcAddress(library_, "wooting_analog_set_keycode_mode"));
+    read_analog_ = reinterpret_cast<ReadAnalogFn>(
+        GetProcAddress(library_, "wooting_analog_read_analog"));
+    if (!initialise || !set_keycode_mode || !read_analog_) {
+      XELOGW("Wooting Analog SDK: missing exports, analog keys disabled");
+      return false;
+    }
+    const int devices = initialise();
+    if (devices < 0) {
+      XELOGW("Wooting Analog SDK: initialisation failed ({})", devices);
+      return false;
+    }
+    // WootingAnalogResult_Ok is 1.
+    if (set_keycode_mode(kKeycodeTypeVirtualKeyTranslate) != 1 &&
+        set_keycode_mode(kKeycodeTypeVirtualKey) != 1) {
+      XELOGW("Wooting Analog SDK: virtual-key mode unavailable");
+      return false;
+    }
+    XELOGI("Wooting Analog SDK loaded, {} device(s) found", devices);
+    return true;
+  }
+
+  float Read(uint16_t virtual_key) override {
+    const float value = read_analog_(virtual_key);
+    return value >= 0.0f ? value : -1.0f;
+  }
+
+  ~WootingAnalogKeys() override {
+    if (library_) {
+      FreeLibrary(library_);
+    }
+  }
+
+ private:
+  HMODULE library_ = nullptr;
+  ReadAnalogFn read_analog_ = nullptr;
+};
+
+}  // namespace
+
+AnalogKeys* AnalogKeys::Get() {
+  static WootingAnalogKeys* instance = nullptr;
+  static std::once_flag once;
+  std::call_once(once, [] {
+    auto keys = new WootingAnalogKeys();
+    if (keys->Load()) {
+      instance = keys;
+    } else {
+      delete keys;
+    }
+  });
+  return instance;
+}
+
+}  // namespace keyboard
+}  // namespace hid
+}  // namespace xe
