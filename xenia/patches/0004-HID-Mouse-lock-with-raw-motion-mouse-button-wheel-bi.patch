+
+#include "xenia/hid/mouse_input.h"
+
+#include <atomic>
+
+namespace xe {
+namespace hid {
+namespace {
+// Both axes packed into one word so a reader never sees half an update.
+std::atomic<uint64_t> pending_motion{0};
+
+uint64_t Pack(int32_t dx, int32_t dy) {
+  return (uint64_t(uint32_t(dx)) << 32) | uint32_t(dy);
+}
+}  // namespace
+
+void MouseInput::AddMotion(int32_t dx, int32_t dy) {
+  uint64_t current = pending_motion.load(std::memory_order_relaxed);
+  uint64_t next;
+  do {
+    next = Pack(int32_t(uint32_t(current >> 32)) + dx,
+                int32_t(uint32_t(current)) + dy);
+  } while (!pending_motion.compare_exchange_weak(current, next,
+                                                 std::memory_order_relaxed));
+}
+
+void MouseInput::TakeMotion(int32_t* dx, int32_t* dy) {
+  const uint64_t motion = pending_motion.exchange(0, std::memory_order_relaxed);
+  *dx = int32_t(uint32_t(motion >> 32));
+  *dy = int32_t(uint32_t(motion));
+}
+
+}  // namespace hid
+}  // namespace xe
