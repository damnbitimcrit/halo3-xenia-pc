+
+void Win32Window::UpdateMouseLockClip() {
+  // Pin the cursor to the center of the client area. The clip is lost when the
+  // window moves or another program changes it, so it is re-checked on every
+  // raw mouse message.
+  RECT client;
+  if (!GetClientRect(hwnd_, &client)) {
+    return;
+  }
+  POINT center = {(client.left + client.right) / 2,
+                  (client.top + client.bottom) / 2};
+  if (!ClientToScreen(hwnd_, &center)) {
+    return;
+  }
+  RECT desired = {center.x, center.y, center.x + 1, center.y + 1};
+  RECT current;
+  if (!GetClipCursor(&current) || !EqualRect(&current, &desired)) {
+    ClipCursor(&desired);
+  }
+}
