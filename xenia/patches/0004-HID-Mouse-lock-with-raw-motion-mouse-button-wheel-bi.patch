+bool KeyboardInputDriver::TakesPriority(uint32_t user_index) const {
+  // Playing with the mouse locked to the window means keyboard and mouse,
+  // even if a controller is connected too.
+  return static_cast<KeyboardMode>(cvars::keyboard_mode) ==
