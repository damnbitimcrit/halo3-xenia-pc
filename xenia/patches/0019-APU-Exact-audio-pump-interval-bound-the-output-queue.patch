   uint32_t held_first_ = 0;
-  uint32_t held_count_ = 0;
+  std::atomic<uint32_t> held_count_{0};
   // The frames_ index of the last frame submitted, for the fade out.
   uint32_t last_frame_ = UINT32_MAX;
   // Frames submitted and not finished playing (fade outs not counted).
diff --git a/src/xenia/kernel/title/halo3/halo3.cc b/src/xenia/kernel/title/halo3/halo3.cc
index 8f5dd43..ddeac0c 100644
--- a/src/xenia/kernel/title/halo3/halo3.cc
+++ b/src/xenia/kernel/title/halo3/halo3.cc
@@ -169,14 +169,15 @@ void LogStats() {
   apu::AudioStats& a = apu::audio_stats();
   const uint32_t min_queued = a.min_queued_frames.exchange(UINT32_MAX);
   XELOGI(
-      "Halo 3 audio: {} frames requested and {} more to catch up, {} late, {} "
-      "slow (slowest {:.1f} ms); output ran dry {} times with a fade ({} "
-      "without), resumed {} times; fewest frames queued {}",
+      "Halo 3 audio: {} frames requested, {} more to catch up and {} skipped "
+      "as the queue was deep, {} late, {} slow (slowest {:.1f} ms); output "
+      "ran dry {} times with a fade ({} without), resumed {} times; fewest "
+      "frames queued {}",
       a.pumps.exchange(0), a.catchup_pumps.exchange(0),
-      a.late_pumps.exchange(0), a.slow_pumps.exchange(0),
-      a.slowest_pump_us.exchange(0) / 1000.0, a.underruns.exchange(0),
-      a.hard_underruns.exchange(0), a.resumes.exchange(0),
-      min_queued == UINT32_MAX ? 0 : min_queued);
+      a.skipped_pumps.exchange(0), a.late_pumps.exchange(0),
+      a.slow_pumps.exchange(0), a.slowest_pump_us.exchange(0) / 1000.0,
+      a.underruns.exchange(0), a.hard_underruns.exchange(0),
+      a.resumes.exchange(0), min_queued == UINT32_MAX ? 0 : min_queued);
   // The GPU command processor thread, in percent of the interval. Executing
   // includes the swaps, which include the presents, and the waits for the
   // host GPU and for guest memory (WAIT_REG_MEM).
